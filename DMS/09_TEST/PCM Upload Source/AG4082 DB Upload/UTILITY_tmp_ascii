10206 !***** DON'T REMOVE THIS LINE *************************************
10207 !
10208 !  Type : Algorithm
10209 !  Name : APPLY_FWKCONF
10210 !  Vers : 1
10211 !  Desc : Read configuration parameter and apply them.
10212 !       :   SPECS2.5: Added special parameters.
10213 !  Date : 09/01/2000
10214 !  Time : 09:00:00
10215 !  User : specs
10216 !
10217 !***** DON'T REMOVE THIS LINE *************************************
10218 !
10219 !  Input Variables:
10220 !
10221 !     #  Name            Type Size     Description
10222 !    --- --------------- ---- -------- --------------------------------
10223 !    Measurement Parameters:
10224 !      1 File            S    -
10225 !      2 Type            I    -        0:All vars, 1:Normal vars only,
10226 !
10227 !  Output Variables:
10228 !
10229 !     #  Name            Type Size     Description
10230 !    --- --------------- ---- -------- --------------------------------
10231 !    Output Parameters:
10232 !      1 Errno           I    -
10233 !      2 Errmsg          S    -
10234 !
10235 !***** DON'T REMOVE THIS LINE *************************************
10236         OPTION BASE 1  !***** DON'T REMOVE THIS LINE *****
10237         DIM Line$[256],Symbol$[256],Value$[256],Token$[256],Name$[32],Src$[256]
10238         INTEGER P_col,P_exc,P_comma  !":", "!" and ","
10239         INTEGER Idx_tag,Idx_dim1,Typ,Dim,Size1,Size2,Length
10240         Errno=0
10241         Errmsg$=""
10242         ON ERROR GOTO Err
10243         ASSIGN @Fwkconf TO File$;FORMAT ON
10244         ON END @Fwkconf GOTO Endoffile
10245         LOOP
10246            Symbol$=""
10247            Value$=""
10248 !
10249            ENTER @Fwkconf;Line$
10250            Line$=TRIM$(Line$)
10251            P_exc=POS(Line$,"!")
10252            SELECT P_exc
10253            CASE 0
10254            CASE 1
10255               Line$=""
10256            CASE ELSE
10257               Line$=Line$[1,P_exc-1]
10258            END SELECT
10259 !
10260            P_col=POS(Line$,":")
10261            IF P_col>=2 THEN 
10262               Symbol$=Line$[1,P_col-1]
10263               Symbol$=TRIM$(Symbol$)
10264               IF Symbol$<>"" AND LEN(Line$)>P_col THEN 
10265                  Value$=Line$[P_col+1,LEN(Line$)]
10266                  Value$=TRIM$(Value$)
10267               END IF
10268            END IF
10269 !
10270            IF Symbol$<>"" AND Value$<>"" THEN 
10271               IF Symbol$[1,1]="*" THEN 
10272                  IF Type=1 THEN Loop_next
10273                  Src$=Symbol$[2,LEN(Symbol$)]
10274               ELSE
10275                  IF Type=2 THEN Loop_next
10276                  Src$=Symbol$
10277               END IF
10278 !
10279               Tpltagindex("SYSTEM",Src$,Idx_tag)
10280               IF Idx_tag=-1 THEN 
10281                  Errno=1
10282                  Errmsg$=Src$&" is not defined as TAG variable"
10283                  GOTO Endoffile
10284               END IF
10285               Tpltaginfo("SYSTEM",Idx_tag,Name$,Typ,Dim,Size1,Size2)
10286               SELECT Dim
10287               CASE 0
10288                  SELECT Typ
10289                  CASE 0
10290                     Tplputrtag("SYSTEM",Idx_tag,0,VAL(Value$))
10291                  CASE 1
10292                     Tplputitag("SYSTEM",Idx_tag,0,INT(VAL(Value$)))
10293                  CASE 2
10294                     IF LEN(Value$)>0 THEN 
10295                        Tplputctag("SYSTEM",Idx_tag,0,Value$[1,1])
10296                     END IF
10297                  CASE 3
10298                     Tplputstag("SYSTEM",Idx_tag,0,Value$)
10299                  END SELECT
10300               CASE 1
10301                  SELECT Typ
10302                  CASE 0
10303                     ALLOCATE REAL Ra(Size1)
10304                  CASE 1
10305                     ALLOCATE INTEGER Ia(Size1)
10306                  CASE 2
10307                     ALLOCATE Ca$(Size1)[1]
10308                  CASE 3
10309                     ALLOCATE Sa$(Size1)[255]
10310                  END SELECT
10311 !
10312                  Idx_dim1=1
10313                  LOOP
10314                     P_comma=POS(Value$,",")
10315                     SELECT P_comma
10316                     CASE 0
10317                        Token$=Value$
10318                     CASE 1
10319                        Token$=""
10320                     CASE ELSE
10321                        Token$=Value$[1,P_comma-1]
10322                     END SELECT
10323                     Token$=TRIM$(Token$)
10324 !
10325                     SELECT Typ
10326                     CASE 0
10327                        Ra(Idx_dim1)=VAL(Token$)
10328                     CASE 1
10329                        Ia(Idx_dim1)=INT(VAL(Token$))
10330                     CASE 2
10331                        IF LEN(Token$)>0 THEN 
10332                           Ca$(Idx_dim1)=Token$[1,1]
10333                        ELSE
10334                           Ca$(Idx_dim1)=" "
10335                        END IF
10336                     CASE 3
10337                        Sa$(Idx_dim1)=Token$
10338                     END SELECT
10339 !
10340                     Length=LEN(Value$)
10341                  EXIT IF P_comma=0 OR Length=P_comma
10342 !
10343                     Value$=Value$[P_comma+1,Length]
10344                     Idx_dim1=Idx_dim1+1
10345                  END LOOP
10346 !
10347                  SELECT Typ
10348                  CASE 0
10349                     Tplputratag("SYSTEM",Idx_tag,0,Ra(*))
10350                     DEALLOCATE Ra(*)
10351                  CASE 1
10352                     Tplputiatag("SYSTEM",Idx_tag,0,Ia(*))
10353                     DEALLOCATE Ia(*)
10354                  CASE 2
10355                     Tplputcatag("SYSTEM",Idx_tag,0,Ca$(*))
10356                     DEALLOCATE Ca$(*)
10357                  CASE 3
10358                     Tplputsatag("SYSTEM",Idx_tag,0,Sa$(*))
10359                     DEALLOCATE Sa$(*)
10360                  END SELECT
10361               END SELECT
10362            END IF
10363 Loop_next:!
10364         END LOOP
10365 Endoffile:                                 !
10366         ASSIGN @Fwkconf TO *
10367         SUBEXIT
10368 Err:                                 !
10369         ASSIGN @Fwkconf TO *
10370         Errno=ERRN
10371         Errmsg$=ERRM$
10372      SUBEND
