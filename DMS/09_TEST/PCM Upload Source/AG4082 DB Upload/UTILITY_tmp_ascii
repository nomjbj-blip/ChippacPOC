25750 SUB Iccap_mdminit(Head$(*),INTEGER Size(*),REAL Data(*),INTEGER Loop(*),OPTIONAL INTEGER Xiv,Xivn,Xov,Xnv,Xnv1,Xnvn)
25751!***********************************************************************
25752!
25753!  Type : Subprogram
25754!  Name : ICCAP_MDMINIT
25755!  Vers : 1
25756!  Desc : Initialize Loop(*) array structure based on information
25757!         kept in Size(*).  Loop(*) array must be allocated by caller
25758!         prior to call this subprogram.  The array size is
25759!         automatically adjusted after calculating # of input
25760!         variables.  Loop(1:SIZE(Size,1)) is large enough.  It also
25761!         returns various size-related information for given data.
25762!  Date : 06/01/1998
25763!  Time : 09:00:00
25764!  User : specs
25765!
25766!***********************************************************************
25767!
25768!  #  Dir   Name            Type Size     Description
25769! --- ----- --------------- ---- -------- ------------------------------
25770!   1 IN    Head            S    *        *.mdm file header information
25771!   2 IN    Size            I    *,3      Size information
25772!   3 IN    Data            R    *,*      Measurement data
25773!   4 IN    Loop            I    *,4      Loop array
25774!   5 OUT   Iv              I    -        # of input variables (all)
25775!   6 OUT   Ivn             I    -        # of sweep variables (sweep: N,N-1,..,1)
25776!   7 OUT   Ov              I    -        # of output variables (all)
25777!   8 OUT   Nv              I    -        # of total data points (all)
25778!   9 OUT   Nv1             I    -        # of data points (sweep: 1)
25779!  10 OUT   Nvn             I    -        # of data points (sweep: N,N-1,...,2)
25780!
25781!***********************************************************************
25782!
25783   INTEGER V,Iv,Ivn,Ov,Nv,Nv1,Nvn
25784   Nv=SIZE(Data,2)                      ! # of total data points (all)
25785   Iv=0                                 ! # of input variables (all)
25786   Ivn=0                                ! # of sweep variables (sweep: N,N-1,...,1, no SYNC)
25787   Ov=0                                 ! # of output variables (all)
25788   FOR V=1 TO SIZE(Size,1)
25789     SELECT Size(V,1)
25790     CASE 1                             ! input
25791       Iv=Iv+1
25792       IF Size(V,2)>0 THEN Ivn=Ivn+1
25793     CASE 2                             ! output
25794       Ov=Ov+1
25795     END SELECT
25796   NEXT V
25797!
25798   Nv1=1                                ! count total # of data (sweep order = 1)
25799   Nvn=1                                ! count total # of data (sweep order > 1)
25800   FOR V=1 TO Iv
25801     N=Size(V,3)                        ! size of each sweep
25802     IF Size(V,2)=1 THEN                ! count # of data (sweep order = 1)
25803       Nv1=N
25804     END IF
25805     IF Size(V,2)>1 THEN                ! count # of data (sweep order > 1)
25806       Nvn=Nvn*N
25807     END IF
25808   NEXT V
25809!
25810   FOR V=1 TO SIZE(Size,1)              ! update size = 0
25811     IF Size(V,3)=0 THEN 
25812       Size(V,3)=Nv1
25813     END IF
25814   NEXT V
25815!
25816   REDIM Loop(1:Iv,1:5)                 ! change size
25817   FOR V=1 TO Iv                        ! for each loop variables
25818     Loop(V,1)=V                        ! initialize variable index (reverse index)
25819     MAT Loop(V,2:3)= Size(V,2:3)       ! copy Order/Size from Size(*)
25820     Loop(V,4)=1                        ! initialize counter
25821     Loop(V,5)=1                        ! initialize sum
25822   NEXT V
25823   MAT SORT Loop(*,2) DES               ! sort Loop(*) by sweep order
25824!
25825   FOR V=Iv-1 TO 1 STEP -1              ! set sum
25826     IF Loop(V,2)>1 THEN 
25827       Loop(V,5)=Loop(V+1,3)*Loop(V+1,5)
25828     END IF
25829   NEXT V
25830!
25831   IF NPAR>=5 THEN Xiv=Iv
25832   IF NPAR>=6 THEN Xivn=Ivn
25833   IF NPAR>=7 THEN Xov=Ov
25834   IF NPAR>=8 THEN Xnv=Nv
25835   IF NPAR>=9 THEN Xnv1=Nv1
25836   IF NPAR>=10 THEN Xnvn=Nvn
25837 SUBEND
25838 SUB Iccap_mdmloop(Head$(*),INTEGER Size(*),REAL Data(*),INTEGER Loop(*),Pos)
25839!***********************************************************************
25840!
25841!  Type : Subprogram
25842!  Name : ICCAP_MDMLOOP
25843!  Vers : 1
25844!  Desc : Increment counters which are kept in Loop(*) array struct.
25845!         Associated counters for variables with sweep order from 2 to N
25846!         are incremented.  No counter overflow is taken care of. So
25847!         caller of this subprogram must call this subprogram for
25848!         expected number of times, no more and no less (Vn*Vn-1*Vn-2*..
25849!         V2).  This subprogram also returns offset value that
25850!         indicates where data points are stored in Data(*) array.
25851!  Date : 06/01/1998
25852!  Time : 09:00:00
25853!  User : specs
25854!
25855!***********************************************************************
25856!
25857!  #  Dir   Name            Type Size     Description
25858! --- ----- --------------- ---- -------- ------------------------------
25859!   1 IN    Head            S    *        *.mdm file header information
25860!   2 IN    Size            I    *,3      Size information
25861!   3 IN    Data            R    *,*      Measurement data
25862!   4 IN    Loop            I    *,5      Loop array (altered)
25863!   5 OUT   Pos             I    -        Position of Data(*) (calculated from Loop(*))
25864!
25865!***********************************************************************
25866!
25867   INTEGER V
25868   FOR V=SIZE(Loop,1) TO 1 STEP -1              ! for all sweep variables: 2,3,...,N
25869     IF Loop(V,2)>=2 THEN                       ! sweep order 2 or up
25870       IF Loop(V,4)>=Loop(V,3) THEN             ! looped through all data points ?
25871         Loop(V,4)=1                            ! reset counter and increment higher sweep
25872       ELSE
25873         Loop(V,4)=Loop(V,4)+1                  ! increment counter
25874         GOTO P                                 ! done
25875       END IF
25876     END IF
25877   NEXT V
25878!
25879 P:Pos=1
25880   V=1
25881   WHILE Loop(V,2)>1                            ! for sweep: N,N-1,...,2
25882     Pos=Pos+((Loop(V,4)-1)*Loop(V,5))          ! sum up offset
25883     V=V+1
25884   END WHILE
25885 SUBEND
