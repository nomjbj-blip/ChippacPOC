13117 !      3 Depth           I    -        Max directory depth + 1
13118 !
13119 !***** DON'T REMOVE THIS LINE *************************************
13120         OPTION BASE 1  !***** DON'T REMOVE THIS LINE *****
13121         DIM Script$[255],Buf$[255]
13122         INTEGER N
13123         Script$="/var/tmp/dirlook."&SYSTEM$("PROCESS ID")  ! AVPATH_
