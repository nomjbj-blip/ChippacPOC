23830 DEF FNDelta_l(REAL Vds,Vgs,Lch1,Lch2,OPTIONAL Lch3,Lch4,Lch5,Lch6)
23831   OPTION BASE 1
23832   COM /þmultitr/ INTEGER Port_(1:11),Psource,Pgate,Psubs_,Pdrain(1:6)
23833   INTEGER N,I,St
23834   REAL L(6)
23835   N=NPAR-4                                 ! THE NUMBER OF FET
23836   L(1)=Lch1                                ! GATE LENGTH OF FET
23837   L(2)=Lch2
23838   IF N THEN 
23839     ON N GOTO L1,L2,L3,L4
23840 L4: L(6)=Lch6
23841 L3: L(5)=Lch5
23842 L2: L(4)=Lch4
23843 L1: L(3)=Lch3
23844   END IF
23845   Ilim=1.E-1
23846   IF ABS(Vds)>20 THEN                      ! I COMPLIANCE SELECTION
23847     Ilim=5.E-2
23848     IF ABS(Vds)>40 THEN Ilim=2.E-2
23849   END IF
23850   I=1                                      ! INITIAL SETTING
23851   St=0
23852   W01=0
23853   W11=0
23854   W0f=0
23855   W1f=0
23856   Connect(Port_(3),Pgate)
23857   Connect(Port_(7),Psource,Psubs_)
23858   Force_v(Pgate,Vgs,Vgs,1.E-5)             ! SET GATE-SOURCE VOLTAGE
23859   LOOP
23860   EXIT IF I>N+2
23861   EXIT IF Pdrain(I)=0
23862   EXIT IF St
23863     Connect(Port_(2),Pdrain(I))             ! SET DRAIN
23864     Force_v(Pdrain(I),Vds,Vds,Ilim)        ! SET DRAIN-SOURCE VOLTAGE
23865     Wait_th(.05)
23866     Measure_i(Pdrain(I),Ids,0)             ! MEASURE DRAIN-SOURCE CURRENT
23867     Port_status(Pdrain(I),St)              ! STATUS CHECK
23868     Connect(Port_(2),0)                     ! DISCONNECT SMU#2
23869     IF Ids=0 THEN Ids=1.E-12     !LEAST_SQUARES BY L=2*delta_L+C1*(1/Ids)!
23870     W01=W01+1/Ids                          ! W01=SUM(X):X=1/Ids,Y=Lch    !
23871     W11=W11+(1/Ids)^2                      ! W11=SUM(X^2):C0=2*delta_L   !
23872     W0f=W0f+L(I)                           ! W0F=SUM(Y):Y=C0+C1*X        !
23873     W1f=W1f+L(I)/Ids                       ! W1F=SUM(X*Y),W00=N+2        !
23874     I=I+1                                  ! |W00 W01| |C0|  |W0F|       !
23875   END LOOP                                 ! |       |X|  | =|   |       !
23876   IF St THEN                               ! |W10 W11| |C1|  |W1F|       !
23877     Ldelta=-9999999.99999
23878   ELSE
23879     IF I*W11-W01^2=0 THEN W01=W01*.99
23880     Ldelta=DROUND((W11*W0f-W01*W1f)/(I*W11-W01^2)/2,5)
23881   END IF
23882   Disable_port(Port_(2),Pgate)
23883   Connect                                  ! DISCONNECT
23884   RETURN Ldelta
23885 FNEND
