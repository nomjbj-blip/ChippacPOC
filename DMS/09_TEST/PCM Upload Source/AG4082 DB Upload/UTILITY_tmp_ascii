24621  SUB Graphdisp_xyl(REAL X(*),Y(*),INTEGER Np(*),Xlabel$,Ylabel$,INTEGER Xt,Yt,Title$,Desc$,REAL Lx(*),Ly(*),INTEGER Nlp(*),Legend$(*),Limit$(*))
24622  !========================================================================
24623  ! Description:
24624  !
24625  !   This functions is used to execute graph_xy.
24626  !
24627  ! Parameters:
24628  !
24629  !   X(*)      : X data 2-dim array (# of curves, # of plots)
24630  !   Y(*)      : Y data 2-dim array (# of curves, # of plots)
24631  !   Np(*)     : # of plots per a curve
24632  !   Xlabel    : Label of X axis
24633  !   Ylabel    : label of Y axis
24634  !   Xt        : X scale type. 1(LOG mode) or other(LINEAR mode)
24635  !   Yt        : Y scale type. 1(LOG mode) or other(LINEAR mode)
24636  !   Title     : Graph title
24637  !   Desc      : Graph description
24638  !   LX(*)     : X limit 2-dim array (# of limits, # of plots)
24639  !   LY(*)     : Y limit 2-dim array (# of limits, # of plots)
24640  !   Nlp(*)    : # of plots per a limit curve (1 dim)
24641  !   Legend(*) : Data legend per a curve
24642  !   Limit(*)  : Limit legend per a limit curve
24643  !
24644  !========================================================================
24645  !
24646  OPTION BASE 1
24647  !
24648  INTEGER C,P  ! Counters
24649  INTEGER Nc      ! Number of curves
24650  INTEGER Nlc     ! Number of limit curves
24651  REAL Xmin,Xmax  ! X axis range
24652  REAL Xv
24653  REAL Ymin,Ymax  ! Y axis range
24654  REAL Yv
24655  DIM Datafile$[1024],Limitfile$[1024]
24656  DIM Dataopt$[1024],Limitopt$[1024]
24657  DIM Avpath_graph_xy$[1024]
24658  DIM Temp$[256]
24659  DIM Qt$[2]
24660  !
24661  ! Check data
24662  !
24663  Nc=SIZE(X,1)
24664  IF Nc>8 THEN 
24665    Nc=9
24666  END IF
24667  !
24668  Nlc=SIZE(Lx,1)
24669  !
24670  IF Np(1)<=0 OR Nc<=0 THEN 
24671    PRINT "graphdisp_xyl: data is NULL."
24672    GOTO Error_abort
24673  END IF
24674  !
24675  ! Initialize Variables
24676  !
24677  ASSIGN @Pipe TO "/opt/SPECS/sys/bin/mktemp.sh /var/tmp | "   ! AVPATH_
24678  ENTER @Pipe;Temp$
24679  ASSIGN @Pipt TO *
24680  Datafile$=Temp$&"D.gxd"                           ! AVPATH_
24681  Dataopt$=" -f"&Datafile$
24682  Limitfile$=Temp$&"L.gxd"                          ! AVPATH_
24683  Limitopt$=" -l"&Limitfile$
24684  Avpath_graph_xy$="/opt/SPECS/sys/bin/graph_xy "
24685  Qt$=CHR$(34)
24686  !
24687  ON ERROR GOTO Data_not_exist
24688  PURGE Datafile$
24689 Data_not_exist:!
24690  OFF ERROR 
24691  ON ERROR GOTO Error_abort
24692  CREATE Datafile$,1
24693  ASSIGN @Data TO Datafile$;FORMAT ON
24694  !
24695  ! Calc Data Range
24696  !
24697  Ymin=Y(1,1)
24698  Ymax=Y(1,1)
24699  Xmin=X(1,1)
24700  Xmax=X(1,1)
24701  FOR C=1 TO Nc
24702    FOR P=1 TO Np(C)
24703      Xv=X(C,P)
24704      Yv=Y(C,P)
24705      !
24706      IF Xmin>Xv THEN 
24707        Xmin=Xv
24708      END IF
24709      IF Xmax<Xv THEN 
24710        Xmax=Xv
24711      END IF
24712      IF Ymin>Yv THEN 
24713        Ymin=Yv
24714      END IF
24715      IF Ymax<Yv THEN 
24716        Ymax=Yv
24717      END IF
24718    NEXT P
24719  NEXT C
24720  !
24721  ! Write Graph Title
24722  !
24723  OUTPUT @Data USING "-,K";"#T:"&Qt$&Title$&Qt$
24724  !
24725  ! Write Description
24726  !
24727  OUTPUT @Data USING "-,K";"#C:"&Qt$&Desc$&Qt$
24728  !
24729  ! Write X-Axis Label
24730  !
24731  OUTPUT @Data USING "-,K";"#XL:"&Qt$&Xlabel$&Qt$
24732  !
24733  ! Write Y-Axis Label
24734  !
24735  OUTPUT @Data USING "-,K";"#YL:"&Qt$&Ylabel$&Qt$
24736  !
24737  ! Write X Range
24738  !
24739  OUTPUT @Data USING "-,K,K,K,K,K";"#X:(";Xmin;",";Xmax;")"
24740  !
24741  ! Write Y Range
24742  !
24743  OUTPUT @Data USING "-,K,K,K,K,K";"#Y:(";Ymin;",";Ymax;")"
24744  !
24745  ! Write Plot Style
24746  !
24747  IF Xt=1 THEN 
24748    OUTPUT @Data USING "-,K";"#GX:"
24749  END IF
24750  IF Yt=1 THEN 
24751    OUTPUT @Data USING "-,K";"#GY:"
24752  END IF
24753  !
24754  ! Write Number of curves
24755  !
24756  OUTPUT @Data USING "#,K";"#A:("
24757  FOR C=1 TO Nc
24758    IF C=1 THEN 
24759      OUTPUT @Data USING "#,K";C
24760    ELSE
24761      OUTPUT @Data USING "#,K,K";",";C
24762    END IF
24763  NEXT C
24764  OUTPUT @Data USING "-,K";")"
24765  !
24766  FOR C=1 TO Nc
24767    !
24768    ! X Data
24769    !
24770    OUTPUT @Data USING "-,K";"#BX:"&Qt$&Qt$&","&Qt$&Qt$
24771    FOR P=1 TO Np(C)
24772      OUTPUT @Data USING "-,K";X(C,P)
24773    NEXT P
24774    !
24775    ! Y Data
24776    OUTPUT @Data USING "-,K,K,K,K";"#BY:"&Qt$&Qt$&","&Qt$&Legend$(C)&Qt$
24777    FOR P=1 TO Np(C)
24778      OUTPUT @Data USING "-,K";Y(C,P)
24779    NEXT P
24780  NEXT C
24781  !
24782  ASSIGN @Data TO *
24783  !
24784  ! Check Limit
24785  !
24786  IF Nlp(1)>0 AND Nlc>0 THEN 
24787    ON ERROR GOTO Limit_not_exist
24788    PURGE Limitfile$
24789 Limit_not_exist:!
24790    OFF ERROR 
24791    ON ERROR GOTO Error_abort
24792    CREATE Limitfile$,1
24793    ASSIGN @Limit TO Limitfile$;FORMAT ON
24794    OFF ERROR 
24795    !
24796    ON ERROR GOTO Error_abort
24797    !
24798    ! Write Number Of Limit Data
24799    !
24800    OUTPUT @Limit USING "#,K";"#A:("
24801    FOR C=1 TO Nlc
24802      IF C=1 THEN 
24803        OUTPUT @Limit USING "#,K";C
24804      ELSE
24805        OUTPUT @Limit USING "#,K,K";",";C
24806      END IF
24807    NEXT C
24808    OUTPUT @Limit USING "-,K";")"
24809    !
24810    ! Write Limit Data
24811    !
24812    FOR C=1 TO Nlc
24813      !
24814      ! X Limit
24815      !
24816      OUTPUT @Limit USING "-,K";"#BX:"&Qt$&Qt$&","&Qt$&Qt$
24817      FOR P=1 TO Nlp(C)
24818        OUTPUT @Limit USING "-,K";Lx(C,P)
24819      NEXT P
24820      !
24821      ! Y Limit
24822      !
24823      OUTPUT @Limit USING "-,K";"#BY:"&Qt$&Qt$&","&Qt$&Limit$(C)&Qt$
24824      FOR P=1 TO Nlp(C)
24825        OUTPUT @Limit USING "-,K";Ly(C,P)
24826      NEXT P
24827    NEXT C
24828    !
