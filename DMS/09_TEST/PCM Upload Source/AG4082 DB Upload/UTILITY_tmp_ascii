17121 Read_proccond:SUB Read_proccond(Filename$,INTEGER Ret,Readnum)
17122 !***** DON'T REMOVE THIS LINE *************************************
17123 !
17124 !  Type : Algorithm
17125 !  Name : READ_PROCCOND
17126 !  Vers : 1
17127 !  Desc : Read process condition file.
17128 !  Date : 05/31/2004
17129 !  Time : 03:00:00
17130 !  User : specs
17131 !
17132 !***** DON'T REMOVE THIS LINE *************************************
17133 !
17134 !  Input Variables:
17135 !
17136 !     #  Name            Type Size     Description
17137 !    --- --------------- ---- -------- --------------------------------
17138 !    Measurement Parameters:
17139 !      1 Filename        S    -        file name
17140 !
17141 !  Output Variables:
17142 !
17143 !     #  Name            Type Size     Description
17144 !    --- --------------- ---- -------- --------------------------------
17145 !    Output Parameters:
17146 !      1 Ret             I    -        return code
17147 !      2 Readnum         I    -        the number of read condition
17148 !
17149 !***** DON'T REMOVE THIS LINE *************************************
17150         OPTION BASE 1  !***** DON'T REMOVE THIS LINE *****
17151 !
17152         INTEGER Idx_tag
17153         DIM Name$[32]
17154         INTEGER Type,Dim,Size1,Size2
17155         INTEGER Cond_val_num,Cond_name_num
17156         DIM Line$[1025]
17157         INTEGER Find_header
17158         DIM Deli$[4]
17159         DIM Lot_id$[255],Wafer_id$[255],Value$[255]
17160         INTEGER Slot_no
17161         INTEGER Cond_no
17162         INTEGER Max_name_num
17163         INTEGER Line_num
17164 !
17165         Ret=0
17166         Deli$=","
17167         Max_name_num=10
17168 !
17169 ! check tag variable exists or not
17170         Tpltagindex("SYSTEM","TST_PROCCOND_VAL",Idx_tag)
17171         IF Idx_tag=-1 THEN 
17172            GOTO Other_err
17173         END IF
17174 !
17175 ! tag variable must be type of STRING[5][n]
17176         Tpltaginfo("SYSTEM",Idx_tag,Name$,Type,Dim,Size1,Size2)
17177         IF (Type<>3) OR (Dim<>2) OR (Size2<>5) THEN 
17178            GOTO Other_err
17179         END IF
17180 !
17181 ! open process condition file
17182         ON ERROR GOTO Nofile
17183         ASSIGN @File TO Filename$;FORMAT ON
17184         OFF ERROR 
17185 !
17186 ! allocate and initialize buffer
17187         ALLOCATE Conds$(Size2,Size1)[255]
17188         FOR I=1 TO Size2
17189            FOR J=1 TO Size1
17190               Conds$(I,J)=""
17191            NEXT J
17192         NEXT I
17193         ALLOCATE Names$(Max_name_num)[255]
17194 !
17195 ! ============
17196 !  main loop
17197 ! ============
17198 !
17199         Cond_val_num=0
17200         Cond_name_num=0
17201         Find_header=0
17202         Line_num=0
17203         ON END @File GOTO Eof
17204         LOOP
17205            ENTER @File;Line$
17206            Line_num=Line_num+1
17207 !
17208 !   !! skip empty line
17209            IF LEN(Line$)=0 THEN GOTO Loop_end
17210 !
17211 !   !! check if line length <= 1024
17212            IF LEN(Line$)=1025 THEN GOTO Bad_format
17213 !
17214 !   !! find header line (only 1st)
17215            IF Find_header=0 AND Line$[1;5]="#lot," THEN 
17216 !     !! skip 1st and 2nd element
17217               FOR I=1 TO 2
17218                  Line$=Line$[POS(Line$,Deli$)+1]
17219               NEXT I
17220 !
17221 !     !! read condition names
17222               LOOP
17223               EXIT IF LEN(Line$)=0
17224                  Strpos=POS(Line$,Deli$)
17225 !
17226 !       !! count up
17227                  Cond_name_num=Cond_name_num+1
17228 !
17229 !       !! check max number of condition
17230                  IF Cond_name_num>Max_name_num THEN GOTO Bad_format
17231 !
17232 !       !! hold condition name
17233                  IF Strpos=0 THEN 
17234                     Names$(Cond_name_num)=Line$
17235                     Line$=""
17236                  ELSE
17237                     Names$(Cond_name_num)=Line$[1;Strpos-1]
17238                     IF Strpos=LEN(Line$) THEN 
17239                        Line$=""
17240                     ELSE
17241                        Line$=Line$[Strpos+1]
17242                     END IF
17243                  END IF
17244               END LOOP
17245 !     !! go to next line
17246               Find_header=1
17247               GOTO Loop_end
17248            END IF
17249 !
17250 !   !! skip comment line
17251            IF Line$[1;1]="#" THEN GOTO Loop_end
17252 !
17253 !   !!-------------
17254 !   !! valid line
17255 !   !!-------------
17256 !   !! lot ID
17257            Strpos=POS(Line$,Deli$)
17258            IF Strpos=0 THEN GOTO Bad_format
17259            Lot_id$=Line$[1;Strpos-1]
17260            IF Strpos=LEN(Line$) THEN GOTO Bad_format
17261            Line$=Line$[Strpos+1]
17262 !
17263 !   !! wafer ID
17264            Strpos=POS(Line$,Deli$)
17265            IF Strpos=0 THEN GOTO Bad_format
17266            Wafer_id$=Line$[1;Strpos-1]
17267            IF Strpos=LEN(Line$) THEN GOTO Bad_format
17268            Line$=Line$[Strpos+1]
17269 !
17270 !   !! find slot number
17271            Get_slot_no(Lot_id$,Wafer_id$,Slot_no)
17272            IF Slot_no=0 THEN GOTO Loop_end
17273 !
17274 !   !! read each condition value
17275            Cond_no=0
17276            LOOP
17277            EXIT IF LEN(Line$)=0
17278               Strpos=POS(Line$,Deli$)
17279 !
17280 !     !! count up counter
17281               Cond_val_num=Cond_val_num+1
17282               Cond_no=Cond_no+1
17283 !
17284 !     !! check limitation
17285               IF Cond_val_num>Size1 THEN GOTO Too_many
17286               IF Cond_no>Cond_name_num THEN GOTO Bad_format
17287 !
17288 !     !! get value
17289               IF Strpos=0 THEN 
17290                  Value$=Line$
17291                  Line$=""
17292               ELSE
17293                  Value$=Line$[1;Strpos-1]
17294                  IF Strpos=LEN(Line$) THEN 
17295                     Line$=""
17296                  ELSE
17297                     Line$=Line$[Strpos+1]
17298                  END IF
17299               END IF
17300 !
17301 !     !! set value
17302               Conds$(1,Cond_val_num)=VAL$(Slot_no)
17303               Conds$(2,Cond_val_num)=Lot_id$
17304               Conds$(3,Cond_val_num)=Wafer_id$
17305               Conds$(4,Cond_val_num)=Names$(Cond_no)
17306               Conds$(5,Cond_val_num)=Value$
17307 !
17308            END LOOP
17309 !
17310 Loop_end:   !
17311         END LOOP
17312 !
17313 Nofile:   !
17314         Ret=-1
17315         SUBEXIT
17316 !
17317 Bad_format:   !
17318         Ret=-2
17319         GOTO Eof
17320 !
17321 Too_many:   !
17322         Ret=-3
17323         GOTO Eof
17324 !
17325 Other_err:   !
17326         Ret=-4
17327         SUBEXIT
17328 !
17329 Eof:   !
17330         OFF END @File
17331 !
17332         ASSIGN @File TO *
17333 !
17334 ! !! set result
17335         Tplputsatag("SYSTEM",Idx_tag,0,Conds$(*))
17336         IF Ret=0 THEN Readnum=Cond_val_num
17337         IF Ret=-2 THEN Readnum=Line_num
17338 !
17339         DEALLOCATE Conds$(*)
17340         DEALLOCATE Names$(*)
17341 !
17342      SUBEND
