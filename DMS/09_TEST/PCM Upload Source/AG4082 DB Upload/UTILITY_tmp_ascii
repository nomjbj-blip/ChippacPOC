15994 Rcp_check_key:SUB Rcp_check_key(Filename$,INTEGER Status,Errmsg$,Dupkey$)
15995 !***** DON'T REMOVE THIS LINE *************************************
15996 !
15997 !  Type : Algorithm
15998 !  Name : RCP_CHECK_KEY
15999 !  Vers : 1
16000 !  Desc : Check if recipe file has duplicate key fields.
16001 !       :   SPECS3.0: Initial revision.
16002 !  Date : 09/01/2002
16003 !  Time : 09:00:00
16004 !  User : specs
16005 !
16006 !***** DON'T REMOVE THIS LINE *************************************
16007 !
16008 !  Input Variables:
16009 !
16010 !     #  Name            Type Size     Description
16011 !    --- --------------- ---- -------- --------------------------------
16012 !    Measurement Parameters:
16013 !      1 Filename        S    -
16014 !
16015 !  Output Variables:
16016 !
16017 !     #  Name            Type Size     Description
16018 !    --- --------------- ---- -------- --------------------------------
16019 !    Output Parameters:
16020 !      1 Status          I    -        0: OK, -1: Err, -2: No File
16021 !      2 Errmsg          S    -
16022 !      3 Dupkey          S    -        Duplicated key
16023 !
16024 !***** DON'T REMOVE THIS LINE *************************************
16025         OPTION BASE 1  !***** DON'T REMOVE THIS LINE *****
16026 !
16027         DIM Cmd$[8192],Dst$[256],Keylst$[256],Diff$[256],Nullkey$[256],Detail$(10)[256]
16028         DIM Key$[4096],Key2$[256]
16029         DIM File_nm$(3)[256],Pat$(3)[256],Rep$(3)[256],Rep_fl$(3)[256],Name$(3)[256]
16030         INTEGER Cmd_ret,Ndetail,Pos,Rep_fl_len,I,File_name_len
16031         REAL Line_no
16032         Tab$=CHR$(9)
16033 !
16034         Dst$="/var/tmp/rcp_key."&SYSTEM$("PROCESS ID")
16035         Keylst$="/var/tmp/rcp_keylst."&SYSTEM$("PROCESS ID")
16036         Diff$="/var/tmp/rcp_keydif."&SYSTEM$("PROCESS ID")
16037         Nullkey$="/var/tmp/rcp_nullkey."&SYSTEM$("PROCESS ID")
16038         Dupkey$=""
16039         Status=0
16040 !
16041         ON ERROR GOTO No_recipe_file
16042         ASSIGN @Fn TO Filename$
16043         ASSIGN @Fn TO *
16044         OFF ERROR 
16045 !
16046         Cmd$="/usr/bin/grep -Ee '^[^#][^\t ]*' "&Filename$&" | /usr/bin/cut -f 1"
16047         Cmd$=Cmd$&" | /usr/bin/grep -Ee '^[^\t]' | /usr/bin/sort"
16048         Rcp_exec_cmd(Cmd$,Dst$,Status,Errmsg$,Ndetail,Detail$(*),Cmd_ret)
16049         IF Status THEN 
16050            GOSUB Remove_file
16051            SUBEXIT
16052         END IF
16053 !
16054         Cmd$="/usr/bin/awk '/^.+$/{if (!match($0,""^[A-Za-z0-9_]+$"")){print $0;exit}}' "&Dst$
16055         ASSIGN @Pipe TO Cmd$&" | "
16056         ON END @Pipe GOTO Invalid_eof
16057         ENTER @Pipe;Key$
16058 !
16059         Status=-1
16060         Errmsg$="Recipe key must consist of A-Z,a-z,0-9 and '_': """&Key$&""""
16061         GOSUB Remove_file
16062         SUBEXIT
16063 Invalid_eof:    !
16064         OFF END @Pipe
16065         ASSIGN @Pipe TO *
16066 !
16067         Cmd$="/usr/bin/uniq "&Dst$
16068         Rcp_exec_cmd(Cmd$,Keylst$,Status,Errmsg$,Ndetail,Detail$(*),Cmd_ret)
16069         IF Status THEN 
16070            GOSUB Remove_file
16071            SUBEXIT
16072         END IF
16073 !
16074         Cmd$="/usr/bin/diff "&Dst$&" "&Keylst$
16075         Rcp_exec_cmd(Cmd$,Diff$,Status,Errmsg$,Ndetail,Detail$(*),Cmd_ret)
16076         IF Status THEN 
16077            IF Cmd_ret=1 THEN 
16078               Cmd$="/usr/bin/awk '{if (match($1,""^[<>]+"")){print $2;}}' "&Diff$
16079               ON ERROR GOTO No_exec
16080               ASSIGN @Pipe TO Cmd$&" | "
16081               ON END @Pipe GOTO Eof
16082               ENTER @Pipe;Key$
16083               Errmsg$="Duplicate key is found, """&Key$&"""."
16084               Dupkey$=Key$
16085 Eof: !
16086               OFF END @Pipe
16087               ASSIGN @Pipe TO *
16088 No_exec: !
16089            END IF
16090            GOSUB Remove_file
16091            SUBEXIT
16092         END IF
16093 !
16094         Cmd$="/usr/bin/sed -e 's/"&Tab$&"[^"&Tab$&"][^"&Tab$&"]*/"&Tab$&"X/g' "&Filename$
16095         Cmd$=Cmd$&" | /usr/bin/awk -F'\t' 'BEGIN{ln=0;}"
16096         Cmd$=Cmd$&"/^[^#]/{ln=ln+1;"
16097         Cmd$=Cmd$&"if((!match($0,""^[ \t]*$""))&&match($1,""^[ ]*$"")){print ln;exit 0;}}"
16098         Cmd$=Cmd$&"END{print 0;}'"
16099         Rcp_exec_cmd(Cmd$,Nullkey$,Status,Errmsg$,Ndetail,Detail$(*),Cmd_ret)
16100         IF Status THEN 
16101            GOSUB Remove_file
16102            SUBEXIT
16103         END IF
16104 !
16105         ON ERROR GOTO No_null_key
16106         ASSIGN @Pipe TO "/usr/bin/cat "&Nullkey$&" | "
16107         ON END @Pipe GOTO Eof_null_key
16108         ENTER @Pipe;Line_no
16109         IF Line_no>0 THEN 
16110            Status=-1
16111            Errmsg$="Null key is found at line "&VAL$(Line_no)&"."
16112         END IF
16113 Eof_null_key: !
16114         OFF END @Pipe
16115         ASSIGN @Pipe TO *
16116 No_null_key: !
16117 !
16118         Name$(1)="RCP_TPL"
16119         Name$(2)="RCP_LIM"
16120         Name$(3)=""
16121         File_nm$(1)=""
16122         File_nm$(2)=""
16123         File_nm$(3)=""
16124         FOR I=1 TO SIZE(Name$,1)-1
16125            Rcp_sysconf(Name$(I),File_nm$(I),Status)
16126            IF (Status<>0) THEN 
16127               Errmsg$=""""&Name$(I)&""""&"is not found in sysconf."
16128            END IF
16129         NEXT I
16130         Pat$(1)="$(RCP)"
16131         Pat$(2)="$(SI)"
16132         Pat$(3)=""
16133         Rep$(1)=""
16134         Rep$(2)="0"
16135         Rep$(3)=""
16136         FOR I=1 TO SIZE(Rep_fl$,1)-1
16137            Pos=0
16138            Rep_fl$(I)=""
16139            String_lookup(File_nm$(I),Pat$(1),Pos)
16140            IF (Pos>0) THEN 
16141               Rcp_replace_wd(File_nm$(I),Pat$(*),Rep$(*),Rep_fl$(I))
16142            END IF
16143         NEXT I
16144 !
16145         ON ERROR GOTO Internal_file
16146         ASSIGN @Keylst TO Keylst$;FORMAT ON
16147         ON END @Keylst GOTO Eof_name_check
16148         File_name_len=32
16149         LOOP
16150            ENTER @Keylst;Key$
16151            Key$=Key$[1;255]
16152            FOR I=1 TO SIZE(Rep_fl$,1)-1
16153               Rep_fl_len=LEN(Rep_fl$(I))
16154               IF Rep_fl_len>0 THEN 
16155                  IF Rep_fl_len+LEN(Key$)>File_name_len THEN 
16156                     Status=-1
16157                     Key2$=Key$[1;File_name_len]
16158                     Errmsg$="Recipe key is too long. (0 < key lenght <= "&VAL$(File_name_len-Rep_fl_len)&")"
16159                     Errmsg$=Errmsg$&CHR$(10)&"It is used as a part of test plan or limit file name. ("&Key2$&")"
16160                     ASSIGN @Keylst TO *
16161                     GOSUB Remove_file
16162                     SUBEXIT
16163                  END IF
16164               END IF
16165            NEXT I
16166         END LOOP
16167 Internal_file:  !
16168         OFF ERROR 
16169         ASSIGN @Keylst TO *
16170         Status=-1
16171         Errmsg$="Error on accessing internal file, "&Keylst$
16172         GOSUB Remove_file
16173         SUBEXIT
16174 Eof_name_check:  !
16175         ASSIGN @Keylst TO *
16176 !
16177         GOSUB Remove_file
16178         SUBEXIT
16179 !
16180 Remove_file: !
16181         ON ERROR GOTO Rm_nullkey
16182         PURGE Nullkey$
16183 Rm_nullkey: !
16184         OFF ERROR 
16185         ON ERROR GOTO Rm_keylst
16186         PURGE Dst$
16187 Rm_keylst: !
16188         OFF ERROR 
16189         ON ERROR GOTO Rm_dif
16190         PURGE Keylst$
16191 Rm_dif: !
16192         OFF ERROR 
16193         ON ERROR GOTO Rm_end
16194         PURGE Diff$
16195 Rm_end: !
16196         OFF ERROR 
16197         RETURN 
16198 !
16199 No_recipe_file: !
16200         ASSIGN @Fl TO *
16201         OFF ERROR 
16202         Status=-2
16203         Errmsg$="Recipe file is not found."
16204         SUBEXIT
16205 !
16206      SUBEND
