23381 DEF FNR2t(INTEGER Pin1,Pin2,REAL Itest,OPTIONAL Vlim)
23382   INTEGER Port(2:3),St
23383   Iforce=ABS(Itest)                        ! SOURCE CURRENT
23384   IF Iforce>=1.E-9 THEN 
23385     Twait=.01                              ! WAIT TIME SELECTION
23386     IF Iforce<=2.E-5 THEN                  ! 2E-5>=|Itest|>3E-8
23387       Twait=.4
23388       IF Iforce<=3.E-8 THEN                ! 3E-8>=|Itest|>5E-9
23389         Twait=5
23390         IF Iforce<5.E-9 THEN Twait=10      ! 5E-9>=|Itest|>=1E-9
23391       END IF
23392     END IF
23393     Vlimit=20
23394     IF NPAR>3 THEN Vlimit=Vlim             ! VOLTAGE LIMIT
23395     Port(3)=32703
23396     Port(2)=32702
23397     Connect(Port(2),Pin1)
23398     Connect(Port(3),Pin2)                  ! CONNECT RESISTOR
23399     Force_v(Pin1,0,20,1.E-1)               ! SET SMU#2 0V
23400     Force_i(Pin2,Itest,0,Vlimit)           ! SET CURRENT
23401     Wait_th(Twait)
23402     Measure_v(Pin2,Vmeas,0)                ! MEASURE VOLTAGE
23403     Measure_i(Pin1,Imeas,0)                ! MEASURE CURRENT
23404     Port_status(Pin1,St)
23405     IF ABS(Imeas)>=9.E-10 AND ABS(Vmeas)>=1.E-2 AND St<>2 THEN 
23406       R=DROUND(-Vmeas/Imeas,5)             ! CALCULATE R
23407     ELSE
23408       R=-9999999.99999
23409     END IF
23410     Disable_port(Pin1,Pin2)
23411     Connect(0,Pin1,Pin2)                   ! DISCONNECT
23412   ELSE
23413     R=-9999999.99999                       ! OUT OF MEASUREMENT
23414   END IF                                   ! IF ABS(Iforce)>=1.E-9
23415   RETURN R
23416 FNEND
23417!--------------------------------------------
23418 DEF FNR4t(INTEGER Vpin1,Ipin1,Vpin2,Ipin2,REAL Itest,OPTIONAL Vlim)
23419   INTEGER P,Port(1:4),St
23420   Iforce=ABS(Itest)                        ! SOURCE CURRENT
23421   IF Iforce>=1.E-6 THEN 
23422     Vlimit=20                              ! VLIM DEFAULT
23423     IF NPAR>5 THEN Vlimit=Vlim             ! VOLTAGE LIMIT
23424     Twait=.01
23425     IF Iforce<=2.E-5 THEN Twait=.4         ! WAIT TIME SELECTION
23426     FOR P=1 TO 4
23427       Port(P)=32700+P
23428     NEXT P
23429     Disable_port(Port(1),Port(2),Port(3))
23430     Connect(Port(1),Ipin1)                 ! CONNECT RESISTOR
23431     Connect(Port(2),Vpin1)
23432     Connect(Port(3),Vpin2)
23433     Connect(Port(4),Ipin2)
23434     Force_v(Ipin2,0,20,1.E-1)              ! SET I MEASUREMENT MODE
23435     Force_i(Vpin2,1.E-10,1.E-9,20)         ! SET V MEASUREMENT MODE
23436     Force_i(Vpin1,1.E-10,1.E-9,Vlimit)     ! SET V MEASUREMENT MODE
23437     Force_i(Ipin1,Itest,0,Vlimit)          ! SET CURRENT
23438     Wait_th(Twait)
23439     Measure_i(Ipin2,Imeas,0)               ! MEASURE CURRENT
23440     Measure_v(Vpin2,Vm2,0)                 ! MEASURE V2
23441     Measure_v(Vpin1,Vm1,0)                 ! MEASURE V1
23442     Port_status(Ipin2,St)
23443     IF ABS(Imeas)>=9.E-7 AND ABS(Vm1)>=1.E-2 AND St<>2 THEN 
23444       R=DROUND(-(Vm1-Vm2)/Imeas,5)         ! CALCULATE R
23445     ELSE
23446       R=-9999999.99999
23447     END IF
23448     Disable_port(Ipin1,Vpin1,Vpin2,Ipin2)
23449     Connect(0,Ipin1,Vpin1,Vpin2,Ipin2)     ! DISCONNECT
23450   ELSE
23451     R=-9999999.99999                       ! OUT OF MEASUREMENT
23452   END IF                                   ! IF Iforce>=1.E-6
23453   RETURN R
23454 FNEND
