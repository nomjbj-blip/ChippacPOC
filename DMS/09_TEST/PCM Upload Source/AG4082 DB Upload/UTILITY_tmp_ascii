23979  !
23980   Connect(Port(2),Pcollector,Pbase)
23981   Connect(Port(7),Pemitter)
23982   IF Psubs THEN 
23983     Connect(Port(3),Psubs)
23984     Force_v(Psubs,Vsubs_actual,Vsubs_actual,1.0E-3)
23985   END IF
23986  !
23987   Counter=0
23988   FOR I=Subscript_min TO Subscript_max
23989     IF Ids(I)=0. THEN Measure_end          ! ZERO CURRENT IS END MARK
23990     Force_i(Pcollector,Ids(I),0,Vcomp_actual)
23991     J=I-(Subscript_min-1)                  ! J STARTS FROM 1
23992     Measure_v(Pcollector,Vgs(J),0)
23993     Port_status(Pcollector,Pstatus)
23994     IF Pstatus THEN                        ! ABNORMAL CONDITIONS
23995       Disable_port(Pcollector,Psubs)
23996       Connect(0,Pcollector,Pbase,Pemitter,Psubs)! DISCONNECT
23997       Vth=-9999999.99999
23998       GOTO Function_end
23999     ELSE
24000       Counter=Counter+1                    ! SUCCESSFUL MEASUREMENT
24001     END IF
24002   NEXT I
24003 Measure_end: !
24004  !
24005   Disable_port(Pcollector,Psubs)
24006   Connect(0,Pcollector,Pbase,Pemitter,Psubs)! DISCONNECT
24007   IF (Counter=0) OR (Counter=1) THEN       ! NOT ENOUGH DATA
24008     Vth=9999999.99999
24009     GOTO Function_end
24010   END IF
24011  !
24012   Vgsi=0.                                  ! Vgsi =Sigma(Vgs)
24013   Vgsi2=0.                                 ! Vgsi2=Sigma(Vgs*Vgs)
24014   FOR J=1 TO Counter
24015     Vgsi=Vgsi+Vgs(J)
24016     Vgsi2=Vgsi2+(Vgs(J)*Vgs(J))
24017   NEXT J
24018   Ridsi=0.                                 ! Ridsi=Sigma(Sqr(Ids))
24019   Ridsi_vgsi=0.                            ! Ridsi_vgsi=Sigma(Sqr(Ids)*Vgs)
24020   FOR J=1 TO Counter
24021     I=J+(Subscript_min-1)
24022     IF 0<=Ids(I) THEN 
24023       Ridsi=Ridsi+SQR(ABS(Ids(I)))
24024       Ridsi_vgsi=Ridsi_vgsi+(SQR(ABS(Ids(I)))*Vgs(J))
24025     ELSE
24026       Ridsi=Ridsi+(-SQR(ABS(Ids(I))))
24027       Ridsi_vgsi=Ridsi_vgsi+(-SQR(ABS(Ids(I)))*Vgs(J))
24028     END IF
24029   NEXT J
24030   Numerator=(Vgsi2*Ridsi)-(Vgsi*Ridsi_vgsi)
24031   Denominator=(Vgsi*Ridsi)-(Counter*Ridsi_vgsi)
24032   IF Denominator=0. THEN                   ! AVOID ZERO DIVIDE
24033     Vth=9999999.99999
24034     GOTO Function_end
24035   END IF
24036   Vth=PROUND(Numerator/Denominator,-3)     ! ROUND AT 1.E-3
24037 Function_end: !
24038   RETURN Vth
24039 FNEND
