23472 DEF FNBvcbo(REAL Ic,OPTIONAL Vlim,Time)
23473   OPTION BASE 1                            !
23474   COM /þtrpins/ INTEGER Port(1:11),Pemitter,Pbase,Pcollector,Psubs
23475   INTEGER N
23476   N=NPAR
23477   Vlimit=20                                ! VOLTAGE LIMIT DEFAULT
23478   Twait=.4                                 ! WAIT TIME DEFAULT
23479   IF N>1 THEN 
23480     IF Vlim<>0 THEN Vlimit=ABS(Vlim)
23481     IF N>2 THEN Twait=Time                 ! SET WAIT TIME
23482   END IF
23483   Connect(Port(7),Pemitter,Pbase,Pcollector,Psubs)! DISCHARGE
23484   Wait_th(.01)
23485   Connect(0,Pemitter,Psubs)                ! DISCONNECT
23486   Connect(Port(1),Pcollector)              ! SET COLLECTOR
23487   Force_i(Pcollector,Ic,0,Vlimit)          ! SET CURRENT
23488   Wait_th(Twait)
23489   Measure_v(Pcollector,Vmeas,0)            ! MEASURE Bvcbo
23490   Disable_port(Pcollector)
23491   Connect(Port(7),Pemitter,Pcollector,Psubs)! DISCHARGE
23492   Wait_th(.01)
23493   Connect(0,Pcollector,Pbase)              ! DISCONNECT
23494   RETURN Vmeas
23495 FNEND
