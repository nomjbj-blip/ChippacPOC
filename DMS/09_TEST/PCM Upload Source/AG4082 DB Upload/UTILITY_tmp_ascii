25153 SUB Iccap_vatnrd(X$,REAL X)
25154!***********************************************************************
25155!
25156!  Type : Subprogram
25157!  Name : ICCAP_VATNRD
25158!  Vers : 1
25159!  Desc : Convert a string to a number
25160!  Date : 06/01/1998
25161!  Time : 09:00:00
25162!  User : specs
25163!
25164!***********************************************************************
25165!
25166!  #  Dir   Name            Type Size     Description
25167! --- ----- --------------- ---- -------- ------------------------------
25168!   1 IN    X$              S    -        formatted string
25169!   2 OUT   X               R    -        converted number
25170!
25171!***********************************************************************
25172!
25173    DIM L$[1]
25174    L$=X$[LEN(X$);1]            ! check last letter
25175    X=VAL(X$)                   ! convert to number first
25176    SELECT L$                   ! check if suffix matches or not
25177    CASE "T"
25178      X=X*1.E+12
25179    CASE "G"
25180      X=X*1.E+9
25181    CASE "M"
25182      X=X*1.E+6
25183    CASE "K"
25184      X=X*1.E+3
25185    CASE "m"
25186      X=X*1.E-3
25187    CASE "u"
25188      X=X*1.E-6
25189    CASE "n"
25190      X=X*1.E-9
25191    CASE "p"
25192      X=X*1.E-12
25193    CASE "f"
25194      X=X*1.E-15
25195    CASE "a"
25196      X=X*1.E-18
25197    END SELECT
25198 SUBEND
25199 SUB Iccap_vatnwr(REAL X,X$)
25200!***********************************************************************
25201!
25202!  Type : Subprogram
25203!  Name : ICCAP_VATNWR
25204!  Vers : 1
25205!  Desc : Convert a number to string (engineering format).
25206!  Date : 06/01/1998
25207!  Time : 09:00:00
25208!  User : specs
25209!
25210!***********************************************************************
25211!
25212!  #  Dir   Name            Type Size     Description
25213! --- ----- --------------- ---- -------- ------------------------------
25214!   1 IN    X               R    -        number to convert
25215!   2 OUT   X$              S    -        formatted string
25216!
25217!***********************************************************************
25218!
25219   DIM S$[256],M$[256],E$[256]
25220   INTEGER Prec
25221   Prec=4
25222   IF X THEN 
25223     OUTPUT S$ USING "#,S"&RPT$("D",Prec)&"ESZZ";X
25224   ELSE
25225     S$="+0000E-03"                        ! 0 is an exception
25226   END IF
25227   M$=S$[1,Prec+1]
25228   E$=S$[Prec+3]
25229   Exp=VAL(E$)
25230   Exp3=INT((Exp+3)/3)
25231   Shft=(3+Exp MOD 3) MOD 3
25232   SELECT Exp3
25233   CASE >=5
25234     Mul$="E+"&VAL$(Exp3*3)
25235   CASE 4
25236     Mul$="T"
25237   CASE 3
25238     Mul$="G"
25239   CASE 2
25240     Mul$="M"
25241   CASE 1
25242     Mul$="K"
25243   CASE 0
25244     Mul$=""
25245   CASE -1
25246     Mul$="m"
25247   CASE -2
25248     Mul$="u"
25249   CASE -3
25250     Mul$="n"
25251   CASE -4
25252     Mul$="p"
25253   CASE -5
25254     Mul$="f"
25255   CASE -6
25256     Mul$="a"
25257   CASE <=-7
25258     Mul$="E"&VAL$(Exp3*3)
25259   END SELECT
25260   OUTPUT X$ USING "#,K,K";VAL(M$[1,2+Shft]&"."&M$[3+Shft,Prec+1]),Mul$
25261 SUBEND
25262 SUB Iccap_mdmfwr(Head$(*),INTEGER Size(*),REAL Data(*),INTEGER Loop(*),File$,INTEGER Status)
25263!***********************************************************************
25264!
25265!  Type : Subprogram
25266!  Name : ICCAP_MDMFWR
25267!  Vers : 1
25268!  Desc : Write given Data(*) in *.mdm format.  The file is saved with
25269!         specified name.
25270!  Date : 06/01/1998
25271!  Time : 09:00:00
25272!  User : specs
25273!
25274!***********************************************************************
25275!
25276!  #  Dir   Name            Type Size     Description
25277! --- ----- --------------- ---- -------- ------------------------------
25278!   1 IN    Head            S    *        *.mdm file header information
25279!   2 IN    Size            I    *,3      Size information
25280!   3 IN    Data            R    *,*      Measurement data
25281!   4 IN    Loop            I    *,5      Loop array
25282!   5 IN    File            S    -        File name (w/ expected suffix .mdm)
25283!   6 OUT   Status          I    -        File creation status (0: ok, -1: error)
25284!
25285!***********************************************************************
25286!
25287   COM /Iccap/ Path$[256],Vat$(0:256,1:2)[256],INTEGER Vatn
25288   DIM Mdmfile$[256],Name$[256]
25289   INTEGER U,V,Iv,Ivn,Ov,Nv,Nv1,Nvn,Pos
25290!
25291   Iccap_mdminit(Head$(*),Size(*),Data(*),Loop(*),Iv,Ivn,Ov,Nv,Nv1,Nvn)
25292!
25293   IF File$[1;1]="/" THEN 
25294     Mdmfile$=File$
25295   ELSE
25296     Mdmfile$=Path$&"/"&File$
25297   END IF
25298!
25299   ON ERROR GOTO O                      ! remove old *.mdm
25300   PURGE Mdmfile$
25301   OFF ERROR 
25302!
25303 O:ON ERROR GOTO E
25304   FOR I=LEN(Mdmfile$) TO 1 STEP -1
25305     IF Mdmfile$[I;1]="/" THEN GOTO D
25306   NEXT I
25307 D:EXECUTE "mkdir -p "&Mdmfile$[1,I]
25308   CREATE Mdmfile$,1                    ! create *.mdm
25309   ASSIGN @F TO Mdmfile$;FORMAT ON,EOL CHR$(10)
25310!
25311   OUTPUT @F;"BEGIN_HEADER"             ! BEGIN_HEADER
25312   OUTPUT @F;"  ICCAP_INPUTS"           ! ICCAP_INPUTS
25313   FOR V=1 TO Iv
25314     IF Size(V,1)=1 THEN                ! if it is input
25315       OUTPUT @F;"    "&Head$(V)
25316     END IF
25317   NEXT V
25318   OUTPUT @F;"  ICCAP_OUTPUTS"          ! ICCAP_OUTPUTS
25319   FOR V=Iv+1 TO Iv+Ov
25320     IF Size(V,1)=2 THEN                ! if it is output
25321       OUTPUT @F;"    "&Head$(V)
25322     END IF
25323   NEXT V
25324   OUTPUT @F;"END_HEADER"               ! END_HEADER
25325   OUTPUT @F
25326!
25327   Pos=1                                        ! offset in Data(*)
25328   FOR N=1 TO Nvn                               ! for each data block
25329     OUTPUT @F;"BEGIN_DB"
25330     FOR V=1 TO Iv                              ! for each input variable
25331       IF ABS(Size(V,2))<>1 THEN                ! exclude master sweep
25332         OUTPUT @F;"  ICCAP_VAR ";
25333         Name$=Head$(V)[1;POS(Head$(V)," ")]
25334         OUTPUT @F;Name$;" ";Data(V,Pos)
25335       END IF
25336     NEXT V
25337     OUTPUT @F
25338     OUTPUT @F;"#";
25339     FOR V=1 TO Iv                              ! for each input variable
25340       IF Size(V,2)=1 THEN                      ! master sweep (#1)
25341         Name$=Head$(V)[1;POS(Head$(V)," ")]
25342         OUTPUT @F USING "#,K,X";Name$
25343       END IF
25344     NEXT V
25345     FOR V=1 TO Iv                              ! for each input variable
25346       IF Size(V,2)=-1 THEN                     ! sync sweep
25347         Name$=Head$(V)[1;POS(Head$(V)," ")]
25348         OUTPUT @F USING "#,K,X";Name$
25349       END IF
25350     NEXT V
25351     FOR V=Iv+1 TO Iv+Ov                        ! for each output variable
25352       Name$=Head$(V)[1;POS(Head$(V)," ")]
25353       OUTPUT @F USING "#,K,X";Name$
25354     NEXT V
25355     OUTPUT @F
25356     FOR U=1 TO Nv1                             ! for all data points
25357       FOR V=1 TO Iv                            ! output sweep
25358         IF Size(V,2)=1 THEN 
25359           OUTPUT @F;Data(V,Pos+U-1);" ";
25360         END IF
25361       NEXT V
25362       FOR V=1 TO Iv                            ! output sweep
25363         IF Size(V,2)=-1 THEN 
25364           OUTPUT @F;Data(V,Pos+U-1);" ";
25365         END IF
25366       NEXT V
25367       FOR V=Iv+1 TO Iv+Ov                      ! output value
25368         OUTPUT @F;Data(V,Pos+U-1);" ";
25369       NEXT V
25370       OUTPUT @F
25371     NEXT U
25372     OUTPUT @F;"END_DB"
25373     OUTPUT @F
25374     Iccap_mdmloop(Head$(*),Size(*),Data(*),Loop(*),Pos)
25375   NEXT N
25376!
25377   ASSIGN @File TO *
25378   Status=0                             ! normal completion
25379   SUBEXIT
25380 E:OFF ERROR                            ! unexpected error
25381   Status=-1
25382 SUBEND
