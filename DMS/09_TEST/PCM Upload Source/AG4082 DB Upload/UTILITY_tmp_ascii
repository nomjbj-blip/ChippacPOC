23614   INTEGER N,I,St(1:2)
23615   REAL Twait(1:2)
23616   N=NPAR
23617   Vlimit=20                                ! VLIM DEFAULT
23618   Vsubs1=0                                 ! VSUBS DEFAULT
23619   IF N>2 THEN 
23620     IF Vlim<>0 THEN Vlimit=ABS(Vlim)
23621     IF N=4 THEN Vsubs1=Vsubs
23622   END IF
23623   Iforce=ABS(Ids1)
23624   FOR I=1 TO 2
23625     Twait(I)=.01                           ! WAIT TIME SELECTION
23626     IF Iforce<=2.E-5 THEN 
23627       Twait(I)=.1
23628       IF Iforce<=3.E-8 THEN 
23629         Twait(I)=1
23630         IF Iforce<=5.E-9 THEN Twait(I)=2
23631       END IF                               ! IF Iforce<=3E-8
23632     END IF                                 ! IF Iforce<=2E-5
23633     Iforce=ABS(Ids2)
23634   NEXT I
23635   Connect(Port(2),Pcollector,Pbase)
23636   Connect(Port(7),Pemitter)
23637   IF Psubs THEN 
23638     Connect(Port(3),Psubs)
23639     Force_v(Psubs,Vsubs1,Vsubs1,1.E-3)
23640   END IF
23641   Force_i(Pcollector,Ids1,0,Vlimit)        ! SET Ids1
23642   Wait_th(Twait(1))
23643   Measure_v(Pcollector,Vgs1,0)             ! MEASURE Vgs1
23644   Port_status(Pcollector,St(1))            ! STATUS CHECK
23645   Force_i(Pcollector,Ids2,0,Vlimit)        ! SET Ids2
23646   Wait_th(Twait(2))
23647   Measure_v(Pcollector,Vgs2,0)             ! MEASURE Vgs2
