23520 DEF FNHfe(REAL Vce,Ic)
23521   OPTION BASE 1
23522   COM /þtrpins/ INTEGER Port(1:11),Pemitter,Pbase,Pcollector,Psubs
23523   INTEGER End_fl,St
23524   End_fl=0
23525   Ibsgn=SGN(Vce)                           ! SIGN OF VCE
23526   Ilim=1.E-1
23527   IF ABS(Vce)>20 THEN 
23528     Ilim=5.E-2
23529     IF ABS(Vce)>40 THEN Ilim=2.E-2
23530   END IF
23531   Ie=ABS(Ic)
23532   IF Ie>9.5E-2 THEN Ie=9.5E-2
23533   Connect(Port(1),Pbase)
23534   Connect(Port(2),Pemitter,Psubs)
23535   Connect(Port(3),Pcollector)
23536   Force_v(Pcollector,Vce,Vce,Ilim)         ! SET VCE
23537   Force_v(Pbase,0,3,2.E-2)                 ! COMMON-BASE
23538   Force_i(Pemitter,-Ibsgn*Ie,0,3)
23539   Measure_i(Pbase,Ib,0)
23540   Measure_i(Pcollector,Imc,0)
23541   Force_v(Pemitter,0,20,1.E-1)
23542   IF ABS(Imc)>=1.E-6 THEN 
23543     Im=Imc
23544     Iforce=Ib*.95                          ! BASE CURRENT INITIAL VALUE
23545     Time_out=10                            ! TIMEOUT LIMIT (sec)
23546     K=.01                                  ! COLLECTOR CURRENT ACCURACY
23547     T=TIMEDATE
23548     REPEAT
23549       Force_i(Pbase,Iforce,0,3)            ! SEARCHING Ib IN Ic=Imeas
23550       Measure_i(Pcollector,Imeas,0)
23551       Port_status(Pcollector,St)           ! STATUS CHECK
23552       D_im=Imeas-Im                        ! DELTA_IMEAS(IFORCE)
23553       D_ib=Iforce-Ib                       ! DELTA_IFORCE
23554       Ib=Iforce
23555       Im=Imeas
23556       IF D_im=0 THEN D_im=1.E-12
23557       Iforce=DROUND(Iforce-(Imeas-Ic)*D_ib/D_im,5)
23558       IF ABS(Iforce)>Ilim THEN Iforce=Ilim*Ibsgn
23559       Tim=TIMEDATE-T                       ! SET FOR TIMEOUT
23560       IF ABS(Imeas-Ic)<ABS(Ic*K) OR ABS(Iforce-Ib)<1.E-12 THEN End_fl=1
23561       IF Tim>Time_out OR (ABS(Ib)=Ilim AND ABS(Iforce)=Ilim) OR Iforce*Ibsgn<0 OR St>0 THEN End_fl=2
23562     UNTIL End_fl>0
23563     IF Ib=0 THEN Ib=1.E-12
23564     Hfe=DROUND(Imeas/Ib,5)                 ! hFE IN (Ic,VCE)
23565   ELSE
23566     End_fl=2                               ! SETTING OPEN
23567   END IF                                   ! IF ABS(Imc)>=1.E-6
23568   IF End_fl=2 THEN Hfe=-9999999.99999      ! OUT OF MEASUREMENT
23569   Disable_port(Pbase,Pcollector,Pemitter)
23570   Connect(0,Pbase,Pemitter,Pcollector,Psubs) ! DISCONNECT
23571   RETURN Hfe
23572 FNEND
