25001 SUB Iccap_vatfrd(File$,Prefix$,INTEGER Status)
25002!***********************************************************************
25003!
25004!  Type : Subprogram
25005!  Name : ICCAP_VATFRD
25006!  Vers : 1
25007!  Desc : Read *.vat and set SYSTEM Tag variables.
25008!  Date : 06/01/1998
25009!  Time : 09:00:00
25010!  User : specs
25011!
25012!***********************************************************************
25013!
25014!  #  Dir   Name            Type Size     Description
25015! --- ----- --------------- ---- -------- ------------------------------
25016!   1 IN    File$           S    -        *.vat file name
25017!   2 IN    Prefix$         S    -        Tag prefix
25018!   3 OUT   Status          I    -        Status: 0 ok, -1 error
25019!
25020!***********************************************************************
25021!
25022   COM /Iccap/ Path$[256],Vat$(0:256,1:2)[256],INTEGER Vatn
25023   DIM S$[256],N$[256],V$[256],Tagnam$[256]
25024   REAL Value
25025   INTEGER Tagtyp,Tagdim,Tagsz1,Tagsz2
25026   INTEGER Nsystag,I,J
25027!
25028   ON ERROR GOTO E                    ! open *.vat
25029   IF File$[1;1]="/" THEN 
25030     ASSIGN @F TO File$;FORMAT ON
25031   ELSE
25032     ASSIGN @F TO Path$&"/"&File$;FORMAT ON
25033   END IF
25034!
25035   FOR I=1 TO 3                         ! read header part and throw it away
25036     ENTER @F;S$
25037   NEXT I
25038!                                       ! read body and keep it in array
25039   Vatn=0
25040   LOOP
25041     FOR I=1 TO 2                       ! name and value
25042       ENTER @F;S$
25043       S$=S$[POS(S$,"""")]
25044       N$=S$[2,POS(S$," ")-2]           ! 1st col
25045       V$=S$[POS(S$," ")+2,LEN(S$)-1]   ! 2nd col
25046       Vat$(Vatn,I)=V$                  ! keep "name" and "value" in a pair
25047     NEXT I
25048     EXIT IF LEN(Vat$(Vatn,1))=0 AND LEN(Vat$(Vatn,2))=0
25049     Vatn=Vatn+1
25050   END LOOP
25051   Vatn=Vatn-1
25052   ASSIGN @F TO *
25053!
25054   Tpltagcount("SYSTEM",Nsystag)        ! update SYSTEM tags
25055   FOR I=0 TO Vatn                      ! for each var in *.vat
25056     N$=Prefix$&"_"&Vat$(I,1)           ! determine SPECS SYSTEM tag variable name
25057     IF LEN(Vat$(I,2)) THEN             ! only when value is set
25058       FOR J=0 TO Nsystag-1             ! for each var in SYSTEM Tag
25059         Tpltaginfo("SYSTEM",J,Tagnam$,Tagtyp,Tagdim,Tagsz1,Tagsz2)
25060         IF N$=Tagnam$ THEN             ! name match ?
25061           SELECT Tagtyp
25062           CASE 0                       ! REAL Tag
25063             Iccap_vatnrd(Vat$(I,2),Value)
25064             Tplputrtag("SYSTEM",J,0,Value)
25065           END SELECT
25066         END IF
25067       NEXT J
25068     END IF
25069   NEXT I
25070!
25071   Status=0                             ! normal completion
25072   SUBEXIT
25073 E:OFF ERROR 
25074   Status=-1
25075 SUBEND
