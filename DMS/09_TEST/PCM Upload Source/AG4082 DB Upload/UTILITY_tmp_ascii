23661 DEF FNVth3(REAL Ids,Vds,OPTIONAL Vglim,Vsubs)
23662   OPTION BASE 1
23663   COM /þtrpins/ INTEGER Port(1:11),Pemitter,Pbase,Pcollector,Psubs
23664   INTEGER N,Sign,End_fl,St
23665   N=NPAR
23666   Vlimit=20                                ! VGLIM DEFAULT
23667   Vsubs1=0                                 ! VSUBS DEFAULT
23668   Time_out=10                              ! TIMEOUT LIMIT (sec)
23669   IF N>2 THEN 
23670     IF Vglim<>0 THEN Vlimit=ABS(Vglim)
23671     IF N=4 THEN Vsubs1=Vsubs
23672   END IF
23673   End_fl=0
23674   Ilim=1.E-1                               ! SELECT I COMPLIANCE
23675   Vstep=1.E-3                              ! GATE VOLTAGE ACCURACY
23676   IF Vlimit>20 THEN 
23677     Ilim=5.0E-2
23678     Vstep=2.E-3
23679     IF Vlimit>40 THEN 
23680       Ilim=2.0E-2
23681       Vstep=5.E-3
23682     END IF
23683   END IF
23684   IF ABS(Ids)>1.E-6 THEN                   ! DRAIN CURRENT ACCURACY
23685     K=.005                                 ! |Ids|>1E-6 : .5%
23686   ELSE
23687     K=.01                                  ! 1E-6>=|Ids|>1E-8 : 1%
23688     IF ABS(Ids)<=1.E-8 THEN K=.05          ! |Ids|<=1E-8 : 5%
23689   END IF
23690   Sign=1
23691   IF Vds<>0 THEN Sign=SGN(Vds)             ! SIGN OF VDS
23692   Connect(Port(2),Pcollector)
23693   Connect(Port(4),Pbase)
23694   Connect(Port(7),Pemitter)
23695   IF Psubs THEN 
23696     Connect(Port(3),Psubs)
23697     Force_v(Psubs,Vsubs1,Vsubs1,1.E-3)
23698   END IF
23699   Force_v(Pcollector,Vds,Vds,Ilim)         ! DRAIN-SOURCE VOLTAGE
23700   Force_v(Pbase,0,Vlimit,1.0E-5)           ! MEASURE Ids IN Vgs=0 V
23701   Measure_i(Pcollector,Im)
23702   Port_status(Pcollector,St)
23703   IF ABS(Im)<=ABS(Ids) THEN                ! ENHANCEMENT TYPE
23704     V=Sign*MIN(Vlimit,ABS(Vds))
23705     Vlimit=Sign*Vlimit
23706     Force_v(Pbase,V,Vlimit,1.0E-5)
23707     Measure_i(Pcollector,Im)
23708     Port_status(Pcollector,St)
23709     Vgs=V*.9                               ! Vgs INITIAL VALUE
23710   ELSE                                     ! DEPLETION TYPE
23711     V=0
23712     Vlimit=-Sign*Vlimit
23713     Vgs=-Sign*.02
23714   END IF
23715   IF St=0 AND ABS(Im)>ABS(Ids) THEN 
23716     T=TIMEDATE
23717     REPEAT
23718       Force_v(Pbase,Vgs,Vlimit,1.0E-5)     ! SEARCHING Vgs IN Ids=Imeas
23719       Measure_i(Pcollector,Imeas,0)
23720       Port_status(Pcollector,St)           ! STATUS CHECK
23721       D_i=Imeas-Im                         ! DELTA_IMEAS(VGS)
23722       D_v=Vgs-V                            ! DELTA_VGS
23723       V=Vgs
23724       IF D_i=0 THEN D_i=1.E-12
23725       Vgs=Vstep*PROUND((Vgs-(Imeas-Ids)*D_v/D_i)/Vstep,0)! NEXT VGS VALUE
23726       IF ABS(Vgs)>ABS(Vlimit) THEN Vgs=Vlimit
23727       Im=Imeas
23728       Tim=TIMEDATE-T                       ! SET FOR TIMEOUT
23729       IF ABS(Imeas-Ids)<=ABS(Ids*K) OR ABS(Vgs-V)<Vstep THEN End_fl=1
23730       IF Tim>Time_out OR Vgs=Vlimit OR St>0 THEN End_fl=2
23731     UNTIL End_fl>0
23732     Vth=V
23733   ELSE
23734     End_fl=2
23735   END IF                                   ! IF St=0 AND ABS(Im)>ABS(Ids)
23736   IF End_fl=2 THEN Vth=-9999999.99999      ! OUT OF MEASUREMENT
23737   Disable_port(Pcollector,Psubs,Pbase)
23738   Connect(0,Pcollector,Pbase,Pemitter,Psubs) ! DISCONNECT
23739   RETURN Vth
23740 FNEND
