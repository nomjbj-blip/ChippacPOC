18618 !      1 Filename        S    -
18619 !      2 Type            S    -
18620 !
18621 !  Output Variables:
18622 !
18623 !     #  Name            Type Size     Description
18624 !    --- --------------- ---- -------- --------------------------------
18625 !    Output Parameters:
18626 !      1 Exist           I    -
18627 !      2 Readable        I    -
18628 !      3 Writable        I    -
18629 !      4 Executable      I    -
18630 !
18631 !***** DON'T REMOVE THIS LINE *************************************
18632         OPTION BASE 1   !***** DON'T REMOVE THIS LINE *****
18633         DIM Dumfile$[32]
18634         DIM Mode$[11],Usr_own$[256],Grp_own$[256],Usr_file$[256],Grp_file$[256]
18635 !
18636 ! Check mode of target file
18637 !
18638         Exist=0
18639         Readable=0
18640         Writable=0
18641         Executable=0
18642         ON ERROR GOTO Err
18643         ASSIGN @Pipe TO "ls -l -d "&Filename$&" 2>/dev/null | cut -c -10 |"
18644         ON END @Pipe GOTO Nomode
18645         ENTER @Pipe;Mode$
18646         GOTO Check_file
18647 Nomode:  !
18648         OFF END @Pipe
18649         OFF ERROR 
18650         PRINT "VERIFY_FILE ERROR: "&Filename$&" is not accessible."
18651         SUBEXIT
18652 !
18653 Check_file:  !
18654         OFF END @Pipe
18655         OFF ERROR 
18656 !
18657         SELECT Type$
18658         CASE "Normal"
18659            IF Mode$[1,1]<>"-" AND Mode$[1,1]<>"l" THEN SUBEXIT
18660         CASE "Directory"
18661            IF Mode$[1,1]<>"d" THEN SUBEXIT
18662         CASE "Special"
18663            IF Mode$[1,1]="-" OR Mode$[1,1]="l" OR Mode$[1,1]="d" THEN SUBEXIT
18664         END SELECT
18665 !
18666         Exist=1
18667 !
18668 ! Check user/group of target file
18669 !
18670         IF Type$="Directory" THEN 
18671            ASSIGN @Pipe TO "ls -l -d "&Filename$&"| awk '{print $3}'|"
18672            ENTER @Pipe;Usr_file$
18673            ASSIGN @Pipe TO "ls -l -d "&Filename$&"| awk '{print $4}'|"
18674            ENTER @Pipe;Grp_file$
18675         ELSE
18676            ASSIGN @Pipe TO "ls -l "&Filename$&"| awk '{print $3}'|"
18677            ENTER @Pipe;Usr_file$
18678            ASSIGN @Pipe TO "ls -l "&Filename$&"| awk '{print $4}'|"
18679            ENTER @Pipe;Grp_file$
18680         END IF
18681         OFF ERROR 
18682 !
18683 ! Check user/group of myself
18684 !
18685         Dumfile$="/var/tmp/VERIFY"&SYSTEM$("PROCESS ID")  ! AVPATH_
18686         ON ERROR GOTO Ignore
18687         PURGE Dumfile$
18688 Ignore:                                 !
18689         ON ERROR GOTO Err
18690         CREATE Dumfile$,1
18691         ASSIGN @Pipe TO "ls -l "&Dumfile$&"| awk '{print $3}'|"
18692         ENTER @Pipe;Usr_own$
18693         ASSIGN @Pipe TO "ls -l "&Dumfile$&"| awk '{print $4}'|"
18694         ENTER @Pipe;Grp_own$
18695         PURGE Dumfile$
18696         OFF ERROR 
18697 !
18698         IF Usr_own$=Usr_file$ THEN 
18699            IF Mode$[2,2]="r" THEN Readable=1
18700            IF Mode$[3,3]="w" THEN Writable=1
18701            IF Mode$[4,4]="x" OR Mode$[4,4]="s" THEN Executable=1
18702         ELSE
18703            IF Grp_own$=Grp_file$ THEN 
18704               IF Mode$[5,5]="r" THEN Readable=1
18705               IF Mode$[6,6]="w" THEN Writable=1
18706               IF Mode$[7,7]="x" OR Mode$[7,7]="s" THEN Executable=1
18707            ELSE
18708               IF Mode$[8,8]="r" THEN Readable=1
18709               IF Mode$[9,9]="w" THEN Writable=1
18710               IF Mode$[10,10]="x" OR Mode$[10,10]="t" THEN Executable=1
18711            END IF
18712         END IF
18713         SUBEXIT
18714 Err:  !
18715         PRINT "VERIFY_FILE ERROR: "&ERRM$
18716         OFF END @Pipe
18717         OFF ERROR 
18718      SUBEND
