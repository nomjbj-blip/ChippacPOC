24041 Fnr4d:DEF FNR4d(INTEGER Vpin1,Ipin1,Vpin2,Ipin2,REAL Itest,OPTIONAL Vlim)
24042   INTEGER Pstatus
24043   REAL Vlimit,Vdiff1,Vdiff2,I2,Resistance
24044   !
24045   IF ABS(Itest)<1.E-6 THEN                 ! Itest VALUE TOO SMALL
24046     Resistance=-9999999.99999
24047     GOTO Function_end
24048   END IF
24049   IF NPAR=5 THEN 
24050     Vlimit=20                              ! DEFAULT COMPLIANCE 20V
24051   ELSE
24052     Vlimit=Vlim                            ! SETS COMPLIANCE
24053   END IF
24054   !
24055   Disable_port(FNSmu(1),FNSmu(3))
24056   !
24057   Connect(FNPort(1,5),Vpin1)               ! CONNECTS HIGH V PIN
24058   Connect(FNPort(1,6),Vpin2)               ! CONNECTS LOW  V PIN
24059   Connect(FNSmu(3),Ipin2)                  ! CONNECTS LOW  I PIN
24060   Force_v(Ipin2,0.,2.0,1.E-1)              ! 0V OUT, 2V RANGE, MAX 0.1A
24061   Measure_v3458(Vdiff1)                    ! AUTO RANGE
24062   Port_status(FNPort(1,5),Pstatus)         ! Note: Always 0.
24063   IF Pstatus THEN 
24064     Resistance=-9999999.99999
24065     GOTO Abort_function
24066   END IF
24067   !
24068   Connect(FNSmu(1),Ipin1)                  ! CONNECTS HIGH I PIN
24069   Force_i(Ipin1,Itest,0.,Vlimit)           ! FORCES CURRENT
24070   Measure_v3458(Vdiff2)                    ! AUTO RANGE
24071   Measure_i(FNSmu(3),I2,0.)                ! AUTO RANGE, MAX 0.1A
24072   Port_status(FNPort(1,5),Pstatus)         ! Note: Always 0.
24073   IF Pstatus OR (I2=0.) THEN               ! ABNORMAL CONDITIONS
24074     Resistance=-9999999.99999
24075     GOTO Abort_function
24076   END IF
24077   Resistance=DROUND(-(Vdiff2-Vdiff1)/I2,6) ! CALCULATES RESISTANCE
24078 Abort_function:!
24079   Disable_port(FNSmu(1),FNSmu(3))
24080   Connect(0,Vpin1,Vpin2,Ipin1,Ipin2)       ! DISCONNECT
24081 Function_end:!
24082   RETURN Resistance
24083 FNEND
