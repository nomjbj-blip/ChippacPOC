<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
  </configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <publisherPolicy apply="no" />
        <assemblyIdentity name="Oracle.ManagedDataAccess" publicKeyToken="89b483f429c47342" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0 - 65535.65535.65535.65535" newVersion="4.122.19.1" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <oracle.manageddataaccess.client>
    <version number="*">
      <settings>
        <!--<setting name="TNS_ADMIN" value="C:\ORACLE\product\11.2.0\dbhome_1\NETWORK\ADMIN" />-->
        <!--Oracle Client 설치되어 있지 않은 경우 아래처럼 추가 가능<dataSources>
          <dataSource alias="SampleDataSource" descriptor="(DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL))) " />
        </dataSources>-->
      </settings>
    </version>
  </oracle.manageddataaccess.client>
  <system.runtime.remoting>
    <application>
      <channels>
        <channel ref="tcp" port="7515">
          <serverProviders>
            <formatter ref="binary" />
          </serverProviders>
        </channel>
      </channels>
      <service>
        <wellknown mode="SingleCall" type="DACrux.SEMDMS.BSL.SEMConfiguration, DACrux.SEMDMS.BSL" objectUri="DACrux.SEMDMS.BSL.SEMConfiguration.bin" />
        <wellknown mode="SingleCall" type="DACrux.SEMDMS.BSL.DefectMapAnalysis, DACrux.SEMDMS.BSL" objectUri="DACrux.SEMDMS.BSL.DefectMapAnalysis.bin" />
        <wellknown mode="SingleCall" type="DACrux.SEMDMS.BSL.DefectDefine, DACrux.SEMDMS.BSL" objectUri="DACrux.SEMDMS.BSL.DefectDefine.bin" />
        <wellknown mode="SingleCall" type="DACrux.SEMDMS.BSL.DMReport, DACrux.SEMDMS.BSL" objectUri="DACrux.SEMDMS.BSL.DMReport.bin" />
        <wellknown mode="SingleCall" type="DACrux.SEMDMS.BSL.DefectAlarm, DACrux.SEMDMS.BSL" objectUri="DACrux.SEMDMS.BSL.DefectAlarm.bin" />
      </service>
    </application>
    <customErrors mode="Off" />
  </system.runtime.remoting>
  <appSettings>
    <add key="MIRACOM_DACRUX_DMS" value="DACrux.SEMDMS.Service.exe.config"></add>
    <add key="DMS_CONNECT_ID" value="DMSMGR"></add>
    <add key="TEST_CONNECT_ID" value="DMSMGR"></add>
    <add key="QMS_CONNECT_ID" value="DMSMGR"></add>
  </appSettings>
</configuration>