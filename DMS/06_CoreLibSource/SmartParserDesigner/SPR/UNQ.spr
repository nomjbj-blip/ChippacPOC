<ANALYSIS PatternMode="Multi" TargetFileNamingRule="" Encoding="ASCII" CharCount="1" BOTTOM="" TOP="" LEFT="" RIGHT="">
     <REGEX_ENTITY Name="bin" Parent="" Default="" Force="False" Label="" RegexString="(?&lt;value&gt;[\w.]{20,})" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" RowNum="" />
     <REGEX_ENTITY Name="Wafer_ID" Parent="" Default=" " Force="False" Label="" RegexString="" RegexOption="Multiline" RegexValueGroupName="" RegexValueSeperator="" ValueType="" StreamMode="Stream" RowNum="" strKey="" />
