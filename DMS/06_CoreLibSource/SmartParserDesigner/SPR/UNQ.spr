     <REGEX_ENTITY Name="Product" Parent="" Default="" Force="False" Label="" RegexString="Device\s*=\s*(?&lt;value&gt;[\w]*)" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" RowNum="" strKey="" />
     <REGEX_ENTITY Name="FlatZone" Parent="" Default="" Force="False" Label="" RegexString="FLAT:(?&lt;value&gt;[\d]*)" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" RowNum="" strKey="" />
     <REGEX_ENTITY Name="Run_ID" Parent="" Default="" Force="False" Label="" RegexString="Wafer\s*ID\s*=\s*(?&lt;value&gt;[\w\d\.]*)" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" RowNum="" strKey="" />
     <REGEX_ENTITY Name="Except" Parent="" Default="." Force="False" Label="" RegexString="" RegexOption="Multiline, ExplicitCapture" RegexValueGroupName="" RegexValueSeperator="" ValueType="" StreamMode="Stream" />
