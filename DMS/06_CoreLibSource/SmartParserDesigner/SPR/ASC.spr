     <REGEX_ENTITY Name="bin" Parent="" Default="" Force="False" Label="" RegexString="(?&lt;value&gt;^[\.0-9a-zA-Z][.1Xx]{4,})" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" STP_X="0" STP_Y="0" />
