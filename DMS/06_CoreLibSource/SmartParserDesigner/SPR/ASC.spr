     <REGEX_ENTITY Name="Product" Parent="" Default="" Force="False" Label="" RegexString="(?&lt;value&gt;[\w\d]*)(\n[\w\d\.]*\-[\d]{2}|\n[\w\d\.]*\n[\d]{2})\nN(.)*\:" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" STP_X="0" STP_Y="0" />
     <REGEX_ENTITY Name="FlatZone" Parent="" Default="" Force="False" Label="" RegexString="N(.)*\:\s*(?&lt;value&gt;[\w]*)" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" STP_X="0" STP_Y="0" />
     <REGEX_ENTITY Name="Run_ID" Parent="" Default="" Force="False" Label="" RegexString="(?&lt;value&gt;[\w\d\.]*)(\n[\d]{2}\n|\-[\d]{2}\n)N(.)*\:" RegexOption="Multiline" RegexValueGroupName="value" RegexValueSeperator="" ValueType="" StreamMode="Stream" STP_X="0" STP_Y="0" />
     <REGEX_ENTITY Name="Except" Parent="" Default="." Force="False" Label="" RegexString="" RegexOption="Multiline, ExplicitCapture" RegexValueGroupName="" RegexValueSeperator="" ValueType="" StreamMode="Stream" STP_X="0" STP_Y="0" />
