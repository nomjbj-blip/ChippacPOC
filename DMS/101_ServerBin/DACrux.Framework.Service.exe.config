<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
  </configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <publisherPolicy apply="no" />
        <assemblyIdentity name="Oracle.ManagedDataAccess" publicKeyToken="89b483f429c47342" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0 - 65535.65535.65535.65535" newVersion="4.122.19.1" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <oracle.manageddataaccess.client>
    <version number="*">
      <settings>
        <!--<setting name="TNS_ADMIN" value="C:\ORACLE\product\11.2.0\dbhome_1\NETWORK\ADMIN" />-->
        <!--Oracle Client 설치되어 있지 않은 경우 아래처럼 추가 가능<dataSources>
          <dataSource alias="SampleDataSource" descriptor="(DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL))) " />
        </dataSources>-->
      </settings>
    </version>
  </oracle.manageddataaccess.client>
	<system.runtime.remoting>
		<application>
			<channels>
				<channel ref="tcp" port="7510">
					<serverProviders>
						<formatter ref="binary"/>
					</serverProviders>
				</channel>
			</channels>
			<service>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.Common, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.Common.bin"/>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.UserEnvironment, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.UserEnvironment.bin"/>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.UserGroup, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.UserGroup.bin"/>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.UserHitLog, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.UserHitLog.bin"/>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.UserManagement, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.UserManagement.bin"/>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.UserMonitor, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.UserMonitor.bin"/>
				<wellknown mode="SingleCall" type="DACrux.Framework.BSL.FunctionManagement, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.FunctionManagement.bin"/>
        <wellknown mode="SingleCall" type="DACrux.Framework.BSL.UserControl, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.UserControl.bin"/>
        <wellknown mode="SingleCall" type="DACrux.Framework.BSL.Config, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.Config.bin"/>
        <wellknown mode="SingleCall" type="DACrux.Framework.BSL.ServiceLog, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.ServiceLog.bin"/>
        <wellknown mode="SingleCall" type="DACrux.Framework.BSL.NoticeManagement, DACrux.Framework.BSL" objectUri="DACrux.Framework.BSL.NoticeManagement.bin"/>
        <wellknown mode="SingleCall" type="DACrux.Common.BSL.ComConfiguration, DACrux.Common.BSL" objectUri="DACrux.Common.BSL.ComConfiguration.bin"/>
        <wellknown mode="SingleCall" type="DACrux.Common.BSL.EquipManagement, DACrux.Common.BSL" objectUri="DACrux.Common.BSL.EquipManagement.bin"/>
      </service>
		</application>
		<customErrors mode="Off"/>
	</system.runtime.remoting>
	<appSettings>
    <add key="MIRACOM_QMS_COMMON" value="DACrux.Framework.Service.exe.config"></add>
    <add key="QMS_CONNECT_ID" value="DMSMGR"></add>
    <add key="MES_CONNECT_ID" value="BUMPMES"></add>
  </appSettings>
</configuration>
