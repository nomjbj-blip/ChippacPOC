        //--

        public int SetMapInfo(
            DwResultValue rv,
            DataTable dt
            )
        {
            StringBuilder sQuery = new StringBuilder();
            int iBindCnt = -1;
            Dictionary<string, DataTableParameters> dicParams = null;

            sQuery.AppendLine("INSERT INTO TQD_SCAN_SAMPLE(")
                  .AppendLine(" STEP_SEQ,")
                  .AppendLine(" TEST,")
                  .AppendLine(" INDEX_X,")
                  .AppendLine(" INDEX_Y ")
                  .AppendLine(" ) VALUES (")
                  .AppendLine(" :STEP_SEQ,")
                  .AppendLine(" :TEST,")
                  .AppendLine(" :INDEX_X,")
                  .AppendLine(" :INDEX_Y ")
                  .AppendLine(" )");

            dicParams = new Dictionary<string, DataTableParameters>();
            #region [ Setting Parameter ]
            foreach (DataRow row in dt.Rows)
            {
                foreach (DataColumn col in dt.Columns)
                {
                    DataTableParameters dtParams = new DataTableParameters();
                    if (dicParams.ContainsKey(col.ColumnName))
                    {
                        dtParams = dicParams[col.ColumnName];

                        if (string.Equals(col.ColumnName, "STEP_SEQ"))
                            dtParams.Values.Add(rv.StepSeq);
                        else
                            dtParams.Values.Add(row[col]);

                        dicParams[col.ColumnName] = dtParams;
                    }
                    else
                    {
                        if (dtParams.Values == null)
                            dtParams.Values = new ArrayList();

                        if (string.Equals(col.ColumnName, "STEP_SEQ"))
                            dtParams.Values.Add(rv.StepSeq);
                        else
                            dtParams.Values.Add(row[col]);

                        dtParams.DataTableColumnType = base.GetDbTypeByName(col.DataType);
                        dicParams.Add(col.ColumnName, dtParams);
                    }
                    iBindCnt = dtParams.Values.Count;
                }
            }
            #endregion [ Setting Parameter ]

            return ExecuteNonQuery(
                oConnection,
                sQuery.ToString(),
                iBindCnt,
                dicParams
                );
        }
        #endregion [ TQD_SCAN_SAMPLE ]

