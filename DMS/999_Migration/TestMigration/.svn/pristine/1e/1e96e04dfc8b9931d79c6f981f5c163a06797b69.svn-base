        public int SetProduct(
            ref DwResultValue rv,
            DataRow dr
            )
        {
            StringBuilder sQuery = new StringBuilder();
            Dictionary<string, Parameter> dicParams = null;

            //--
            /// Sql Query
            //--
            sQuery.AppendLine("INSERT INTO TQD_PRODUCT(PRODUCT, FACILITY, TECHNOLOGY, NETDIE, WAFER_SIZE, ANGLE, NOTCH_TYPE, DIE_PITCH_X, DIE_PITCH_Y, DIE_ORIGIN_X, DIE_ORIGIN_Y, ORIGIN_X, ORIGIN_Y, \"COMMENT\") ");
            sQuery.AppendLine(" VALUES(:product, :facility, :technology, :netdie, :wafer_size, :angle, :notch_type, :die_pitch_x, :die_pitch_y, :die_origin_x, :die_origin_y, :origin_x, :origin_y, :cmt) ");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.Device;
            dicParams.Add("product", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["FACILITY"];
            dicParams.Add("facility", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["TECHNOLOGY"];
            dicParams.Add("technology", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["NETDIE"];
            dicParams.Add("netdie", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["WAFER_SIZE"];
            dicParams.Add("wafer_size", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["ANGLE"];
            dicParams.Add("angle", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["NOTCH_TYPE"];
            dicParams.Add("notch_type", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_PITCH_X"];
            dicParams.Add("die_pitch_x", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_PITCH_Y"];
            dicParams.Add("die_pitch_y", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_ORIGIN_X"];
            dicParams.Add("die_origin_x", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_ORIGIN_Y"];
            dicParams.Add("die_origin_y", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["ORIGIN_X"];
            dicParams.Add("origin_x", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["ORIGIN_Y"];
            dicParams.Add("origin_y", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = "@COMMENT@";
            dicParams.Add("cmt", p);
            #endregion [ Setting Parameter ]

            return ExecuteNonQuery(
                oConnection,
                Constract.FUNCATION_NAME_PRODUCT,
                sQuery.ToString(),
                dicParams
                );
        }
        #endregion [ TQD_PRODUCT ]

