namespace FabTwoToMigrationTools.Target
{
    public class MiracomDMS : BaseInfo, IDisposable
    {
        private readonly string UserID = "DMSMGR";
        private readonly string Password = "DMSMGR";
        private readonly string DataSource = "DMSDEV";
        private OracleConnection oConnection = null;

        public OracleConnection Connection { get { return oConnection; } set { oConnection = value; } }
        public OracleTransaction Transaction { get; set; }

        public MiracomDMS(
            )
        {
            base.UserID = this.UserID;
            base.Password = this.Password;
            base.DataSource = this.DataSource;
            oConnection = base.DbOpen();
        }

        //-----------------------------------------------------------------------------------------------------

        public MiracomDMS(
            string userid,
            string password,
            string connectionname
            )
        {
            base.UserID = userid;
            base.Password = password;
            base.DataSource = connectionname;
            oConnection = base.DbOpen();
        }

        //-----------------------------------------------------------------------------------------------------

        #region [ TQD_LOT ]
        public int CheckedLot(
            ref DwLotInfo lotinfo
            )
        {
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            //--
            /// Sql Query
            //--
            sQuery.AppendLine("SELECT LOT_SEQ, PRODUCT FROM TQD_LOT ");
            sQuery.AppendLine(" WHERE 1=1");
            sQuery.AppendLine("       AND PRODUCT = :product");
            sQuery.AppendLine("       AND LOT_ID = :lotid");

            //--

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = lotinfo.Device; ;
            dicParams.Add("product", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = lotinfo.LotID;
            dicParams.Add("lotid", p);
            #endregion [ Setting Parameter ]

            //--

            DataTable checkedDt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_LOT,
                sQuery.ToString(),
                dicParams
                );

            if (checkedDt != null && checkedDt.Rows.Count > 0)
            {
                lotinfo.Device = checkedDt.Rows[0]["PRODUCT"].ToString();
                lotinfo.LotSeq = long.Parse(checkedDt.Rows[0]["LOT_SEQ"].ToString());
            }
            else
            {
                lotinfo.LotSeq = -1;
            }
            return checkedDt.Rows.Count;
        }

        //--

        public int SetLot(
            ref DwLotInfo lotinfo
            )
        {
            int iResult = -1;
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            sQuery.AppendLine("INSERT INTO TQD_LOT(LOT_SEQ, LOT_ID, PRODUCT, \"COMMENT\") ");
            sQuery.AppendLine(" VALUES (LOT_SEQ.NEXTVAL, :LOT_ID, :PRODUCT, :CMT)");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Settring Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = lotinfo.LotID;
            dicParams.Add("LOT_ID", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = lotinfo.Device;
            dicParams.Add("PRODUCT", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = "@COMMENT@";
            dicParams.Add("CMT", p);
            #endregion [ Setting Parameter ]

            iResult = ExecuteNonQuery(
                oConnection,
                Constract.FUNCATION_NAME_LOT,
                sQuery.ToString(),
                dicParams
                );

            CheckedLot(ref lotinfo);

            return iResult;
        }
        #endregion [ TQD_LOT ]

        //-----------------------------------------------------------------------------------------------------

        #region [ TQD_WAFER ]
        public int CheckedWafer(
            ref DwResultValue rv,
            int iSLotId
            )
        {
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            //--
            /// Sql Query
            //--
            sQuery.AppendLine("SELECT WAFER_SEQ FROM TQD_WAFER ");
            sQuery.AppendLine(" WHERE 1=1");
            sQuery.AppendLine("       AND LOT_SEQ = :lotseq");
            sQuery.AppendLine("       AND WAFER_ID = :waferid");
            sQuery.AppendLine("       AND SLOT_ID = :slotid");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.LotSeq;
            dicParams.Add("lotseq", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.WaferID;
            dicParams.Add("waferid", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = iSLotId;
            dicParams.Add("slotid", p);
            #endregion [ Setting Parameter ]

            DataTable checkedDt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_WAFER,
                sQuery.ToString(),
                dicParams
                );

            if (checkedDt != null && checkedDt.Rows.Count > 0)
                rv.WaferSeq = long.Parse(checkedDt.Rows[0]["WAFER_SEQ"].ToString());
            else rv.WaferSeq = -1;

            return checkedDt.Rows.Count;
        }

        //--

        public int SetWafer(
            ref DwResultValue rv,
            int iSLotId
            )
        {
            int iResult = -1;
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();
            sQuery.AppendLine("INSERT INTO TQD_WAFER(WAFER_SEQ, LOT_SEQ, WAFER_ID, SLOT_ID, \"COMMENT\") ");
            sQuery.AppendLine("VALUES (WAFER_SEQ.NEXTVAL, :lotseq, :waferid, :slotid, :cmt)");

            dicParams = new Dictionary<string, Parameter>();
            Parameter p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.LotSeq;
            dicParams.Add("lotseq", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.WaferID;
            dicParams.Add("waferid", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = iSLotId;
            dicParams.Add("slotid", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = "@COMMENT@";
            dicParams.Add("cmt", p);

            iResult = ExecuteNonQuery(
                oConnection,
                Constract.FUNCATION_NAME_WAFER,
                sQuery.ToString(),
                dicParams
                );

            CheckedWafer(ref rv, iSLotId);

            return iResult;
        }
        #endregion [ TQD_WAFER ]

