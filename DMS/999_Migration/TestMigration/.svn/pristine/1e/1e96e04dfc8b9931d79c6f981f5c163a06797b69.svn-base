            //--
            sQuery.AppendLine("INSERT INTO TQD_STEP(STEP_SEQ, TEST, WAFER_SEQ, STEP_ID, SLOT_ID, RESULT_ID, INSPECTION_EQ, REVIEW_EQ, SETUP_SEQ, RESULTTIMESTAMP, FILETIMESTAMP, ");
            sQuery.AppendLine("MAIN_EQ, ROUTE, OPER, SCAN_AREA, DEFECTIVE_DIE, DEFECTS, IMAGES, DEFECT_DD, INSP_FILENAME, SERVICE_FILENAME, \"COMMENT\" ) ");
            sQuery.AppendLine(" VALUES ( STEP_SEQ.NEXTVAL, :TEST, :WAFER_SEQ, :STEP_ID, :SLOT_ID, :RESULT_ID, :INSPECTION_EQ, :REVIEW_EQ, :SETUP_SEQ, ");
            sQuery.AppendLine(" TO_DATE(:RESULTTIMESTAMP, 'YYYYMMDDHH24MISS'), TO_DATE(:FILETIMESTAMP, 'YYYYMMDDHH24MISS'),");
            sQuery.AppendLine(" :MAIN_EQ, :ROUTE, :OPER, :SCAN_AREA, :DEFECTIVE_DIE, :DEFECTS, :IMAGES, :DEFECT_DD, :INSP_FILENAME, :SERVICE_FILENAME, :CMT ) ");

