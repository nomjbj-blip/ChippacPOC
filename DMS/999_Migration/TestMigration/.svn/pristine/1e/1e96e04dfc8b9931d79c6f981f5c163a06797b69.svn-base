        #region [ TQD_STEP ]
        public int CheckedStep(
            ref DwResultValue rv
            )
        {
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            //--
            /// Sql Query
            //--9
            sQuery.AppendLine("SELECT * FROM TQD_STEP ");
            sQuery.AppendLine(" WHERE 1=1 ");
            sQuery.AppendLine("       AND STEP_ID = :STEPID ");
            sQuery.AppendLine("       AND WAFER_SEQ = :WAFERSEQ ");
            sQuery.AppendLine("       AND SETUP_SEQ = :SETUPSEQ ");
            sQuery.AppendLine("       AND RESULTTIMESTAMP = TO_DATE(:INSPDATETIME, 'YYYYMMDDHH24MISS') ");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameters ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.StepID;
            dicParams.Add("STEPID", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            //p.Value = lWaferSeq;
            p.Value = rv.WaferSeq;
            dicParams.Add("WAFERSEQ", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            //p.Value = lSetupSeq;
            p.Value = rv.SetupSeq;
            dicParams.Add("SETUPSEQ", p);

            p = new Parameter();
            p.Type = DbType.String;
            //p.Value = lSetupSeq;
            p.Value = rv.InspDateTime;
            dicParams.Add("INSPDATETIME", p);
            #endregion [ Setting Parameters ]

            DataTable checkedDt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_STEP,
                sQuery.ToString(),
                dicParams
                );

            if (checkedDt != null && checkedDt.Rows.Count > 0)
                rv.StepSeq = long.Parse(checkedDt.Rows[0]["STEP_SEQ"].ToString());
            else rv.StepSeq = -1;

            return checkedDt.Rows.Count;
        }

