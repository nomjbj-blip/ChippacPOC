        #region [ TQD_INSP_INFO ]
        public int CheckedInspInfo(
            DwResultValue rv
            )
        {
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            //--
            /// Sql Query
            //--
            sQuery.AppendLine("SELECT STEP_SEQ, WAFER_SEQ, SETUP_SEQ FROM TQD_INSP_INFO ");
            sQuery.AppendLine(" WHERE 1=1");
            sQuery.AppendLine("       AND STEP_SEQ = :STEPSEQ");
            sQuery.AppendLine("       AND WAFER_SEQ = :WAFERSEQ");
            sQuery.AppendLine("       AND SETUP_SEQ = :SETUPSEQ");
            sQuery.AppendLine("       AND RESULTTIMESTAMP = TO_DATE(:INSPDATETIME, 'YYYYMMDDHH24MISS') ");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.StepSeq;
            dicParams.Add("STEPSEQ", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.WaferSeq;
            dicParams.Add("WAFERSEQ", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.SetupSeq;
            dicParams.Add("SETUPSEQ", p);

            p = new Parameter();
            p.Type = DbType.String;
            //p.Value = lSetupSeq;
            p.Value = rv.InspDateTime;
            dicParams.Add("INSPDATETIME", p);
            #endregion [ Setting Parameter ]

            DataTable checkedDt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_INSP_INFO,
                sQuery.ToString(),
                dicParams
                );

            return checkedDt.Rows.Count;
        }

        //--

        public int SetInspInfo(
            DataRow dr,
            DwResultValue rv
            )
        {
            StringBuilder sQuery = new StringBuilder();
            Dictionary<string, Parameter> dicParams = null;

            //--
            /// Sql Query
            //--
            sQuery.AppendLine("INSERT INTO TQD_INSP_INFO(STEP_SEQ, WAFER_SEQ, RESULTTIMESTAMP, FILETIMESTAMP, FACTORY, TECHNOLOGY, PRODUCT, LOT_ID, WAFER_ID, STEP_ID, TEST, SLOT_ID, SETUP_SEQ, STATUS, MAIN_EQ, ROUTE, OPER,");
            sQuery.AppendLine(" INSPECTION_EQ, INSPECTION_PARAM, DEFECTS, CLASSIFIED_DEFECTS, KILLER_DEFECTS, RANDOM_DEFECTS, ADDER_KILLER_DEFECT, ADDER_RANDOM_DEFECT, CLUSTERS, ADDER_CLUSTERS, CLUSTER_AREA, DEFECT_DD, KILLER_DEFECT_DD, ");
            sQuery.AppendLine(" RANDOM_DEFECT_DD, INSPECTED_DIE, DEFECTIVE_DIE, ADDER_DEF_DIE, KILL_DEF_DIE, KILL_ADDER_DEF_DIE, IMAGES, SCAN_AREA, ADDER_DEFECTS, KILL_RND_DEFECTS, \"COMMENT\", RETICLE_ID, INTERLOCK_FLAG, STEPPER_EQ, SUMMARY_FLAG) ");
            sQuery.AppendLine(" VALUES (:STEP_SEQ, :WAFER_SEQ, TO_DATE(:RESULTTIMESTAMP, 'YYYYMMDDHH24MISS'), TO_DATE(:FILETIMESTAMP, 'YYYYMMDDHH24MISS'), :FACTORY, :TECHNOLOGY, :PRODUCT, :LOT_ID, :WAFER_ID, :STEP_ID, :TEST, :SLOT_ID, :SETUP_SEQ, :STATUS, :MAIN_EQ, :ROUTE, :OPER,");
            sQuery.AppendLine(" :INSPECTION_EQ, :INSPECTION_PARAM, :DEFECTS, :CLASSIFIED_DEFECTS, :KILLER_DEFECTS, :RANDOM_DEFECTS, :ADDER_KILLER_DEFECT, :ADDER_RANDOM_DEFECT, :CLUSTERS, :ADDER_CLUSTERS, :CLUSTER_AREA, :DEFECT_DD, :KILLER_DEFECT_DD, ");
            sQuery.AppendLine(" :RANDOM_DEFECT_DD, :INSPECTED_DIE, :DEFECTIVE_DIE, :ADDER_DEF_DIE, :KILL_DEF_DIE, :KILL_ADDER_DEF_DIE, :IMAGES, :SCAN_AREA, :ADDER_DEFECTS, :KILL_RND_DEFECTS, :CMT, :RETICLE_ID, :INTERLOCK_FLAG, :STEPPER_EQ, :SUMMARY_FLAG) ");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.StepSeq;
            dicParams.Add("STEP_SEQ", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.WaferSeq;
            dicParams.Add("WAFER_SEQ", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["RESULTTIMESTAMP"];
            dicParams.Add("RESULTTIMESTAMP", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["FILETIMESTAMP"];
            dicParams.Add("FILETIMESTAMP", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["FACTORY"];
            dicParams.Add("FACTORY", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["TECHNOLOGY"];
            dicParams.Add("TECHNOLOGY", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["PRODUCT"];
            dicParams.Add("PRODUCT", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["LOT_ID"];
            dicParams.Add("LOT_ID", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["WAFER_ID"].ToString().Replace("@", "").Replace("_", "");
            dicParams.Add("WAFER_ID", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["STEP_ID"];
            dicParams.Add("STEP_ID", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["TEST"];
            dicParams.Add("TEST", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["SLOT_ID"];
            dicParams.Add("SLOT_ID", p);

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = rv.SetupSeq;
            dicParams.Add("SETUP_SEQ", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["STATUS"];
            dicParams.Add("STATUS", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["MAIN_EQ"];
            dicParams.Add("MAIN_EQ", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["ROUTE"];
            dicParams.Add("ROUTE", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["OPER"];
            dicParams.Add("OPER", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["INSPECTION_EQ"];
            dicParams.Add("INSPECTION_EQ", p);

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["INSPECTION_PARAM"];
            dicParams.Add("INSPECTION_PARAM", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["DEFECTS"];
            dicParams.Add("DEFECTS", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["CLASSIFIED_DEFECTS"];
            dicParams.Add("CLASSIFIED_DEFECTS", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["KILLER_DEFECTS"];
            dicParams.Add("KILLER_DEFECTS", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["RANDOM_DEFECTS"];
            dicParams.Add("RANDOM_DEFECTS", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["ADDER_KILLER_DEFECTS"];
            dicParams.Add("ADDER_KILLER_DEFECT", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["ADDER_RANDOM_DEFECTS"];
            dicParams.Add("ADDER_RANDOM_DEFECT", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["CLUSTERS"];
            dicParams.Add("CLUSTERS", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["ADDER_CLUSTERS"];
            dicParams.Add("ADDER_CLUSTERS", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["CLUSTER_AREA"];
            dicParams.Add("CLUSTER_AREA", p);

            p = new Parameter();
            p.Type = DbType.Double;
            p.Value = dr["DEFECT_DD"];
            dicParams.Add("DEFECT_DD", p);

            p = new Parameter();
            p.Type = DbType.Double;
            p.Value = dr["KILLER_DEFECT_DD"];
            dicParams.Add("KILLER_DEFECT_DD", p);

            p = new Parameter();
            p.Type = DbType.Double;
            p.Value = dr["RANDOM_DEFECT_DD"];
            dicParams.Add("RANDOM_DEFECT_DD", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["INSPECTED_DIE"];
            dicParams.Add("INSPECTED_DIE", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["DEFECTIVE_DIE"];
            dicParams.Add("DEFECTIVE_DIE", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["ADDER_DEF_DIE"];
            dicParams.Add("ADDER_DEF_DIE", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["KILL_DEF_DIE"];
            dicParams.Add("KILL_DEF_DIE", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["KILL_ADDER_DEF_DIE"];
            dicParams.Add("KILL_ADDER_DEF_DIE", p);

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["IMAGES"];
            dicParams.Add("IMAGES", p);

            p = new Parameter();
