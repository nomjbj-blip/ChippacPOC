        //-----------------------------------------------------------------------------------------------------

        #region [ TQD_SETUP ]
        public int CheckedSetup(
            ref DwResultValue rv,
            DateTime dtSetupTime
            )
        {
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            //--
            /// Sql Query
            //--
            sQuery.AppendLine("SELECT SETUP_SEQ FROM TQD_SETUP ");
            sQuery.AppendLine(" WHERE 1=1");
            sQuery.AppendLine("       AND SETUP_ID = :setupid ");
            sQuery.AppendLine("       AND STEP_ID = :stepid ");
            sQuery.AppendLine("       AND SETUP_TIME = to_date(:setuptime, 'yyyymmddhh24miss')");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.SetupID;
            dicParams.Add("setupid", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.StepID;
            dicParams.Add("stepid", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dtSetupTime.ToString(Constract.DEFAULT_DATETIME_STRING);
            dicParams.Add("setuptime", p);
            #endregion [ Setting Parameter ]

            DataTable checkedDt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_SETUP,
                sQuery.ToString(),
                dicParams
                );

            if (checkedDt != null && checkedDt.Rows.Count > 0)
                rv.SetupSeq = long.Parse(checkedDt.Rows[0]["SETUP_SEQ"].ToString());
            else rv.SetupSeq = -1;

            return checkedDt.Rows.Count;
        }

        //--

        public int SetSetup(
            ref DwResultValue rv,
            DateTime dtSetupTime,
            DataRow dr
            )
        {
            int iResult = -1;
            StringBuilder sQuery = new StringBuilder();
            Dictionary<string, Parameter> dicParams = null;

            sQuery.AppendLine("INSERT INTO TQD_SETUP(")
                  .AppendLine(" SETUP_SEQ,")
                  .AppendLine(" SETUP_ID,")
                  .AppendLine(" STEP_ID,")
                  .AppendLine(" SETUP_TIME,")
                  .AppendLine(" ANGLE,")
                  .AppendLine(" WAFER_SIZE,")
                  .AppendLine(" NOTCH_TYPE,")
                  .AppendLine(" DIE_PITCH_X,")
                  .AppendLine(" DIE_PITCH_Y,")
                  .AppendLine(" DIE_ORIGIN_X,")
                  .AppendLine(" DIE_ORIGIN_Y,")
                  .AppendLine(" ORIGIN_X,")
                  .AppendLine(" ORIGIN_Y")
                  .AppendLine(" ) VALUES (")
                  .AppendLine(" SETUP_SEQ.NEXTVAL,")
                  .AppendLine(" :SETUP_ID,")
                  .AppendLine(" :STEP_ID,")
                  .AppendLine(" TO_DATE(:SETUP_TIME, 'YYYYMMDDHH24MISS'),")
                  .AppendLine(" :ANGLE,")
                  .AppendLine(" :WAFER_SIZE,")
                  .AppendLine(" :NOTCH_TYPE,")
                  .AppendLine(" :DIE_PITCH_X,")
                  .AppendLine(" :DIE_PITCH_Y,")
                  .AppendLine(" :DIE_ORIGIN_X,")
                  .AppendLine(" :DIE_ORIGIN_Y,")
                  .AppendLine(" :ORIGIN_X,")
                  .AppendLine(" :ORIGIN_Y")
                  .AppendLine(" )");

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.SetupID;
            dicParams.Add("SETUP_ID", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.StepID;
            dicParams.Add("STEP_ID", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dtSetupTime.ToString(Constract.DEFAULT_DATETIME_STRING);
            dicParams.Add("SETUP_TIME", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int32;
            p.Value = dr["ANGLE"];
            dicParams.Add("ANGLE", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["WAFER_SIZE"];
            dicParams.Add("WAFER_SIZE", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = dr["NOTCH_TYPE"];
            dicParams.Add("NOTCH_TYPE", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_PITCH_X"];
            dicParams.Add("DIE_PITCH_X", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_PITCH_Y"];
            dicParams.Add("DIE_PITCH_Y", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_ORIGIN_X"];
            dicParams.Add("DIE_ORIGIN_X", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["DIE_ORIGIN_Y"];
            dicParams.Add("DIE_ORIGIN_Y", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["ORIGIN_X"];
            dicParams.Add("ORIGIN_X", p);

            //--

            p = new Parameter();
            p.Type = DbType.Int64;
            p.Value = dr["ORIGIN_Y"];
            dicParams.Add("ORIGIN_Y", p);
            #endregion [ Setting Parameter ]

            iResult = ExecuteNonQuery(
                oConnection,
                Constract.FUNCATION_NAME_SETUP,
                sQuery.ToString(),
                dicParams
                );

            CheckedSetup(ref rv, dtSetupTime);

            return iResult;
        }
        #endregion [ TQD_SETUP ]

