    public struct Parameter
    {
        public DbType Type;
        public object Value;

        public Parameter(
            DbType type,
            object value
            )
        {
            this.Type = type;
            this.Value = value;
        }
    }

    public struct DataTableParameters
    {
        public DbType DataTableColumnType;
        public ArrayList Values;

        //--

        public DataTableParameters(
            DbType type,
            ArrayList values
            )
        {
            this.DataTableColumnType = type;
            this.Values = values;
        }
    }

