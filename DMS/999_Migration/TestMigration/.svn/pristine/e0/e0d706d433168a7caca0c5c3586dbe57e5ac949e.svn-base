    #region [ DM Information ]

    //-----------------------------------------------------------------------------------

    public class DwLotInfo
    {
        public string Device;
        public long WaferKey;
        public string LotID;
        public long LotSeq;
        public string FileName;
        public string InspDateTime;

        public DwLotInfo(
            )
        {
            this.Device = string.Empty;
            this.WaferKey = -1;
            this.LotID = string.Empty;
            this.LotSeq = -1;
            this.FileName = string.Empty;
            this.InspDateTime = string.Empty;
        }

        public DwLotInfo(
            string product,
            long waferkey,
            string lotid,
            long lotseq,
            string filename,
            string inspdatetime
            )
        {
            this.Device = product;
            this.WaferKey = waferkey;
            this.LotID = lotid;
            this.LotSeq = lotseq;
            this.FileName = filename;
            this.InspDateTime = inspdatetime;
        }
    }

    //-----------------------------------------------------------------------------------

    public class DwResultValue
    {
        public string Device;
        public string FileName;
        public string InspDateTime;

        //--

        public long WaferKey;
        public long RecipeKey;
        public int DiffX;
        public int DiffY;

        // --

        public string LotID;
        public long LotSeq;
        public string WaferID;
        public long WaferSeq;
        public string StepID;
        public long StepSeq;
        public string SetupID;
        public long SetupSeq;

        public DwResultValue(
            )
        {
            this.Device = string.Empty;
            this.FileName = string.Empty;
            this.InspDateTime = string.Empty;

            //--

            this.WaferKey = -1;
            this.RecipeKey = -1;
            this.DiffX = -1;
            this.DiffY = -1;

            //--

            this.LotID = string.Empty;
            this.LotSeq = -1;
            this.WaferID = string.Empty;
            this.WaferSeq = -1;
            this.StepID = string.Empty;
            this.StepSeq = -1;
            this.SetupID = string.Empty;
            this.SetupSeq = -1;
        }

        public DwResultValue(
            string sProduct,
            string sFileName,
            string sInspDateTime,
            long lWaferKey,
            string sLotId,
            long lotseq
            )
        {
            this.Device = sProduct;
            this.FileName = sFileName;
            this.InspDateTime = sInspDateTime;

            //--

            this.WaferKey = lWaferKey;
            this.RecipeKey = -1;
            this.DiffX = -1;
            this.DiffY = -1;

            //--

            this.LotID = sLotId;
            this.LotSeq = lotseq;
            this.WaferID = string.Empty;
            this.WaferSeq = -1;
            this.StepID = string.Empty;
            this.StepSeq = -1;
            this.SetupID = string.Empty;
            this.SetupSeq = -1;
        }
    }

