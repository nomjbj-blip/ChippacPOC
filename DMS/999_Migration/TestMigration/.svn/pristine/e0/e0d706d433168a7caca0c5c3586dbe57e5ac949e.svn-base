    #endregion [ DM Information ]

    //-----------------------------------------------------------------------------------

    #region [ TestWare Information ]

    public class TwLotInfo
    {
        public string Factory;
        public string Device;
        public string Program;
        public string TestArea;
        public string LotID;
        public string LotType;
        public long LotSequence_Prev; // source lot sequence
        public long LotSequence_Next; // target lot sequence

        public int MaxX;
        public int MaxY;
        public int MinX;
        public int MinY;

        public int Flat_Zone;
        public int WAFER_DIAM;

        public DateTime StartTime;
        public DateTime EndTime;

        public TwLotInfo(
            )
        {
            Factory = string.Empty;
            Device = string.Empty;
            Program = string.Empty;
            TestArea = string.Empty;
            LotID = string.Empty;
            LotType = string.Empty;

            LotSequence_Prev = long.MinValue;
            LotSequence_Next = long.MinValue;

            StartTime = DateTime.Now;
            EndTime = DateTime.Now;
        }
    }

    public class TwResultValue : TwLotInfo
    {
        public string ProgramRevision;
        public long PPDSequence_Prev;

        public string WaferID;
        public long WaferSequence_Prev;
        public long WaferSequence_Next;

        public List<TwDataTable> TableName = null;

        public TwResultValue(
            )
        {
            base.Factory = string.Empty;
            base.Device = string.Empty;
            base.Program = string.Empty;
            ProgramRevision = string.Empty;
            PPDSequence_Prev = long.MinValue;
            base.TestArea = string.Empty;
            base.LotID = string.Empty;
            base.LotType = string.Empty;

            base.LotSequence_Prev = long.MinValue;
            base.LotSequence_Next = long.MinValue;

            base.StartTime = DateTime.Now;
            base.EndTime = DateTime.Now;

            WaferID = string.Empty;
            WaferSequence_Prev = long.MinValue;
            WaferSequence_Next = long.MinValue;

            TableName = new List<TwDataTable>();

            base.MaxX = int.MinValue;
            base.MaxY = int.MinValue;
            base.MinX = int.MaxValue;
            base.MinY = int.MaxValue;

            base.Flat_Zone = 0;
            base.WAFER_DIAM = 200;

        }

        public TwResultValue(
            TwLotInfo lot
            )
        {
            base.Factory = lot.Factory;
            base.Device = lot.Device;
            base.Program = lot.Program;
            ProgramRevision = string.Empty;
            PPDSequence_Prev = long.MinValue;
            base.TestArea = lot.TestArea;
            base.LotID = lot.LotID;
            base.LotType = lot.LotType;

            base.LotSequence_Prev = lot.LotSequence_Prev;
            base.LotSequence_Next = lot.LotSequence_Next;
            base.StartTime = lot.StartTime;
            base.EndTime = lot.EndTime;

            WaferID = string.Empty;
            WaferSequence_Prev = long.MinValue;
            WaferSequence_Next = long.MinValue;

            TableName = new List<TwDataTable>();
        }
    }

    public class TwDataTable
    {
        public string TableName = string.Empty;
        public List<TwParameter> Params = null;

        public TwDataTable(
            )
        {
            this.TableName = string.Empty;
            this.Params = new List<TwParameter>();
        }

        public TwDataTable(
            string tablename
            )
        {
            this.TableName = tablename;
            this.Params = new List<TwParameter>();
        }
    }

    public class TwParameter
    {
        public string Name;
        public string Type;

        public TwParameter(
            string name,
            string type
            )
        {
            this.Name = name;
            this.Type = type;
        }
    }

    #endregion [ TestWare Information ]

