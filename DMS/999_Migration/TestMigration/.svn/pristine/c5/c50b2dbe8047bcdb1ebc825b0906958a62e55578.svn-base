using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Data.SqlClient;
using System.Diagnostics;
using Oracle.ManagedDataAccess.Client;

namespace FabTwoToMigrationTools
{
    public class BaseInfo
    {
        public string UserID { get; set; }
        public string Password { get; set; }
        public string DataSource { get; set; }

        public BaseInfo(
            )
        {
        }

        public BaseInfo(
            string userid,
            string password,
            string connectionname
            )
        {
            this.UserID = userid;
            this.Password = password;
            this.DataSource = connectionname;
        }

        //-----------------------------------------------------------------------------------

        public OracleConnection DbOpen(
            )
        {
            OracleConnection oConnection = new OracleConnection();
            oConnection.ConnectionString = string.Format(
                Constract.ConnectionString,
                this.UserID,
                this.Password,
                this.DataSource
                );
            oConnection.Open();
            return oConnection;
        }

        //-----------------------------------------------------------------------------------

        public ConnectionState DbClose(
            OracleConnection oConnection
            )
        {
            if (oConnection.State == ConnectionState.Open)
                oConnection.Close();

            return oConnection.State;
        }

        //-----------------------------------------------------------------------------------

        public DataTable ExecuteQuery(
            OracleConnection oConnection,
            string sQuery,
            Dictionary<string, Parameter> dicParams = null
            )
        {
            return ExecuteQuery(
                oConnection,
                string.Empty,
                sQuery,
                dicParams
                );
        }

        public DataTable ExecuteQuery(
            OracleConnection oConnection,
            string sFuncName,
            string sQuery,
            Dictionary<string, Parameter> dicParams
            )
        {
            Stopwatch swt = new Stopwatch();
            DataTable dt = new DataTable();
            OracleParameter oParams = null;
            using (OracleCommand oCommand = oConnection.CreateCommand())
            {
                oCommand.CommandText = sQuery;
#if DEBUG
                Debug.WriteLine(string.Format("Query: {0}", sQuery));
#endif
                oCommand.CommandTimeout = 60;
                oCommand.CommandType = CommandType.Text;

                if (dicParams != null)
                {
                    foreach (KeyValuePair<string, Parameter> pk in dicParams)
                    {
                        oParams = new OracleParameter();
                        Parameter p = pk.Value;
                        oParams.ParameterName = pk.Key;
                        oParams.OracleDbType = GetOracleDbTypeByName(p.Type);
                        oParams.Value = p.Value;

                        oCommand.Parameters.Add(oParams);
                    }
                }

                OracleDataAdapter oAdapter = new OracleDataAdapter(oCommand);
                swt.Start();
                oAdapter.Fill(dt);
                swt.Stop();
            }

#if DEBUG
            Debug.WriteLine(string.Format("Function Name: {0}, ElapsedMilliseconds: {1}", sFuncName, swt.ElapsedMilliseconds));
#endif
            return dt;
        }

        //-----------------------------------------------------------------------------------

        public int ExecuteNonQuery(
            OracleConnection oConnection,
            string sQuery
            )
        {
            int iCnt = -1;
            Stopwatch swt = new Stopwatch();
            using (OracleCommand oCommand = oConnection.CreateCommand())
            {
                oCommand.CommandText = sQuery;
#if DEBUG
                Debug.WriteLine(string.Format("Query: {0}", sQuery));
#endif
                oCommand.CommandType = System.Data.CommandType.Text;
                swt.Start();
                iCnt = oCommand.ExecuteNonQuery();
                swt.Stop();
            }
#if DEBUG
            Debug.WriteLine(string.Format("DML Count: {0}, ElapsedMilliseconds: {1}", iCnt, swt.ElapsedMilliseconds));
#endif
            return iCnt;
        }

        //-----------------------------------------------------------------------------------

        public int ExecuteNonQuery(
            OracleConnection oConnection,
            string sQuery,
            Dictionary<string, Parameter> dicParams
            )
        {
            return ExecuteNonQuery(
                oConnection,
                string.Empty,
                sQuery,
                dicParams
                );
        }

        public int ExecuteNonQuery(
            OracleConnection oConnection,
            string sFunctionName,
            string sQuery,
            Dictionary<string, Parameter> dicParams
            )
        {
            int iCnt = -1;
            Stopwatch swt = new Stopwatch();
            OracleParameter oParams = null;
            using (OracleCommand oCommand = oConnection.CreateCommand())
            {
                oCommand.CommandText = sQuery;
                //oCommand.CommandTimeout = 60;
#if DEBUG
                Debug.WriteLine(string.Format("Query: {0}", sQuery));
#endif
                oCommand.CommandType = System.Data.CommandType.Text;

                foreach (KeyValuePair<string, Parameter> p in dicParams)
                {
                    oParams = new OracleParameter();
                    Parameter dbp = p.Value;
                    oParams.OracleDbType = GetOracleDbTypeByName(dbp.Type);
                    oParams.Value = dbp.Value;
                    oParams.ParameterName = p.Key;
                    oCommand.Parameters.Add(oParams);
                }

                swt.Start();
                iCnt = oCommand.ExecuteNonQuery();
                swt.Stop();
            }
#if DEBUG
            Debug.WriteLine(string.Format("DML Count: {0}, Function Name: {2}, ElapsedMilliseconds: {1}", iCnt, swt.ElapsedMilliseconds, sFunctionName));
#endif
            oParams = null;
            return iCnt;
        }

        //-----------------------------------------------------------------------------------
        public int ExecuteNonQuery(
            OracleConnection oConnection,
            string sQuery,
            int iBindCnt,
            Dictionary<string, DataTableParameters> dicParams
            )
        {
            return ExecuteNonQuery(
                oConnection,
                string.Empty,
                sQuery,
                iBindCnt,
                dicParams
                );
        }

        public int ExecuteNonQuery(
            OracleConnection oConnection,
            string sFunctionName,
            string sQuery,
            int iBindCnt,
            Dictionary<string, DataTableParameters> dicParams
            )
        {
            int iCnt = -1;
            Stopwatch swt = new Stopwatch();
            OracleParameter oParams = null;
            using (OracleCommand oCommand = oConnection.CreateCommand())
            {
                oCommand.CommandText = sQuery;
                //oCommand.CommandTimeout = 60;
#if DEBUG
                Debug.WriteLine(string.Format("Query: {0}", sQuery));
#endif
                oCommand.CommandType = System.Data.CommandType.Text;
                oCommand.ArrayBindCount = iBindCnt;

                foreach (KeyValuePair<string, DataTableParameters> p in dicParams)
                {
                    oParams = new OracleParameter();
                    DataTableParameters dbp = p.Value;
                    oParams.Value = dbp.Values.ToArray();
                    oParams.ParameterName = p.Key;
                    oCommand.Parameters.Add(oParams);
                }

                swt.Start();
                iCnt = oCommand.ExecuteNonQuery();
                swt.Stop();
            }
#if DEBUG
            Debug.WriteLine(string.Format("DML Count: {0}, Function Name: {2}, ElapsedMilliseconds: {1}", iCnt, swt.ElapsedMilliseconds, sFunctionName));
#endif
            oParams = null;
            return iCnt;
        }

        //-----------------------------------------------------------------------------------

        public DbType GetDbTypeByName(
            Type type
            )
        {
            SqlParameter sqlParam = new SqlParameter();
            TypeConverter tc = TypeDescriptor.GetConverter(sqlParam.DbType);
            if (tc.CanConvertFrom(type))
            {
                sqlParam.DbType = (DbType)tc.ConvertFrom(type.Name);
            }
            else
            {
                sqlParam.DbType = (DbType)tc.ConvertFrom(type.Name);
            }

            return sqlParam.DbType;
        }

        public OracleDbType GetOracleDbTypeByName(
            DbType dbType
            )
        {
            OracleParameter oraParamConvert = new OracleParameter();
            oraParamConvert.DbType = dbType;
            return oraParamConvert.OracleDbType;
        }

        public void WriteQuery(
            string sInfo
            )
        {
#if DEBUG
            Debug.WriteLine(string.Format("Query: {0}", sInfo));
#endif
        }
    }
}
