        //-----------------------------------------------------------------------------------

        public DataTable ExecuteQuery(
            string sQuery,
            Dictionary<string, Parameter> dicParams
            )
        {
            Stopwatch swt = new Stopwatch();
            DataTable dt = new DataTable();
            OracleParameter oParams = null;
            using (OracleCommand oCommand = oConnection.CreateCommand())
            {
                oCommand.CommandText = sQuery;
#if DEBUG
                Debug.WriteLine(string.Format("Query: {0}", sQuery));
#endif
                oCommand.CommandTimeout = 60;
                oCommand.CommandType = CommandType.Text;

                foreach (KeyValuePair<string, Parameter> pk in dicParams)
                {
                    oParams = new OracleParameter();
                    Parameter p = pk.Value;
                    oParams.ParameterName = pk.Key;
                    oParams.OracleType = GetOracleType(p.Type);
                    oParams.Value = p.Value;

                    oCommand.Parameters.Add(oParams);
                }

                OracleDataAdapter oAdapter = new OracleDataAdapter(oCommand);
                swt.Start();
                oAdapter.Fill(dt);
                swt.Stop();
            }

#if DEBUG
            Debug.WriteLine(string.Format("ElapsedMilliseconds: {0}", swt.ElapsedMilliseconds));
#endif
            return dt;
        }

        public OracleType GetOracleType(
            DbType dbType
            )
        {
            OracleType oraType = OracleType.VarChar;
            switch (dbType)
            {
                case DbType.Date:
                case DbType.DateTime:
                    oraType = OracleType.DateTime;
                    break;
                case DbType.Decimal:
                    oraType = OracleType.Number;
                    break;
                case DbType.Double:
                    oraType = OracleType.Double;
                    break;
                case DbType.Object:
                    oraType = OracleType.Blob;
                    break;
                case DbType.Int16:
                    oraType = OracleType.Int16;
                    break;
                case DbType.Int32:
                    oraType = OracleType.Int32;
                    break;
                case DbType.UInt16:
                    oraType = OracleType.UInt16;
                    break;
                case DbType.UInt32:
                    oraType = OracleType.UInt32;
                    break;
                case DbType.Int64:
                case DbType.UInt64:
                    oraType = OracleType.Float;
                    break;
                case DbType.Time:
                    oraType = OracleType.Timestamp;
                    break;
                default:
                    oraType = OracleType.VarChar;
                    break;
            }

            return oraType;
        }


