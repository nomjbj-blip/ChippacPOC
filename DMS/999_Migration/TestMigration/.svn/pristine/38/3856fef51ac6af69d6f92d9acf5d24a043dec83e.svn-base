            //sQuery.AppendLine("          (SELECT T1.INSPECTION_TIME, ");
            //sQuery.AppendLine("                  T1.WAFER_KEY, ");
            //sQuery.AppendLine("                  T1.INSPECTION_FILENAME, ");
            //sQuery.AppendLine("                  T2.RECIPE_KEY, ");
            //sQuery.AppendLine("                  T2.RECIPE_ID, ");
            //sQuery.AppendLine("                  T2.LAYER_ID, ");
            //sQuery.AppendLine("                  T2.DIE_SIZE_X, ");
            //sQuery.AppendLine("                  T2.DIE_SIZE_Y, ");
            //sQuery.AppendLine("                  T2.ORIGIN_INDEX_X, ");
            //sQuery.AppendLine("                  T2.ORIGIN_INDEX_Y, ");
            //sQuery.AppendLine("                  T2.ORIGIN_DIE_X, ");
            //sQuery.AppendLine("                  T2.ORIGIN_DIE_Y, ");
            //sQuery.AppendLine("                  T2.ROTATION_ANGLE, ");
            //sQuery.AppendLine("                  T1.CENTER_X, ");
            //sQuery.AppendLine("                  T1.CENTER_Y, ");
            //sQuery.AppendLine("                  T1.ORIGIN_X, ");
            //sQuery.AppendLine("                  T1.ORIGIN_Y, ");
            //sQuery.AppendLine("                  CASE WHEN T2.ROTATION_ANGLE = '0' THEN T1.CENTER_X - T1.ORIGIN_X ");
            //sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '90' THEN T2.DIE_SIZE_X + (T1.CENTER_X - T1.ORIGIN_X) ");
            //sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '180' THEN T1.CENTER_X - T1.ORIGIN_X ");
            //sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '270' THEN T1.CENTER_X - T1.ORIGIN_X END AS \"ORIGIN_X_CAL\", -- SAMPLE CENTER LOCATION X ");
            //sQuery.AppendLine("                  CASE WHEN T2.ROTATION_ANGLE = '0' THEN T1.CENTER_Y - T1.ORIGIN_Y ");
            //sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '90' THEN T1.CENTER_Y - T1.ORIGIN_Y ");
            //sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '180' THEN T1.CENTER_Y - T1.ORIGIN_Y ");
            //sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '270' THEN T2.DIE_SIZE_Y + (T1.CENTER_Y - T1.ORIGIN_X) END AS \"ORIGIN_Y_CAL\" -- SAMPLE CENTER LOCATION Y ");
            //sQuery.AppendLine("             FROM INSP_WAFER_SUMMARY T1, INSP_RECIPE T2 ");
            //sQuery.AppendLine("            WHERE     1 = 1 ");
            //sQuery.AppendLine("                  AND T1.RECIPE_KEY = T2.RECIPE_KEY ");
            //sQuery.AppendLine("                  AND T1.INSPECTION_TIME = TO_DATE(:inspdatetime, 'YYYYMMDDHH24MISS')  ");
            //sQuery.AppendLine("                  AND T1.WAFER_KEY = :waferkey  ");
            //sQuery.AppendLine("           ) T2 ");
            //sQuery.AppendLine("    WHERE     1 = 1 ");
            //sQuery.AppendLine("          AND T1.INSPECTION_TIME = T2.INSPECTION_TIME ");
            //sQuery.AppendLine("          AND T1.WAFER_KEY = T2.WAFER_KEY ");
            //sQuery.AppendLine(" ORDER BY T1.DEFECT_ID ");

            //--

            sQuery.AppendLine(" SELECT '' AS \"STEP_SEQ\", ");
            sQuery.AppendLine("          T1.DEFECT_ID, ");
            sQuery.AppendLine("          '' AS \"WAFER_SEQ\", ");
            sQuery.AppendLine("          (T2.DIE_SIZE_X * T1.INDEX_X) + (T1.WAFER_X - (T2.DIE_SIZE_X * T1.INDEX_X)) - T2.CENTER_X AS \"X\", ");
            sQuery.AppendLine("          (T2.DIE_SIZE_Y * T1.INDEX_Y) + (T1.WAFER_Y - (T2.DIE_SIZE_Y * T1.INDEX_Y)) - T2.CENTER_Y AS \"Y\", ");
            sQuery.AppendLine("          T1.WAFER_X - (T2.DIE_SIZE_X * T1.INDEX_X) AS \"XREF\", ");
            sQuery.AppendLine("          T1.WAFER_Y - (T2.DIE_SIZE_Y * T1.INDEX_Y) AS \"YREF\", ");
            sQuery.AppendLine("          T1.INDEX_X - T2.DIFF_INDEX_X + 1 AS \"XINDEX\", ");
            sQuery.AppendLine("          T1.INDEX_Y - T2.DIFF_INDEX_Y + 1 AS \"YINDEX\", ");
            sQuery.AppendLine("          T1.SIZE_X AS \"XSIZE\", ");
            sQuery.AppendLine("          T1.SIZE_Y AS \"YSIZE\", ");
            sQuery.AppendLine("          T1.AREA AS \"DEFECTAREA\", ");
            sQuery.AppendLine("          T1.SIZE_D AS \"DSIZE\", ");
            sQuery.AppendLine("          T1.CLASS_NUMBER AS \"CLASSNUMBER\", ");
            sQuery.AppendLine("          T1.TEST_ID AS \"TEST\", ");
            sQuery.AppendLine("          NVL(T1.CLUSTER_ID, 0) AS \"CLUSTERNUMBER\", ");
            sQuery.AppendLine("          T1.ROUGH_BIN_CLASS AS \"ROUGHBINCLASS\", ");
            sQuery.AppendLine("          '0' AS \"FINEBINNUMBER\", ");
            sQuery.AppendLine("          T1.REVIEW_SAMPLE_FLAG AS \"REVIEWSAMPLE\", ");
            sQuery.AppendLine("          T1.IMAGES AS \"IMAGECOUNT\", ");
            sQuery.AppendLine("          ADDER AS ADDER, ");
            sQuery.AppendLine("          T2.LAYER_ID AS FIRST_STEP, ");
            sQuery.AppendLine("          -1 AS RETICLE_REPEAT_ID, ");
            sQuery.AppendLine("          -1 AS DIE_REPEAT_ID, ");
            sQuery.AppendLine("          T1.MANUAL_OPTICAL_CLASS AS MAN_OPT_CLASS, ");
            sQuery.AppendLine("          T1.AUTOMATED_OPTICAL_CLASS AS AUTO_OPT_CLASS, ");
            sQuery.AppendLine("          T1.AUTOMATED_OFFLINE_SEM_CLASS AS MAN_SEM_CLASS, ");
            sQuery.AppendLine("          T1.AUTOMATED_ONLINE_SEM_CLASS AS AUTO_SEM_CLASS ");
            sQuery.AppendLine("     FROM INSP_DEFECT T1, ");
            sQuery.AppendLine("          (SELECT T1.INSPECTION_TIME, ");
            sQuery.AppendLine("                  T1.WAFER_KEY, ");
            sQuery.AppendLine("                  T1.INSPECTION_FILENAME, ");
            sQuery.AppendLine("                  T2.RECIPE_KEY, ");
            sQuery.AppendLine("                  T2.RECIPE_ID,  ");
            sQuery.AppendLine("                  T1.LAYER_ID,   ");
            sQuery.AppendLine("                  T2.DIE_SIZE_X, ");
            sQuery.AppendLine("                  T2.DIE_SIZE_Y, ");
            sQuery.AppendLine("                  T2.ORIGIN_INDEX_X, ");
            sQuery.AppendLine("                  T2.ORIGIN_INDEX_Y, ");
            sQuery.AppendLine("                  T2.DIFF_INDEX_X, ");
            sQuery.AppendLine("                  T2.DIFF_INDEX_Y, ");
            sQuery.AppendLine("                  T2.ORIGIN_DIE_X, ");
            sQuery.AppendLine("                  T2.ORIGIN_DIE_Y, ");
            sQuery.AppendLine("                  T2.ROTATION_ANGLE, ");
            sQuery.AppendLine("                  T1.CENTER_X, ");
            sQuery.AppendLine("                  T1.CENTER_Y, ");
            sQuery.AppendLine("                  T1.ORIGIN_X, ");
            sQuery.AppendLine("                  T1.ORIGIN_Y, ");
            sQuery.AppendLine("                  CASE WHEN T2.ROTATION_ANGLE = '0' THEN T1.CENTER_X - T1.ORIGIN_X ");
            sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '90' THEN T2.DIE_SIZE_X + (T1.CENTER_X - T1.ORIGIN_X) ");
            sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '180' THEN T1.CENTER_X - T1.ORIGIN_X ");
            sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '270' THEN T1.CENTER_X - T1.ORIGIN_X ");
            sQuery.AppendLine("                   END AS \"ORIGIN_X_CAL\", -- SAMPLE CENTER LOCATION X ");
            sQuery.AppendLine("                  CASE WHEN T2.ROTATION_ANGLE = '0' THEN T1.CENTER_Y - T1.ORIGIN_Y ");
            sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '90' THEN T1.CENTER_Y - T1.ORIGIN_Y ");
            sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '180' THEN T1.CENTER_Y - T1.ORIGIN_Y ");
            sQuery.AppendLine("                       WHEN T2.ROTATION_ANGLE = '270' THEN T2.DIE_SIZE_Y + (T1.CENTER_Y - T1.ORIGIN_Y) ");
            sQuery.AppendLine("                   END AS \"ORIGIN_Y_CAL\" -- SAMPLE CENTER LOCATION Y ");
            sQuery.AppendLine("             FROM INSP_WAFER_SUMMARY T1, ");
            sQuery.AppendLine("                  (  SELECT T3.RECIPE_KEY, ");
            sQuery.AppendLine("                            T3.RECIPE_ID, ");
            sQuery.AppendLine("                            T3.RECIPE_TIME, ");
            sQuery.AppendLine("                            T3.WAFER_SIZE, ");
            sQuery.AppendLine("                            T3.ROTATION_ANGLE, ");
            sQuery.AppendLine("                            T3.DIE_SIZE_X, ");
            sQuery.AppendLine("                            T3.DIE_SIZE_Y, ");
            sQuery.AppendLine("                            T3.ORIGIN_INDEX_X AS \"ORIGIN_INDEX_X\", ");
            sQuery.AppendLine("                            T3.ORIGIN_INDEX_Y AS \"ORIGIN_INDEX_Y\", ");
            sQuery.AppendLine("                            T3.ORIGIN_DIE_X, ");
            sQuery.AppendLine("                            T3.ORIGIN_DIE_Y, ");
            sQuery.AppendLine("                            MIN(T4.INDEX_X) AS \"DIFF_INDEX_X\", ");
            sQuery.AppendLine("                            MIN(T4.INDEX_Y) AS \"DIFF_INDEX_Y\" ");
            sQuery.AppendLine("                       FROM INSP_WAFER_SUMMARY T1, INSP_WAFER_TEST_SUMMARY T2, INSP_RECIPE T3, INSP_REGION T4 ");
            sQuery.AppendLine("                      WHERE 1 = 1 ");
            sQuery.AppendLine("                            AND T1.INSPECTION_TIME = T2.INSPECTION_TIME ");
            sQuery.AppendLine("                            AND T1.WAFER_KEY = T2.WAFER_KEY ");
            sQuery.AppendLine("                            AND T1.RECIPE_KEY = T3.RECIPE_KEY ");
            sQuery.AppendLine("                            AND T1.RECIPE_KEY = T4.RECIPE_KEY ");
            sQuery.AppendLine("                            AND T2.TEST_ID = T4.TEST_ID ");
            sQuery.AppendLine("                            AND T1.INSPECTION_TIME = TO_DATE(:inspdatetime, 'YYYYMMDDHH24MISS') ");
            sQuery.AppendLine("                            AND T1.WAFER_KEY = :waferkey ");
            sQuery.AppendLine("                   GROUP BY T3.RECIPE_KEY, ");
            sQuery.AppendLine("                            T3.RECIPE_ID, ");
            sQuery.AppendLine("                            T3.RECIPE_TIME, ");
            sQuery.AppendLine("                            T3.WAFER_SIZE, ");
            sQuery.AppendLine("                            T3.ROTATION_ANGLE, ");
            sQuery.AppendLine("                            T3.DIE_SIZE_X, ");
            sQuery.AppendLine("                            T3.DIE_SIZE_Y, ");
            sQuery.AppendLine("                            T3.ORIGIN_INDEX_X, ");
            sQuery.AppendLine("                            T3.ORIGIN_INDEX_Y, ");
            sQuery.AppendLine("                            T3.ORIGIN_DIE_X, ");
            sQuery.AppendLine("                            T3.ORIGIN_DIE_Y ");
            sQuery.AppendLine("                      ) T2 ");
            sQuery.AppendLine("            WHERE     1 = 1 ");
            sQuery.AppendLine("                  AND T1.RECIPE_KEY = T2.RECIPE_KEY ");
            sQuery.AppendLine("                  AND T1.INSPECTION_TIME = TO_DATE(:inspdatetime, 'YYYYMMDDHH24MISS') ");
            sQuery.AppendLine("                  AND T1.WAFER_KEY = :waferkey ");
            sQuery.AppendLine("                  ) T2 ");
            sQuery.AppendLine("    WHERE     1 = 1 ");
            sQuery.AppendLine("          AND T1.INSPECTION_TIME = T2.INSPECTION_TIME ");
            sQuery.AppendLine("          AND T1.WAFER_KEY = T2.WAFER_KEY ");
            sQuery.AppendLine("          AND T1.INSPECTION_TIME = TO_DATE(:inspdatetime, 'YYYYMMDDHH24MISS') ");
            sQuery.AppendLine("          AND T1.WAFER_KEY = :waferkey ");
            sQuery.AppendLine(" ORDER BY T1.DEFECT_ID ");

            //--

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.InspDateTime;
            dicParams.Add("inspdatetime", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.WaferKey;
            dicParams.Add("waferkey", p);

            #endregion [ Setting Parameter ]

            //--

            DataTable dt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_DEFECT,
                sQuery.ToString(),
                dicParams
                );

            return dt;
        }

        public DataTable GetDefectImage(
            DwResultValue rv
            )
        {
            Dictionary<string, Parameter> dicParams = null;
            StringBuilder sQuery = new StringBuilder();

            //--

            sQuery.AppendLine(" SELECT t1.wafer_key AS 	STEP_SEQ	, ");
            sQuery.AppendLine("        t1.inspection_time, ");
            sQuery.AppendLine("        T2.DEFECT_ID AS 	DEFECT_ID	, ");
            sQuery.AppendLine("        T2.IMAGE_ID AS 	IMAGE_ID	, ");
            sQuery.AppendLine("        '' AS 	WAFER_SEQ	, ");
            sQuery.AppendLine("        T1.TEST_ID AS 	TEST	, ");
            sQuery.AppendLine("        T2.IMAGE_TYPE AS 	IMAGE_TYPE	, ");
            sQuery.AppendLine("        T2.IMAGE_FILESPEC AS 	IMAGE_FILESPEC	, "); // Source FTP image path
            sQuery.AppendLine("        'DEFACTIMAGE/' || TO_CHAR (T1.INSPECTION_TIME, 'YYYY') || '/' || TO_CHAR (T1.INSPECTION_TIME, 'MM') || '/' ");
            sQuery.AppendLine("        || TO_CHAR (T1.INSPECTION_TIME, 'DD') || '/' || T1.DEVICE  || '/' ");
            sQuery.AppendLine("        || T1.LOT_ID || '/' || TRIM(TO_CHAR(T1.SLOT_ID, '00')) AS	IMAGE_PATH	, ");
            sQuery.AppendLine("        SUBSTR (T2.IMAGE_FILESPEC, INSTR (T2.IMAGE_FILESPEC, '/', -1, 1) + 1) AS 	IMAGE_FILENAME	, ");
            sQuery.AppendLine("        T2.IMAGE_SERVER_ID AS 	IMAGE_SERVER	, ");
            sQuery.AppendLine("        'DEFACTIMAGE/' || TO_CHAR (T1.INSPECTION_TIME, 'YYYY') || '/' || TO_CHAR (T1.INSPECTION_TIME, 'MM') || '/' ");
            sQuery.AppendLine("        || TO_CHAR (T1.INSPECTION_TIME, 'DD') || '/' || T1.DEVICE  || '/' ");
            sQuery.AppendLine("        || T1.LOT_ID || '/' || TRIM(TO_CHAR(T1.SLOT_ID, '00')) || '/THUMB' AS 	THUMB_PATH	, ");
            sQuery.AppendLine("        SUBSTR (T2.IMAGE_FILESPEC, INSTR (T2.IMAGE_FILESPEC, '/', -1, 1) + 1) AS 	THUMB_FILENAME ");
            sQuery.AppendLine("   FROM (SELECT T1.INSPECTION_TIME, ");
            sQuery.AppendLine("                T1.WAFER_KEY, ");
            sQuery.AppendLine("                T1.LOT_ID, ");
            sQuery.AppendLine("                T1.DEVICE, ");
            sQuery.AppendLine("                T1.WAFER_ID, ");
            sQuery.AppendLine("                T1.SLOT_ID, ");
            sQuery.AppendLine("                T1.INSPECT_EQUIP_ID, ");
            sQuery.AppendLine("                T2.TEST_ID ");
            sQuery.AppendLine("           FROM INSP_WAFER_SUMMARY T1, INSP_WAFER_TEST_SUMMARY T2 ");
            sQuery.AppendLine("          WHERE     1 = 1 ");
            sQuery.AppendLine("                AND T1.INSPECTION_TIME = T2.INSPECTION_TIME ");
            sQuery.AppendLine("                AND T1.WAFER_KEY = T2.WAFER_KEY ");
            sQuery.AppendLine("                AND T1.INSPECTION_TIME = TO_DATE(:inspdatetime, 'YYYYMMDDHH24MISS')  ");
            sQuery.AppendLine("                AND T1.WAFER_KEY = :waferkey  ");
            sQuery.AppendLine("        ) T1, ");
            sQuery.AppendLine("        INSP_WAFER_IMAGE T2 ");
            sQuery.AppendLine("  WHERE     1 = 1 ");
            sQuery.AppendLine("        AND T1.INSPECTION_TIME = T2.INSPECTION_TIME ");
            sQuery.AppendLine("        AND T1.WAFER_KEY = T2.WAFER_KEY ");
            sQuery.AppendLine("        AND T1.INSPECTION_TIME = TO_DATE(:inspdatetime, 'YYYYMMDDHH24MISS')  ");
            sQuery.AppendLine("        AND T1.WAFER_KEY = :waferkey  ");

            //--

            dicParams = new Dictionary<string, Parameter>();
            #region [ Setting Parameter ]
            Parameter p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.InspDateTime;
            dicParams.Add("inspdatetime", p);

            //--

            p = new Parameter();
            p.Type = DbType.String;
            p.Value = rv.WaferKey;
            dicParams.Add("waferkey", p);

            #endregion [ Setting Parameter ]

            //--

            DataTable dt = base.ExecuteQuery(
                oConnection,
                Constract.FUNCATION_NAME_DEFECT_IMAGE,
                sQuery.ToString(),
                dicParams
                );

            return dt;
        }

        public void Dispose()
        {
            base.DbClose(
                oConnection
                );
        }
    }
}
