        private void AddMapdefData(DataTable dt, string mapid, decimal cnt, decimal minx, decimal miny,
            decimal maxx, decimal maxy)
        {
            double edge = 0.3d;
            double margin = 0.975d;
            double wsize = 200d; // Wafer Size 는 200mm

            int xcnt = (int)maxx;
            int ycnt = (int)maxy;

            double dDieSizeX = Math.Round(((wsize - edge * 2) * margin) / xcnt, 5);
            double dDieSizeY = Math.Round(((wsize - edge * 2) * margin) / ycnt, 5);

            double originx = (int)minx + (int)(xcnt / 2) - ((xcnt + 1) % 2) + 1;
            double originy = (int)miny + (int)(ycnt / 2) - ((ycnt + 1) % 2) + 1;

            int originmicroindexX = (int)(-dDieSizeX * 0.5 * (xcnt % 2));
            int originmicroindexY = (int)(-dDieSizeY * 0.5 * (ycnt % 2));

            DataRow row = dt.NewRow();
            row["MAPID"] = mapid;
            row["WAFER_SIZE"] = wsize;
            row["CHIP_SIZE_X"] = dDieSizeX;
            row["CHIP_SIZE_Y"] = dDieSizeY;
            row["ORIGIN_MICRO_X"] = originmicroindexX;
            row["ORIGIN_MICRO_Y"] = originmicroindexY;
            row["ORIGIN_INDEX_X"] = originx;
            row["ORIGIN_INDEX_Y"] = originy;
            row["FIRST_MICRO_X"] = dDieSizeX;
            row["FIRST_MICRO_Y"] = dDieSizeY;
            row["FIRST_INDEX_X"] = 1;
            row["FIRST_INDEX_Y"] = 1;
            row["EDGE_SIZE"] = edge;
            row["ANGLE"] = 0;
            row["NETDIE"] = cnt;
            row["NOTCH_TYPE"] = 0;
            row["ST_START"] = 0;
            row["ST_INTYPE"] = 0;
            row["ST_XCNT"] = 0;
            row["ST_YCNT"] = 0;
            row["ST_START_X"] = 0;
            row["ST_START_Y"] = 0;
            row["DIE_INDEX_MIN_X"] = minx;
            row["DIE_INDEX_MAX_X"] = maxx;
            row["DIE_INDEX_MIN_Y"] = miny;
            row["DIE_INDEX_MAX_Y"] = maxy;
            row["XY_DIRECTION"] = 1;
            row["REFERENCEDIE_SETTING"] = 0;
            //row["DELETE_FLAG"] = null;
            //row["UPDATE_TIME"] = null;
            //row["UPDATE_USER"] = null;
            dt.Rows.Add(row);
        }

        /// <summary>
        /// SUMMARY
        /// </summary>
        private void button9_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("run?", "run", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
                return;

            m = new MiracomTPS(GetSelectItem());

            DataTable lotDt = m.GetAllLotSeq();

            DataTable lotSum = EmptyLotSumTable();
            DataTable wafSum = EmptyWaferSumTable();

            foreach (DataRow lotRow in lotDt.Rows)
            {
                decimal lotSeq = decimal.Parse(lotRow["LOT_SEQ"].ToString());
                ThreadPool.QueueUserWorkItem(new WaitCallback(SumAsync), lotSeq);
            }

        }

        static readonly int CONCURRENT_COUNT = 10;

        Semaphore smp = new Semaphore(CONCURRENT_COUNT, CONCURRENT_COUNT);
        MiracomTPS m;

        private void SumAsync(object state)
        {
            smp.WaitOne();

            decimal lotSeq = (decimal)state;

            try
            {
                InsertStatus(lotSeq.ToString());

                if (m.ExistsData(lotSeq))
                    return;

                //MiracomTPS m = new MiracomTPS(GetSelectItem());
                DataTable waferDt = m.GetWaferSeq(lotSeq);

                DataTable lotSum = EmptyLotSumTable();
                DataTable wafSum = EmptyWaferSumTable();

                foreach (DataRow waferRow in waferDt.Rows)
                {
                    decimal waferSeq = decimal.Parse(waferRow["WAFER_SEQ"].ToString());
                    string ttable = m.GetBinTTable(waferSeq);
                    Dictionary<string, decimal> dic = m.GetBinCount(ttable, waferSeq);
                    DataTable wafSumDt = m.GetWaferSum(waferSeq);

                    if (wafSumDt == null || wafSumDt.Rows.Count == 0)
                        continue;

                    DataRow newWaf = wafSum.NewRow();
                    newWaf["CUSTOMER"] = wafSumDt.Rows[0]["CUSTOMER"];
                    newWaf["FACILITY"] = wafSumDt.Rows[0]["FACILITY"];
                    newWaf["PRODUCT"] = wafSumDt.Rows[0]["PRODUCT"];
                    newWaf["DEVICE_ALIAS"] = wafSumDt.Rows[0]["DEVICE_ALIAS"];
                    newWaf["TESTAREA"] = wafSumDt.Rows[0]["TESTAREA"];
                    newWaf["PROGRAM"] = wafSumDt.Rows[0]["PROGRAM"];
                    newWaf["MOTHER_LOT_ID"] = wafSumDt.Rows[0]["MOTHER_LOT_ID"];
                    newWaf["LOT_ID"] = wafSumDt.Rows[0]["LOT_ID"];
                    newWaf["LOT_SEQ"] = wafSumDt.Rows[0]["LOT_SEQ"];
                    newWaf["WAFER_ID"] = wafSumDt.Rows[0]["WAFER_ID"];
                    newWaf["WAFER_SEQ"] = wafSumDt.Rows[0]["WAFER_SEQ"];
                    newWaf["TESTER"] = wafSumDt.Rows[0]["TESTER"];
                    newWaf["PROBE_CARD"] = wafSumDt.Rows[0]["PROBE_CARD"];
                    newWaf["OPERATOR"] = wafSumDt.Rows[0]["OPERATOR"];
                    newWaf["PROBE_CNT"] = wafSumDt.Rows[0]["PROBE_CNT"];
                    newWaf["START_TIME"] = wafSumDt.Rows[0]["START_TIME"];
                    newWaf["END_TIME"] = wafSumDt.Rows[0]["END_TIME"];
                    newWaf["WAFER_CAT"] = wafSumDt.Rows[0]["WAFER_CAT"];

                    if (dic != null)
                    {
                        double sum = 0, good = 0;

                        foreach (var item in dic)
                        {
                            if (item.Key == "BIN1")
                                good += (int)item.Value;

                            newWaf[item.Key] = item.Value;
                            sum += (int)item.Value;
                        }

                        newWaf["TESTED_DIE"] = sum;
                        newWaf["YIELD"] = Math.Round(100 * good / sum, 2);
                    }

                    wafSum.Rows.Add(newWaf);
                }

                if (wafSum != null && waferDt.Rows.Count > 0)
                    m.InsertBulk(wafSum);

                DataTable lotSumDt = m.GetLotSum(lotSeq);

                if (lotSumDt == null || lotSumDt.Rows.Count == 0)
                    return;

                DataRow newLot = lotSum.NewRow();
                newLot["CUSTOMER"] = lotSumDt.Rows[0]["CUSTOMER"];
                newLot["FACILITY"] = lotSumDt.Rows[0]["FACILITY"];
                newLot["PRODUCT"] = lotSumDt.Rows[0]["PRODUCT"];
                newLot["DEVICE_ALIAS"] = lotSumDt.Rows[0]["DEVICE_ALIAS"];
                newLot["TESTAREA"] = lotSumDt.Rows[0]["TESTAREA"];
                newLot["PROGRAM"] = lotSumDt.Rows[0]["PROGRAM"];
                newLot["MOTHER_LOT_ID"] = lotSumDt.Rows[0]["MOTHER_LOT_ID"];
                newLot["LOT_ID"] = lotSumDt.Rows[0]["LOT_ID"];
                newLot["LOT_SEQ"] = lotSumDt.Rows[0]["LOT_SEQ"];
                newLot["START_TIME"] = lotSumDt.Rows[0]["START_TIME"];
                newLot["END_TIME"] = lotSumDt.Rows[0]["END_TIME"];
                newLot["LOSS_DIE"] = lotSumDt.Rows[0]["LOSS_DIE"];
                newLot["TESTED_DIE"] = lotSumDt.Rows[0]["TESTED_DIE"];
                newLot["YIELD"] = lotSumDt.Rows[0]["YIELD"];
                newLot["BIN1"] = lotSumDt.Rows[0]["BIN1"];
                newLot["GEC"] = lotSumDt.Rows[0]["GEC"];
                newLot["WAFERS"] = lotSumDt.Rows[0]["WAFERS"];

                for (int i = 0; i < 100; i++)
                {
                    string name = String.Format("BIN{0}", i);
                    newLot[name] = lotSumDt.Rows[0][name];
                }

                lotSum.Rows.Add(newLot);
                m.InsertBulk(lotSum);
            }
            catch (Exception ex)
            {
                ShowException(ex, lotSeq.ToString());
            }
            finally
            {
                if (smp != null)
                    smp.Release();
            }
        }

