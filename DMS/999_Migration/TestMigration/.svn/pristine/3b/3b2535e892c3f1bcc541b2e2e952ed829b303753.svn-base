        private void button2_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("insert?", "insert", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
