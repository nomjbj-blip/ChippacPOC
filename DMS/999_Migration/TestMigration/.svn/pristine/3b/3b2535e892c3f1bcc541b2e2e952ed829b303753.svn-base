        public static readonly string PREFIX_TABLE = "TD_";
        public static readonly string PREFIX_VIEW = "VW_";

        private void button3_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("delete?", "delete", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
                return;

            listBox1.Items.Clear();

            MiracomTPS m = new MiracomTPS(GetSelectItem());
            TestData t = new TestData();

            // 프로그램 목록 가져오기
            DataTable programDt = t.GetProgramList();

            label3.Text = String.Format("{0:N0}", programDt.Rows.Count);
            int cnt = 0;
            // program 별 처리
            for (int i = 0; i < programDt.Rows.Count; i++)
            {
                DataRow programRow = programDt.Rows[i];

                string factory = programRow["FACTORY"].ToString();
                string program = programRow["PROGRAM"].ToString();

                cnt++;
                label2.Text = String.Format("{0:N0}", cnt);
                listBox1.Items.Add(program);
                listBox1.SelectedIndex = listBox1.Items.Count - 1;
                Application.DoEvents();

                string tableName = PREFIX_TABLE + program.Trim();
                string viewName = PREFIX_VIEW + program.Trim();

                m.DropTable(tableName);
                m.DropView(viewName);
            }
        }

