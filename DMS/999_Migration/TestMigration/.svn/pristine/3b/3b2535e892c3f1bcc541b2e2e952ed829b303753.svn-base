        private void button4_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("run?", "run", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
                return;

            listBox1.Items.Clear();

            string factory = GetSelectItem();

            MiracomTPS m = new MiracomTPS(factory);
            TestData t = new TestData();

            // LOT 리스트 가져오기
            DataTable lotDt = t.GetLot(factory, dtStart.Value, dtEnd.Value);

            int cn = 0;
            label3.Text = String.Format("{0:N0}", lotDt.Rows.Count);

            DataTable allWaferDt = null;
            
            foreach (DataRow lotRow in lotDt.Rows)
            {
                string lot = lotRow["LOT_ID"].ToString();
                string program = lotRow["PROGRAM"].ToString();
                decimal oldLotSeq = Decimal.Parse(lotRow["OLD_LOT_SEQ"].ToString());

                cn++;
                label2.Text = String.Format("{0:N0}", cn);
                listBox1.Items.Add(lot);
                listBox1.SelectedIndex = listBox1.Items.Count - 1;
                Application.DoEvents();

                // 새로운 LOT_SEQ 입력
                lotRow["LOT_SEQ"] = m.NewLotSeq();

                // CASE WHEN LENGTH(DEVICE) < 8 THEN SUBSTR(DEVICE,1,4) ELSE SUBSTR(DEVICE,5,4) END
                string deviceAlias = (string)lotRow["DEVICE"];
                deviceAlias = deviceAlias.Length >= 8 ? deviceAlias.Substring(4, 4) : deviceAlias.Substring(0, Math.Min(deviceAlias.Length, 4));
                lotRow["DEVICE_ALIAS"] = deviceAlias;

                DataTable waferDt = t.GetWafer(lot, oldLotSeq);


                // WAFER_SEQ 별 T테이블 별 데이터 처리
                foreach (DataRow waferRow in waferDt.Rows)
                {
                    // 구조 복제
                    if (allWaferDt == null)
                        allWaferDt = waferDt.Clone();

                    // 새로운 WAFER_SEQ, LOT_SEQ 입력
                    waferRow["PROGRAM"] = program;
                    waferRow["WAFER_SEQ"] = m.NewWaferSeq();
                    waferRow["LOT_SEQ"] = lotRow["LOT_SEQ"];

                    allWaferDt.Rows.Add(waferRow.ItemArray);
                }
            }

            // TQP_WAFER 데이터 추가
            allWaferDt.TableName = "TQP_WAFER";
            m.InsertBulk(allWaferDt);

            // TQP_LOT 데이터 추가(Summary때문에 Row 단위로 insert)
            lotDt.TableName = "TQP_LOT";
            m.InsertBulk(lotDt);

            foreach (DataRow lotRow in lotDt.Rows)
            {
                // WAFER PROGRAM_REV 업데이트(TQP_PARASPEC의 PPD_SEQ로 부터 PROGRAM_REV 가져옴)
                m.UpdateWaferProgramRev((decimal)lotRow["OLD_LOT_SEQ"]);
            }

            MessageBox.Show(factory + " 완료");
        }

        private decimal[] ToDecimal(DataTable dt)
        {
            if (dt == null || dt.Rows.Count == 0)
                return null;

            decimal[] arr = new decimal[dt.Rows.Count];

            for (int i = 0; i < dt.Rows.Count; i++)
                arr[i] = (decimal)dt.Rows[i][0];

            return arr;
        }

        private void button7_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("run?", "run", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
                return;

            string factory = GetSelectItem();

            MiracomTPS m = new MiracomTPS(factory);
            TestData t = new TestData();

            // LOT 리스트 가져오기
            DataTable lotDt = t.GetLot(factory, dtStart.Value, dtEnd.Value);

            int cn = 0;
            label1.Text = String.Format("{0:N0}", lotDt.Rows.Count);

            foreach (DataRow lotRow in lotDt.Rows)
            {
                string lot = lotRow["LOT_ID"].ToString();
                string program = lotRow["PROGRAM"].ToString();
                decimal oldLotSeq = Decimal.Parse(lotRow["OLD_LOT_SEQ"].ToString());

                cn++;
                label2.Text = String.Format("{0:N0}", cn);
                listBox1.Items.Add(lot);
                listBox1.SelectedIndex = listBox1.Items.Count - 1;
                Application.DoEvents();

                // 새로운 LOT_SEQ 입력
                lotRow["LOT_SEQ"] = m.NewLotSeq();

                // CASE WHEN LENGTH(DEVICE) < 8 THEN SUBSTR(DEVICE,1,4) ELSE SUBSTR(DEVICE,5,4) END
                string deviceAlias = (string)lotRow["DEVICE"];
                deviceAlias = deviceAlias.Length >= 8 ? deviceAlias.Substring(4, 4) : deviceAlias.Substring(0, Math.Min(deviceAlias.Length, 4));
                lotRow["DEVICE_ALIAS"] = deviceAlias;

                DataTable programDt = m.GetProgramList(factory, program);
                DataTable waferDt = t.GetWafer(lot, oldLotSeq);

                int allCnt = 0, allXmin = 0, allXmax = 0, allYmin = 0, allYmax = 0;

                // WAFER_SEQ 별 T테이블 별 데이터 처리
                foreach (DataRow waferRow in waferDt.Rows)
                {
                    decimal newWaferSeq = m.NewWaferSeq();

                    // 새로운 WAFER_SEQ, LOT_SEQ 입력
                    waferRow["PROGRAM"] = program;
                    waferRow["WAFER_SEQ"] = newWaferSeq;
                    waferRow["LOT_SEQ"] = lotRow["LOT_SEQ"];

                    decimal oldWaferSeq = (decimal)waferRow["OLD_WAFER_SEQ"];

                    foreach (DataRow programRow in programDt.Rows)
                    {
                        string tableName = programRow["TABLE_NAME"].ToString();
                        string oldTableName = programRow["OLD_TABLE_NAME"].ToString();

                        DataTable rawDt = null;// t.GetTTableData(oldTableName, oldWaferSeq);

                        // XY 데이터가 있는 경우, X,Y 로 분리
                        SplitXY(rawDt);
                        ChangeWaferSeq(rawDt, newWaferSeq);
                        rawDt.TableName = tableName;

                        // TD_테이블에 데이터 추가
                        m.InsertBulk(rawDt);

                        int cnt = 0, xmin = 0, xmax = 0, ymin = 0, ymax = 0;
                        GetDieInfo(rawDt, out cnt, out xmin, out xmax, out ymin, out ymax);

                        // die count 가 많은것을 기준으로
                        if (allCnt < cnt)
                        {
                            allCnt = cnt;
                            allXmin = xmin;
                            allXmax = xmax;
                            allYmin = ymin;
                            allYmax = ymax;
                        }
                    }
                }

                // insert 용 Lot 데이터
                DataTable lotRowDt = lotDt.Clone();
                lotRowDt.Rows.Add(lotRow.ItemArray);

                // TQP_LOT 데이터 추가(Summary때문에 Row 단위로 insert)
                lotRowDt.TableName = "TQP_LOT";
                m.InsertBulk(lotRowDt);

                // TQP_WAFER 데이터 추가
                waferDt.TableName = "TQP_WAFER";
                m.InsertBulk(waferDt);

                // WAFER PROGRAM_REV 업데이트(TQP_PARASPEC의 PPD_SEQ로 부터 PROGRAM_REV 가져옴)
                m.UpdateWaferProgramRev((decimal)lotRow["OLD_LOT_SEQ"]);


                // TQP_PRODUCT 데이터
                //m.CheckProduct(factory, deviceAlias);

                //TQP_MAPDEF 데이터
                if (!m.ContainsMAPDEF(deviceAlias) && allCnt > 0)
                    m.SetTQP_MAPDEF(deviceAlias, 0, allXmax, allYmax, allXmin, allYmin, allCnt);

                //// SUMMARY 데이터 추가
                //DataTable sumDt = GetEmptySumTable();

                //foreach (DataRow waferRow in waferDt.Rows)
                //{
                //    sumDt.Rows.Add(
                //        (string)lotDt.Rows[0]["TEST_AREA"],
                //        (string)lotDt.Rows[0]["DEVICE"],
                //        (string)lotDt.Rows[0]["PROGRAM"],
                //        (decimal)waferRow["WAFER_SEQ"],
                //        null
                //        );
                //}

                //m.ExecuteProcedure(sumDt);

                MessageBox.Show(factory + " 완료");
            }
        }

        private void GetDieInfo(DataTable dt, out int count, out int xmin, out int xmax, out int ymin, out int ymax)
        {
            count = xmin = xmax = ymin = ymax = 0;

            if (dt.Columns.Contains("X") && dt.Columns.Contains("Y"))
            {
                xmin = Convert.ToInt32(dt.Compute("MIN(X)", ""));
                xmax = Convert.ToInt32(dt.Compute("MAX(X)", ""));
                ymin = Convert.ToInt32(dt.Compute("MIN(Y)", ""));
                ymax = Convert.ToInt32(dt.Compute("MAX(Y)", ""));
                count = dt.Rows.Count;
            }
        }

        private void dtStart_ValueChanged(object sender, EventArgs e)
        {
            dtEnd.Value = dtStart.Value.AddDays(15);
        }

        private void SplitXY(DataTable dt)
        {
            if (!dt.Columns.Contains("XY"))
                return;

            dt.Columns.Add("X", typeof(decimal));
            dt.Columns.Add("Y", typeof(decimal));

            foreach (DataRow row in dt.Rows)
            {
                decimal xy = (decimal)row["XY"];

                row["X"] = (int)Math.Round(xy/65536, 0);
                row["Y"] = xy % 65536;
            }

            dt.Columns.Remove("XY");
        }

        private void ChangeWaferSeq(DataTable dt, decimal waferSeq)
        {
            foreach (DataRow row in dt.Rows)
            {
                row["WAFER_SEQ"] = waferSeq;
            }
        }

        private DataTable GetEmptySumTable()
        {
            /* PROC_CREATE_TQP_WAFER_SUM
               a_testarea    IN   VARCHAR2,
               a_product     IN   VARCHAR2,
               a_program     IN   VARCHAR2,
               a_wafer_seq   IN   NUMBER,
               a_gec         IN   VARCHAR2 */
            DataTable dt = new DataTable("PROC_CREATE_TQP_WAFER_SUM");
            dt.Columns.Add("A_TESTAREA", typeof(string));
            dt.Columns.Add("A_PRODUCT", typeof(string));
            dt.Columns.Add("A_PROGRAM", typeof(string));
            dt.Columns.Add("A_WAFER_SEQ", typeof(string));
            dt.Columns.Add("A_GEC", typeof(string));
            return dt;
        }

