        private void button7_Click_1(object sender, EventArgs e)
        {
            if (listBox2.SelectedIndices == null || listBox2.SelectedIndices.Count == 0)
                return;

            int[] arr = new int[listBox2.SelectedIndices.Count];
            listBox2.SelectedIndices.CopyTo(arr, 0);

            for (int i = arr.Length - 1; i >= 0; i--)
            {
                string item = listBox2.Items[arr[i]].ToString();

                listBox3.Items.Add(item);
                listBox2.Items.RemoveAt(arr[i]);
                
                Thread.Sleep(100);
                ThreadPool.QueueUserWorkItem(new WaitCallback(RunAsync), item);
            }

            listBox2.SelectedIndex = 0;
        }

        private void RunAsync(object state)
        {
            smp.WaitOne();

            try
            {
                Thread.Sleep(100);
                string newTableName = state as string;
                InsertStatus(newTableName);

                TestData t = new TestData();
                MiracomTPS m = new MiracomTPS(GetSelectItem());

                //if (m.ExistsData(newTableName))
                //{
                //    InsertStatus(newTableName + " data exists!!!");
                //    RemoveItem(newTableName);
                //    return;
                //}

                m.TruncateTTable(newTableName);
                DataTable wafDt = m.GetWaferSeq(newTableName);

                // KEY: old wafer seq, VALUE: new wafer seq
                Dictionary<decimal, decimal> dic = new Dictionary<decimal, decimal>();

                for (int i = 0; i < wafDt.Rows.Count; i++)
                    dic.Add(decimal.Parse(wafDt.Rows[i]["OLD_WAFER_SEQ"].ToString()), decimal.Parse(wafDt.Rows[i]["WAFER_SEQ"].ToString()));

                decimal[] waferSeqArr = dic.Keys.ToArray();
                int size = 1;

                for (int i = 0; i < waferSeqArr.Length; i += size)
                {
                    InsertStatus(String.Format("{0} ({1:N0}/{2:N0})", newTableName, i, waferSeqArr.Length));

                    decimal[] arr = new decimal[Math.Min(size, waferSeqArr.Length - i)];
                    Array.Copy(waferSeqArr, i, arr, 0, arr.Length);

                    string oldTableName = "T" + newTableName.Substring(3);
                    DataTable rawDt = t.GetTTableData(oldTableName, arr);

                    for (int j = 0; j < rawDt.Rows.Count; j++)
                        rawDt.Rows[j]["WAFER_SEQ"] = dic[decimal.Parse(rawDt.Rows[j]["WAFER_SEQ"].ToString())];

                    SplitXY(rawDt);

                    rawDt.TableName = newTableName;
                    m.InsertBulk(rawDt);
                    rawDt.Dispose();

                    Thread.Sleep(100);
                }

                InsertStatus(String.Format("{0} END !!!", newTableName));
                RemoveItem(newTableName);
            }
            catch (Exception ex)
            {
                ShowException(ex, state as string);
            }
            finally
            {
                if (smp != null)
                    smp.Release();
            }
        }

        private void ShowException(Exception ex, string item)
        {
            if (InvokeRequired)
                BeginInvoke(new Action<Exception, string>(ShowException), ex, item);
            else
            {
                textBox1.Text += item + Environment.NewLine;

                if (listBox3.Items.Contains(item))
                    listBox3.Items.Remove(item);

                MessageBox.Show(item + Environment.NewLine + Environment.NewLine + ex.Message + ex.StackTrace);
            }
        }

        private void InsertStatus(string message)
        {
            if (InvokeRequired)
                BeginInvoke(new Action<string>(InsertStatus), message);
            else
            {
                listBox1.Items.Add(message);
                listBox1.SelectedIndex = listBox1.Items.Count - 1;
                Application.DoEvents();
            }
        }

        private void RemoveItem(string item)
        {
            if (InvokeRequired)
                BeginInvoke(new Action<string>(RemoveItem), item);
            else
            {
                if (listBox3.Items.Contains(item))
                    listBox3.Items.Remove(item);
            }
        }

        private void button10_Click(object sender, EventArgs e)
        {
            string[] arr = textBox1.Lines;
            textBox1.Clear();
            foreach (string item in arr)
            {
                if (!String.IsNullOrEmpty(item))
                {
                    if (!listBox3.Items.Contains(item))
                        listBox3.Items.Add(item);

                    Thread.Sleep(10);
                    //RunAsync(item);
                    ThreadPool.QueueUserWorkItem(new WaitCallback(RunAsync), item);
                }
            }
        }

#endregion

        /// <summary>
        /// MAP, PRODUCT
        /// </summary>
        private void button8_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("run?", "run", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
                return;

            string factory = GetSelectItem();
            MiracomTPS m = new MiracomTPS(factory);
            DataTable deviceDt = m.GetDeviceAliasList();

            DataTable prodcutDt = EmptyProductTable();
            DataTable mapdefDt = EmptyMapdefTable();

            deviceDt.Rows.Clear();
            deviceDt.Rows.Add("ABCD");

            foreach (DataRow deviceRow in deviceDt.Rows)
            {
                string deviceAlias = (string)deviceRow["DEVICE_ALIAS"];
                InsertStatus(deviceAlias);

                DataTable tableDt = m.GetTableName(deviceAlias);

                if (tableDt == null || tableDt.Rows.Count == 0)
                    continue;

                DataRow tableRow = tableDt.Rows[0];

                string tableName = (string)tableRow["TABLE_NAME"];
                DataTable dieDt = m.GetDieInfo(tableName, deviceAlias);

                if (dieDt == null || dieDt.Rows.Count == 0)
                    continue;

                AddProductData(prodcutDt, factory, deviceAlias, deviceAlias);
                m.DeleteMapdef(deviceAlias);
                AddMapdefData(mapdefDt, deviceAlias,
                    (decimal)dieDt.Rows[0]["CNT"],
                    (decimal)dieDt.Rows[0]["MINX"],
                    (decimal)dieDt.Rows[0]["MINY"],
                    (decimal)dieDt.Rows[0]["MAXX"],
                    (decimal)dieDt.Rows[0]["MAXY"]);
            }

            //m.InsertBulk(prodcutDt);
            m.InsertBulk(mapdefDt);
        }

        private DataTable EmptyProductTable()
        {
            DataTable dt = new DataTable("TQP_PRODUCT");
            dt.Columns.Add("FACTORY", typeof(string));
            dt.Columns.Add("PRODUCT", typeof(string));
            dt.Columns.Add("MAPID", typeof(string));
            return dt;
        }

