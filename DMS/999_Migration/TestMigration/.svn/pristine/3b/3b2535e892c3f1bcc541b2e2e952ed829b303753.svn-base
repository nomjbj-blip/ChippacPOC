        private string GetSelectItem()
        {
            foreach (RadioButton rb in new RadioButton[] { radioButton1, radioButton2, radioButton3 })
            {
                if (rb.Checked)
                    return rb.Text;
            }

            return null;
        }

        private void button1_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("run?", "run", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != System.Windows.Forms.DialogResult.Yes)
                return;

            if (!(radioButton1.Checked || radioButton2.Checked || radioButton3.Checked))
            {
                MessageBox.Show("select");
                return;
            }

            listBox1.Items.Clear();

            string selFac = GetSelectItem();

            MiracomTPS m = new MiracomTPS(selFac);
            TestData t = new TestData();

            // 프로그램 목록 가져오기
            DataTable programDt = t.GetProgramList();

            label3.Text = String.Format("{0:N0}", programDt.Rows.Count);
            int cnt = 0;
            int i = 0;

            if (!String.IsNullOrEmpty(txtStart.Text))
            {
                for (int j = 0; j < programDt.Rows.Count; j++)
                {
                    if ((string)programDt.Rows[j]["PROGRAM"] == txtStart.Text)
                    {
                        i = j;
                        break;
                    }
                }
            }

            // program 별 처리
            for ( ; i < programDt.Rows.Count; i++)
            {
                DataRow programRow = programDt.Rows[i];

                string factory = programRow["FACTORY"].ToString();
                string program = programRow["PROGRAM"].ToString();

                if (factory != selFac)
                    continue;

                cnt++;
                label2.Text = String.Format("{0:N0}", cnt);
                listBox1.Items.Add(program);
                listBox1.SelectedIndex = listBox1.Items.Count - 1;
                Application.DoEvents();

                
                // 프로그램 파라미터 가져오기
                DataTable paraDt = t.GetProgramParameter(factory, program);

                if (paraDt == null || paraDt.Rows.Count == 0)
                {
                    MessageBox.Show(String.Format("파라미터가 없습니다. {0}/{1}", factory, program));
                    continue;
                }

                // XY 필드 없애고 X,Y필드로 분리
                AppendXAndYRow(paraDt);

                if (!m.ContainsPara(factory, program))
                {
                    // 프로그램 별 파라미터 처리하기
                    paraDt.TableName = "TQP_PARASPEC";
                    m.InsertBulk(paraDt);
                }

                // 프로그램 별 테이블 가져오기
                DataTable tableDt = t.GetProgramTable(program);

                for (int j = 0; j < tableDt.Rows.Count; j++)
                {
                    DataRow tableRow = tableDt.Rows[j];

                    string ttableName = tableRow["TABLE_NAME"].ToString();

                    listBox1.Items.Add(ttableName);
                    listBox1.SelectedIndex = listBox1.Items.Count - 1;

                    // 테이블 컬럼 가져오기
                    List<string> columnList = ToList(t.GetParameterFromTable(ttableName));

                    if (columnList.Contains("XY"))
                    {
                        columnList.Remove("XY");
                        columnList.Insert(0, "X");
                        columnList.Insert(1, "Y");
                    }

                    // 프로그램 별 테이블 생성
                    m.CreateTableAndView(ttableName.Substring(1) , columnList);
                }
            }
        }

        // parameter에 xy 데이터 삭제 및 x, y 데이터 추가하기
        private void AppendXAndYRow(DataTable dt)
        {
            DataRow[] drParams = dt.Select("[PARAM_NAME] = 'XY'");
            foreach (DataRow row in drParams)
            {
                DataRow inRow = dt.NewRow();
                inRow["FACTORY"] = row["FACTORY"];
                inRow["PROGRAM"] = row["PROGRAM"];
                inRow["PPD_SEQ"] = row["PPD_SEQ"]; // WAFER 데이터 MAPPING을 위해 필요
                inRow["PROGRAM_REV"] = row["PROGRAM_REV"];
                inRow["PARAM_INDEX"] = -1;
                inRow["PARAM_NAME"] = "X";
                inRow["PARAM_TYPE"] = row["PARAM_TYPE"];
                inRow["PARAM_DESC"] = row["PARAM_DESC"];
                inRow["CREATE_TIME"] = row["CREATE_TIME"];
                inRow["CREATE_USER"] = row["CREATE_USER"];
                inRow["UPDATE_TIME"] = row["UPDATE_TIME"];
                inRow["UPDATE_USER"] = row["UPDATE_USER"];
                inRow["TABLE_NAME"] = row["TABLE_NAME"];
                inRow["DECIMAL_PLACES"] = row["DECIMAL_PLACES"];
                inRow["RUNTIME_DEFINED"] = row["RUNTIME_DEFINED"];
                inRow["UOM"] = row["UOM"];
                inRow["LSL"] = row["LSL"];
                inRow["TARGET"] = row["TARGET"];
                inRow["USL"] = row["USL"];
                inRow["LCL"] = row["LCL"];
                inRow["UCL"] = row["UCL"];
                inRow["TEST_LOW"] = row["TEST_LOW"];
                inRow["TEST_HIGH"] = row["TEST_HIGH"];
                dt.Rows.Add(inRow);

                inRow = dt.NewRow();
                inRow["FACTORY"] = row["FACTORY"];
                inRow["PROGRAM"] = row["PROGRAM"];
                inRow["PPD_SEQ"] = row["PPD_SEQ"]; // WAFER 데이터 MAPPING을 위해 필요
                inRow["PROGRAM_REV"] = row["PROGRAM_REV"];
                inRow["PARAM_INDEX"] = 0;
                inRow["PARAM_NAME"] = "Y";
                inRow["PARAM_TYPE"] = row["PARAM_TYPE"];
                inRow["PARAM_DESC"] = row["PARAM_DESC"];
                inRow["CREATE_TIME"] = row["CREATE_TIME"];
                inRow["CREATE_USER"] = row["CREATE_USER"];
                inRow["UPDATE_TIME"] = row["UPDATE_TIME"];
                inRow["UPDATE_USER"] = row["UPDATE_USER"];
                inRow["TABLE_NAME"] = row["TABLE_NAME"];
                inRow["DECIMAL_PLACES"] = row["DECIMAL_PLACES"];
                inRow["RUNTIME_DEFINED"] = row["RUNTIME_DEFINED"];
                inRow["UOM"] = row["UOM"];
                inRow["LSL"] = row["LSL"];
                inRow["TARGET"] = row["TARGET"];
                inRow["USL"] = row["USL"];
                inRow["LCL"] = row["LCL"];
                inRow["UCL"] = row["UCL"];
                inRow["TEST_LOW"] = row["TEST_LOW"];
                inRow["TEST_HIGH"] = row["TEST_HIGH"];
                dt.Rows.Add(inRow);

                dt.Rows.Remove(row);
            }
        }

        private List<string> ToList(DataTable dt)
        {
            List<string> arr = new List<string>();

            for (int i = 0; i < dt.Rows.Count; i++)
            {
                arr.Add((string)dt.Rows[i][0]);
            }

            return arr;
        }

