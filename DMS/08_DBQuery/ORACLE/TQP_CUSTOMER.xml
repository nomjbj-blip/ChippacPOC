<?xml version="1.0" encoding="utf-8"?>
<queryxml conid="BUMPFA" logging="TRUE" xmlns="http://www.miracom.co.kr/XMLSchema">
    <query statement="Insert" queryid="CREATE_CUSTOMER" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_CUSTOMER
VALUES( :customer_id
,:customer_name
,:customer_desc
,:data_service
,:user_count
,TO_DATE(:expire_date,'YYYY-MM-DD')
,:ftpsite
,:ftpuser
,:ftppassword
,:ftppath
,:sendtime
,:aviformat
,:edsformat
,:inklessformat
,:rawdata
,:cust_code
,:spr_name
,:map_rcvdir
,:backup_dir
,:error_dir
,:log_dir
)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="25">:customer_id</param>
            <param direction="Input" dbtype="VarChar" size="25">:customer_name</param>
            <param direction="Input" dbtype="VarChar" size="100">:customer_desc</param>
            <param direction="Input" dbtype="Number" size="1">:data_service</param>
            <param direction="Input" dbtype="Number" size="2">:user_count</param>
