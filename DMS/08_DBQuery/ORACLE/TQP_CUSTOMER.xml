            <param direction="Input" dbtype="VarChar" size="256">:error_dir</param>
            <param direction="Input" dbtype="VarChar" size="256">:log_dir</param>
        </parameters>
    </query>
    <query statement="Delete" queryid="DELETE_CUSTOMER" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[DELETE FROM TQP_CUSTOMER WHERE CUSTOMER_ID = :customer_id]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="25">:customer_id</param>
        </parameters>
    </query>
    <query statement="Update" queryid="UPDATE_CUSTOMER" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[UPDATE TQP_CUSTOMER SET  
CUSTOMER_NAME = :customer_name
,CUSTOMER_DESC = :customer_desc
,DATA_SERVICE = :data_service
,USER_COUNT = :user_count
,EXPIRE_DATE = TO_DATE(:expire_date,'YYYY-MM-DD')
,FTPSITE = :ftpsite
, FTPUSER = :ftpuser
, FTPPASSWORD = :ftppassword
, FTPPATH = :ftppath
, SENDTIME = :sendtime
, AVIFORMAT = :aviformat
, EDSFORMAT = :edsformat
, INKLESSFORMAT = :inklessformat
, RAWDATA = :rawdata
, CUSTCODE = :cust_code
, SPR_NAME = :spr_name
, MAP_RCVDIR = :map_rcvdir
, BAKDIR = :backup_dir
, ERRDIR = :error_dir
, LOGDIR = :log_dir
WHERE CUSTOMER_ID = :customer_id]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="25">:customer_name</param>
            <param direction="Input" dbtype="VarChar" size="100">:customer_desc</param>
            <param direction="Input" dbtype="Number" size="1">:data_service</param>
            <param direction="Input" dbtype="Number" size="2">:user_count</param>
            <param direction="Input" dbtype="VarChar" size="10">:expire_date</param>
            <param direction="Input" dbtype="VarChar" size="30">:ftpsite</param>
            <param direction="Input" dbtype="VarChar" size="30">:ftpuser</param>
            <param direction="Input" dbtype="VarChar" size="30">:ftppassword</param>
            <param direction="Input" dbtype="VarChar" size="100">:ftppath</param>
            <param direction="Input" dbtype="VarChar" size="100">:sendtime</param>
            <param direction="Input" dbtype="VarChar" size="100">:aviformat</param>
            <param direction="Input" dbtype="VarChar" size="100">:edsformat</param>
            <param direction="Input" dbtype="VarChar" size="100">:inklessformat</param>
            <param direction="Input" dbtype="VarChar" size="100">:rawdata</param>
            <param direction="Input" dbtype="VarChar" size="40">:cust_code</param>
            <param direction="Input" dbtype="VarChar" size="40">:spr_name</param>
            <param direction="Input" dbtype="VarChar" size="256">:map_rcvdir</param>
            <param direction="Input" dbtype="VarChar" size="256">:backup_dir</param>
            <param direction="Input" dbtype="VarChar" size="256">:error_dir</param>
            <param direction="Input" dbtype="VarChar" size="256">:log_dir</param>
            <param direction="Input" dbtype="VarChar" size="40">:customer_id</param>
        </parameters>
    </query>
    <query statement="Select" queryid="GET_CUSTLIST" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT * FROM TQP_CUSTOMER 
ORDER BY CUSTOMER_ID]]></commandtext>
    </query>
    <query statement="Select" queryid="GET_CUSTLIST_BYMAPDIR" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2015-03-24 16:24:02
SELECT * FROM TQP_CUSTOMER
WHERE MAP_RCVDIR = :map_dir
