    <query statement="Update" queryid="UPDATE_EQUIP_01" commandtype="Text" description="Update All" commandtimeout="60">
        <commandtext><![CDATA[UPDATE TQD_UPDATESRV 
SET
EQUIP_TYPE    = :equip_type ,
FACILITY = :facility,  
EQUIP_MODEL   = :equip_model ,
EQUIP_DESC    = :equip_desc ,
EQUIP_IP      = :equip_ip ,
ACTIVE_FLAG   = :active_flag ,
SVC_FLAG      = :svc_flag ,
SVC_FLAG2     = :svc_flag2 ,
RESULT_PATH   = :result_path ,
SERVICE_PATH  = :service_path ,
SERVICE_PATH2 = :service_path2 ,
BACKUP_PATH   = :backup_path ,
EQUIP_PATH    = :equip_path ,
VIRTUAL_PATH  = :virtual_path ,
FTP_ID        = :ftp_id ,
FTP_PW        = :ftp_pw,
PORT_NO       = :port_no ,
PROTOCOL      = :protocol ,
