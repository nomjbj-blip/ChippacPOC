    <query statement="Select" queryid="SELECT_EQUIPINF" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT EQUIP_ID
,FACILITY
,EQUIP_TYPE
,EQUIP_DESC
,EQUIP_MODEL
,EQUIP_IP
,ACTIVE_FLAG
,SVC_FLAG
,SVC_FLAG2
,RESULT_PATH
,SERVICE_PATH
,SERVICE_PATH2
,BACKUP_PATH
,EQUIP_PATH
,VIRTUAL_PATH
,FTP_ID
,FTP_PW
