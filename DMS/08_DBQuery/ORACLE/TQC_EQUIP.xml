    <query statement="Select" queryid="SELECT_PCM_EQUIP_STATUS" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT
    A.EQUIP_ID "EQUIP ID",
    C.MASK_ID AS "DEVICE",
    A.EQUIP_STS_7 "PROGRAM",
    A.EQUIP_STS_3 "LOT ID",
    A.EQUIP_STS_4 "WAFER ID",
    A.EQUIP_STS_1 "STATUS",
    TO_CHAR(TO_DATE(A.EQUIP_STS_2, 'YYYY-MM-DD HH24:MI:SS'), 'MM-DD HH24:MI:SS') "STATUS TIME",
    A.EQUIP_STS_6 "OPER",
    A.EQUIP_STS_5 "P-CARD",
    (
        SELECT ROUND((SYSDATE - MIN(VAL1)) * 24) FROM (
            SELECT
                CASE WHEN PROBE_CARD = A.EQUIP_STS_5 THEN
                    LAST_VALUE(CASE WHEN PROBE_CARD = A.EQUIP_STS_5 THEN INPUT_TIME END) IGNORE NULLS OVER (ORDER BY INPUT_TIME DESC)
                END VAL1,
                CASE WHEN PROBE_CARD = A.EQUIP_STS_5 THEN
                    LAST_VALUE(CASE WHEN PROBE_CARD <> A.EQUIP_STS_5 THEN INPUT_TIME END) IGNORE NULLS OVER (ORDER BY INPUT_TIME DESC)
                END VAL2
            FROM TQP_PCM_INPUT_HIS
            WHERE EQUIP_ID = A.EQUIP_ID
        )
        WHERE VAL2 IS NULL AND VAL1 IS NOT NULL
    ) "CARD USAGE(H)",
    DECODE(B.PROGRAM, NULL, NULL, B.PROGRAM) AS "END PGM",
    DECODE(B.WAFER_ID, NULL, NULL, B.WAFER_ID) AS "END WAFER",
    TO_CHAR(TO_DATE(EQUIP_STS_9, 'YYYY-MM-DD HH24:MI:SS'), 'MM-DD HH24:MI:SS') "END TIME",
    DECODE(B.WAFER_ID, NULL, NULL, TO_CHAR(TRUNC(MOD((B.END_TIME - B.START_TIME),1)*24), 'FM09') || ':' || TO_CHAR(TRUNC(MOD((B.END_TIME - B.START_TIME)*24,1)*60), 'FM09') || ':' || TO_CHAR(TRUNC(ROUND(MOD((B.END_TIME - B.START_TIME)*24*60,1)*60)), 'FM09')) AS "TEST TIME", 
    CASE WHEN EQUIP_CMF_2 < ROUND((SYSDATE - TO_DATE(EQUIP_STS_2, 'yyyy-mm-dd hh24:mi:ss')) * (24*60*60)) THEN 'Y' ELSE 'N' END FLAG
FROM TQC_EQUIP A, (SELECT TO_CHAR(WAFER_SEQ) AS WAFER_SEQ, WAFER_ID, PROGRAM, START_TIME, END_TIME FROM TQP_WAFER_SUM WHERE 1=1 AND FACILITY = :FACTORY AND TESTAREA = 'PARAMETRIC') B, TQC_LOT_STS C
WHERE A.EQUIP_STS_8 = B.WAFER_SEQ(+)
AND A.EQUIP_STS_3 = C.LOT_NO(+)
AND A.FACTORY = :FACTORY
AND A.AREA = 'TEST'
AND A.OPER = 'PARAMETRIC'
AND A.EQUIP_ID NOT IN ('AMPTSVR', 'AMPTKVR')
ORDER BY A.EQUIP_ID]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="40" value="FAB2">:FACTORY</param>
        </parameters>
    </query>
