    <query statement="Select" queryid="SELECT_MERGE_RULE_WITHOUT_RULENAME" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT RULE_NAME, RULE_VALUE, RULE_ORDER, AREA_DESC
FROM T_TPS_MERGERULE A, T_TPS_TESTAREA B
WHERE A.CUSTOMER = :customer
AND A.PRODUCT = :product
AND A.ACT_TESTAREA = :act_testarea
AND TESTAREA (+)= RULE_VALUE
ORDER BY RULE_ORDER ]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:customer</param>
            <param direction="Input" dbtype="VarChar" size="40">:product</param>
            <param direction="Input" dbtype="VarChar" size="40">:act_testarea</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_MERGE_RULE_BY_RULE_NAME" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[WITH RT AS (
SELECT A.*,
       (DECODE(A.CUSTOMER, :customer, 100, 0)
       + DECODE(A.PRODUCT, :product, 1000, 0)
       + DECODE(A.RULE_NAME, :rule_name, 10000, 0)) AS NUM 
    FROM T_TPS_MERGERULE A
    WHERE 1=1
    AND A.CUSTOMER IN (' ', :customer)
    AND A.PRODUCT IN (' ',  :product)
    AND A.RULE_NAME IN (' ', :rule_name)
    )
SELECT * FROM RT A, T_TPS_TESTAREA B
WHERE 1=1
AND NUM = (SELECT MAX(NUM) FROM RT)
AND TESTAREA(+) = RULE_VALUE
ORDER BY RULE_ORDER]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:customer</param>
            <param direction="Input" dbtype="VarChar" size="2048">:product</param>
            <param direction="Input" dbtype="VarChar" size="40">:rule_name</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_DISTINCT" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT ??
FROM T_TPS_MERGERULE
WHERE 1=1
]]></commandtext>
    </query>
    <query statement="Select" queryid="SELECT_DISTINCT_BY_FILTER" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT ??
