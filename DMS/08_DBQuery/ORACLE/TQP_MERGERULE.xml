    <query statement="Select" queryid="SELECT_MERGE_LIST" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT RULE_NAME
FROM T_TPS_MERGERULE
WHERE CUSTOMER = :customer
ORDER BY RULE_NAME]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">customer</param>
        </parameters>
    </query>
