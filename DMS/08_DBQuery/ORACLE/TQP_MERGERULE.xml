    </query>
    <query statement="Select" queryid="SELECT_MERGE_RULE_LIST" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT CUSTOMER as "Customer", 
       PRODUCT as "Product", 
       RULE_NAME as "Rule Name",
       DOWNMAP_CREATE as "Download Map Create",
       OUTPUTMAP_CREATE as "Output Map Create",
       MAP_TYPE as "Map Type"
FROM T_TPS_MERGERULE
GROUP BY CUSTOMER,PRODUCT,RULE_NAME,MAP_TYPE,DOWNMAP_CREATE,OUTPUTMAP_CREATE
ORDER BY CUSTOMER DESC,PRODUCT DESC,RULE_NAME]]></commandtext>
    </query>
