    <query statement="Update" queryid="UPDATE_OPER_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2019-07-08 16:56:36
UPDATE TQC_OPER
   SET OPER_DESC = :ODESC,
       CMF_FIELD01 = :CMF_FIELD01,
       CMF_FIELD02 = :CMF_FIELD02,
       CMF_FIELD03 = :CMF_FIELD03,
       CMF_FIELD04 = :CMF_FIELD04,
       CMF_FIELD05 = :CMF_FIELD05,
       CMF_FIELD06 = :CMF_FIELD06,
       CMF_FIELD07 = :CMF_FIELD07,
       CMF_FIELD08 = :CMF_FIELD08,
       CMF_FIELD09 = :CMF_FIELD09,
       CMF_FIELD10 = :CMF_FIELD10,
       UPDATE_USER_ID = :USERID,
       UPDATE_TIME = SYSDATE
 WHERE 1=1
   AND FACTORY = :FACTORY
   AND AREA = :AREA
   AND OPER = :OPER]]></commandtext>
