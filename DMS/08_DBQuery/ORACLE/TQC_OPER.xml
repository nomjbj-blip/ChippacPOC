    <query statement="Select" queryid="SELECT_AREA_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT AREA FROM TQC_OPER
WHERE FACTORY = :FACTORY
ORDER BY CASE AREA WHEN 'DM' THEN 1 WHEN 'TEST' THEN 2 ELSE 99 END]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Varchar" size="40">:FACTORY</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_OPER_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT OPER FROM TQC_OPER
