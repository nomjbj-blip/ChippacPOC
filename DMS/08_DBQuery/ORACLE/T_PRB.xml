<?xml version="1.0" encoding="utf-8"?>
<queryxml conid="DMSMGR" logging="TRUE" xmlns="http://www.miracom.co.kr/XMLSchema">
    <query statement="Insert" queryid="INSERT_PRB" commandtype="Text" description="Tset Data를 추가 한다." commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO ?? VALUES( :wafer_seq, :dieid, :x, :y, :bin, :hbin, :charbin, :site, :visualinsp, :avi)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="8">:wafer_seq</param>
            <param direction="Input" dbtype="Int32" size="0">:dieid</param>
            <param direction="Input" dbtype="Int32" size="0">:x</param>
            <param direction="Input" dbtype="Int32" size="0">:y</param>
            <param direction="Input" dbtype="Int32" size="0">:bin</param>
            <param direction="Input" dbtype="Int32" size="0">:hbin</param>
            <param direction="Input" dbtype="VarChar" size="4">:charbin</param>
            <param direction="Input" dbtype="Int32" size="0">:site</param>
            <param direction="Input" dbtype="Int32" size="0">:visualinsp</param>
            <param direction="Input" dbtype="Int32" size="0">:avi</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_BINDATA" commandtype="Text" description="Bin정보를 가져온다." commandtimeout="60">
        <commandtext><![CDATA[SELECT BIN, COUNT(*)  
FROM ?? 
WHERE WAFER_SEQ = :wafer_seq  
GROUP BY BIN
]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="8">:wafer_seq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_INFO" commandtype="Text" description="Bin Data를 가져온다." commandtimeout="60">
        <commandtext><![CDATA[SELECT * FROM ?? WHERE WAFER_SEQ = :wafer_seq  ORDER BY Y, X]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="8" value="14">:wafer_seq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_XY" commandtype="Text" description="X, Y 에 해당하는 Row가 있는가 " commandtimeout="60">
        <commandtext><![CDATA[SELECT COUNT(*) FROM ??
WHERE WAFER_SEQ = :wafer_seq
and X = :x
and Y = :y]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="8">:wafer_seq</param>
            <param direction="Input" dbtype="Int32" size="0">:x</param>
            <param direction="Input" dbtype="Int32" size="0">:y</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_TESTDIE" commandtype="Text" description="Test Die 수를 가져온다." commandtimeout="60">
        <commandtext><![CDATA[SELECT COUNT(*) TESTDIE FROM ??
WHERE WAFER_SEQ = :wafer_seq
AND BIN <> 88]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="8">:wafer_seq</param>
        </parameters>
    </query>
    <query statement="Insert" queryid="CREATE_TEMP_TABLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2013-08-26 18:39:44

CREATE TABLE ??
AS SELECT *
FROM ??
WHERE 1=0]]></commandtext>
    </query>
    <query statement="Insert" queryid="COPY_TEMP_TABLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2013-08-26 18:40:18

INSERT INTO ??(WAFER_SEQ,DIEID,X,Y,BIN,HBIN,CHARBIN,VISUALINSP,AVI)
SELECT WAFER_SEQ,DIEID,X,Y,BIN,HBIN,CHARBIN,VISUALINSP,AVI
FROM ??]]></commandtext>
    </query>
    <query statement="Delete" queryid="DROP_TEMP_TABLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2013-08-26 18:41:58

DROP TABLE ??]]></commandtext>
    </query>
    <query statement="Insert" queryid="COPY_TEMP_TABLE_TO_ITEM" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2013-08-26 19:21:03

INSERT INTO ??
SELECT *
FROM ??]]></commandtext>
    </query>
    <query statement="Select" queryid="DYNAMIC_QUERY" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[??]]></commandtext>
    </query>
    <query statement="Insert" queryid="COPY_ROW_DATA_FOR_AOI" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO ?? (WAFER_SEQ, DIEID, X, Y, BIN, CHARBIN)
SELECT :wafer_seq AS WAFER_SEQ, DIEID, X, Y, BIN, CHARBIN
FROM ??
WHERE WAFER_SEQ = :pwafer_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="20">:wafer_seq</param>
            <param direction="Input" dbtype="Number" size="20">:pwafer_seq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_MAX_WAFERSEQ" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2015-03-25 10:33:29
SELECT WAFER_SEQ.NEXTVAL FROM DUAL]]></commandtext>
    </query>
    <query statement="Insert" queryid="CALL_PROCEDURE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2015-03-25 15:47:02
CALL BUMPFA.proc_run_prb_summary(:testarea, :product, :program, :wafer_seq, :gec_bin)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:testarea</param>
            <param direction="Input" dbtype="VarChar" size="40">:product</param>
            <param direction="Input" dbtype="VarChar" size="40">:program</param>
            <param direction="Input" dbtype="VarChar" size="40">:wafer_seq</param>
            <param direction="Input" dbtype="VarChar" size="40">:gec_bin</param>
        </parameters>
    </query>
</queryxml>