    <query statement="Select" queryid="SELECT_INFO_AVI_MERGE_VI" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT
( B.X - C.MIN_X +1) X --X
, (C.MAX_Y - B.Y +1 ) Y  --Y
, CASE
        WHEN DECODE(A.BIN, null, 1, A.BIN) != 1 THEN A.BIN
        WHEN VISUALINSP != 0 THEN VISUALINSP
        ELSE 1 
  END BIN -- BIN
FROM 
(
    SELECT XINDEX AS X, YINDEX AS Y, MAX(CLASSNUMBER) AS BIN 
    FROM
    (
        SELECT STEP_SEQ, RANK() OVER (ORDER BY RESULTTIMESTAMP DESC) AS RANK 
        FROM T_DMS_LOT A, T_DMS_WAFER B, T_DMS_STEP C
        WHERE 1=1
        AND A.LOT_ID = :lot_id
        AND A.LOT_SEQ = B.LOT_SEQ
        AND B.WAFER_ID = :wafer_id
        AND B.WAFER_SEQ = C.WAFER_SEQ
        AND C.STEP_ID = :step_id
    ) A, T_DMS_DEFECT B
    WHERE A.RANK = 1
    AND A.STEP_SEQ = B.STEP_SEQ
    GROUP BY XINDEX, YINDEX
) A,
(
    SELECT INDEX_X AS X, INDEX_Y AS Y, VISUALINSP 
    FROM
    (
        SELECT STEP_SEQ, RANK() OVER (ORDER BY RESULTTIMESTAMP DESC) AS RANK
        FROM T_DMS_LOT A, T_DMS_WAFER B, T_DMS_STEP C
        WHERE 1=1
        AND A.LOT_ID = :lot_id
        AND A.LOT_SEQ = B.LOT_SEQ
        AND B.WAFER_ID = :wafer_id
        AND B.WAFER_SEQ = C.WAFER_SEQ
        AND C.STEP_ID = :step_id
    ) A, T_DMS_SCAN_SAMPLE B
    WHERE A.RANK = 1
    AND A.STEP_SEQ = B.STEP_SEQ
) B,
(
    --SELECT LOT_ID, WAFER_ID
    SELECT
    MAX(INDEX_X) MAX_X, MAX(INDEX_Y) MAX_Y
    , MIN(INDEX_X) MIN_X, MIN(INDEX_Y) MIN_Y
    FROM (
                SELECT LOT_ID, WAFER_ID, STEP_SEQ, RANK() OVER (ORDER BY RESULTTIMESTAMP DESC) AS RANK
                FROM T_DMS_LOT A, T_DMS_WAFER B, T_DMS_STEP C
                WHERE 1=1
                AND A.LOT_ID = :lot_id
                AND A.LOT_SEQ = B.LOT_SEQ
                AND B.WAFER_ID = :wafer_id
                AND B.WAFER_SEQ = C.WAFER_SEQ
                AND C.STEP_ID = :step_id
               ) A, T_DMS_SCAN_SAMPLE B
       WHERE A.RANK = 1
       AND A.STEP_SEQ = B.STEP_SEQ
       --GROUP BY LOT_ID, WAFER_ID
) C 
WHERE 1=1 
AND A.X (+)= B.X
AND A.Y (+)= B.Y
ORDER BY Y, X]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:lot_id</param>
            <param direction="Input" dbtype="VarChar" size="40">:wafer_id</param>
            <param direction="Input" dbtype="VarChar" size="40">:step_id</param>
        </parameters>
    </query>
