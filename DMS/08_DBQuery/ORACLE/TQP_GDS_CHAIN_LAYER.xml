<?xml version="1.0" encoding="utf-8"?>
<!--
  TQP_GDS_CHAIN_LAYER: Chain 후보 탐색에 사용한 Layer 목록. 2026-10-06 추가.
  LAYER_ID는 TQP_GDS_LAYER FK다. Map을 Layer 필터로 저장할 때 뺀 Layer는 저장할 수 없다(화면이 먼저 검사).
-->
<queryxml conid="DMSMGR" logging="TRUE" xmlns="http://www.miracom.co.kr/XMLSchema">
    <query statement="Insert" queryid="CREATE_CHAIN_LAYER" commandtype="Text" description="Chain 탐색 Layer 저장 (InsertExecuteMultiple)" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_GDS_CHAIN_LAYER
    (FACTORY,
    DEVICE_ID,
    CHAIN_SEQ,
    VERSION_NO,
    LAYER_ID)
VALUES
    (:factory,
    :device_id,
    :chain_seq,
    1,
    :layer_id)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
            <param direction="Input" dbtype="Number" size="0">:layer_id</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_CHAIN_LAYER" commandtype="Text" description="Chain 탐색 Layer 조회" commandtimeout="60">
        <commandtext><![CDATA[SELECT LAYER_ID
  FROM TQP_GDS_CHAIN_LAYER
 WHERE FACTORY = :factory
   AND DEVICE_ID = :device_id
   AND CHAIN_SEQ = :chain_seq
   AND VERSION_NO = 1
 ORDER BY LAYER_ID]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
        </parameters>
    </query>
    <!-- Map 복사(GdsMapImport.CopyMap, 2026-10-15): 원본 Device 의 행을 새 Device 이름으로 INSERT ... SELECT (Chain 1개씩) -->
    <query statement="Insert" queryid="COPY_CHAIN_LAYER" commandtype="Text" description="Map 복사: Chain 탐색 Layer" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_GDS_CHAIN_LAYER
    (FACTORY, DEVICE_ID, CHAIN_SEQ, VERSION_NO, LAYER_ID)
SELECT FACTORY, :target_device_id, :new_chain_seq, VERSION_NO, LAYER_ID
  FROM TQP_GDS_CHAIN_LAYER
 WHERE FACTORY = :factory
   AND DEVICE_ID = :source_device_id
   AND CHAIN_SEQ = :source_chain_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="50">:target_device_id</param>
            <param direction="Input" dbtype="Number" size="0">:new_chain_seq</param>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:source_device_id</param>
            <param direction="Input" dbtype="Number" size="0">:source_chain_seq</param>
        </parameters>
    </query>
    <!-- 탐색 Layer = Layer 번호 + DataType (2026-10-20). 위 쿼리는 이전 서버용. -->
    <query statement="Insert" queryid="CREATE_CHAIN_LAYER_DT" commandtype="Text" description="Chain 탐색 Layer(번호 + DataType) 저장 (InsertExecuteMultiple)" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_GDS_CHAIN_LAYER
    (FACTORY,
    DEVICE_ID,
    CHAIN_SEQ,
    VERSION_NO,
    LAYER_ID,
    DATA_TYPE)
VALUES
    (:factory,
    :device_id,
    :chain_seq,
    1,
    :layer_id,
    :data_type)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
            <param direction="Input" dbtype="Number" size="0">:layer_id</param>
            <param direction="Input" dbtype="Number" size="0">:data_type</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_CHAIN_LAYER_DT" commandtype="Text" description="Chain 탐색 Layer(번호 + DataType) 조회" commandtimeout="60">
        <commandtext><![CDATA[SELECT LAYER_ID, DATA_TYPE
  FROM TQP_GDS_CHAIN_LAYER
 WHERE FACTORY = :factory
   AND DEVICE_ID = :device_id
   AND CHAIN_SEQ = :chain_seq
   AND VERSION_NO = 1
 ORDER BY LAYER_ID, DATA_TYPE]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
        </parameters>
    </query>
    <query statement="Insert" queryid="COPY_CHAIN_LAYER_DT" commandtype="Text" description="Map 복사: Chain 탐색 Layer(번호 + DataType)" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_GDS_CHAIN_LAYER
    (FACTORY, DEVICE_ID, CHAIN_SEQ, VERSION_NO, LAYER_ID, DATA_TYPE)
SELECT FACTORY, :target_device_id, :new_chain_seq, VERSION_NO, LAYER_ID, DATA_TYPE
  FROM TQP_GDS_CHAIN_LAYER
 WHERE FACTORY = :factory
   AND DEVICE_ID = :source_device_id
   AND CHAIN_SEQ = :source_chain_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="50">:target_device_id</param>
            <param direction="Input" dbtype="Number" size="0">:new_chain_seq</param>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:source_device_id</param>
            <param direction="Input" dbtype="Number" size="0">:source_chain_seq</param>
        </parameters>
    </query>
</queryxml>
