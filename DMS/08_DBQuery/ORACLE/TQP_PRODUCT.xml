    <query statement="Select" queryid="SELECT_CUSTOMER_WITH_MAPDEF" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DECODE(B.CUSTOMER_ID, '',  ' ', B.CUSTOMER_ID) AS CUSTOMER,  A.*
FROM (
    SELECT *
    FROM TQP_MAPDEF
    WHERE MAPID = :map_id) A
    ,  TQP_PRODUCT B
WHERE B.PRODUCT (+)= A.MAPID]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:map_id</param>
        </parameters>
    </query>
