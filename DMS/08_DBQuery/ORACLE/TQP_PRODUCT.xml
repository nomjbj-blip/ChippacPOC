    <query statement="Insert" queryid="MERGE_DATA" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[MERGE INTO TQP_PRODUCT
USING DUAL 
ON ( FACTORY =:FACTORY 
    AND PRODUCT = :PRODUCT
)
WHEN NOT MATCHED THEN
INSERT  (FACTORY, PRODUCT, MAPID)
VALUES (:FACTORY,:PRODUCT,:MAPID)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40" value="FACTORY">:FACTORY</param>
            <param direction="Input" dbtype="VarChar" size="40" value="PRODUCT">:PRODUCT</param>
            <param direction="Input" dbtype="VarChar" size="40" value="MAPID">:MAPID</param>
        </parameters>
