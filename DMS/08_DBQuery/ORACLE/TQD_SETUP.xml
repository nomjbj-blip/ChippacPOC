            <param direction="Input" dbtype="VarChar" size="40">:notch_type</param>
            <param direction="Input" dbtype="VarChar" size="40">:die_pitch_x</param>
            <param direction="Input" dbtype="VarChar" size="40">:die_pitch_y</param>
            <param direction="Input" dbtype="VarChar" size="40">:die_origin_x</param>
            <param direction="Input" dbtype="VarChar" size="40">:die_origin_y</param>
