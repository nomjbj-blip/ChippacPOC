        <commandtext><![CDATA[INSERT INTO TQD_SETUP(SETUP_SEQ ,SETUP_ID,STEP_ID,SETUP_TIME,ANGLE,WAFER_SIZE,NOTCH_TYPE,DIE_PITCH_X,
DIE_PITCH_Y,DIE_ORIGIN_X,DIE_ORIGIN_Y,ORIGIN_X,ORIGIN_Y)
VALUES(
SETUP_SEQ.NEXTVAL
,:setup_id
,:step_id
,TO_TIMESTAMP(:setup_time,'YYYYMMDD HH24:MI:SS')
,:angle
,:wafer_size
,:notch_type
,:die_pitch_x
,:die_pitch_y
,:die_origin_x
,:die_origin_y
,:origin_x
,:origin_y)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:setup_id</param>
            <param direction="Input" dbtype="VarChar" size="40">:step_id</param>
            <param direction="Input" dbtype="VarChar" size="40">:setup_time</param>
