    <query statement="Select" queryid="SELECT_SETUP_DUPLE_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT 
 trunc(DIE_PITCH_X / 1000) AS DIE_PITCH_X
 ,trunc(DIE_PITCH_Y / 1000) AS DIE_PITCH_Y
FROM TQD_SETUP
WHERE SETUP_SEQ IN (
SELECT SETUP_SEQ FROM TQD_INSP_INFO A
         WHERE 1 = 1
          AND (STEP_SEQ, TEST) IN (??))
         GROUP BY trunc(DIE_PITCH_X / 1000), trunc(DIE_PITCH_Y / 1000)]]></commandtext>
    </query>
    <query statement="Update" queryid="UPDATE_SETUP_STREET" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[UPDATE TQD_SETUP SET STREET_X = :st_x, STREET_Y = :st_y
WHERE SETUP_SEQ = :setup_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="40" value="st_x">:st_x</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="st_y">:st_y</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="setup_seq">:setup_seq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="FAB1_SETUP_SUPLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT SETUP_SEQ FROM TQD_SETUP 
 WHERE 1 = 1 
  AND SETUP_ID = :setup_id
  AND DIE_ORIGIN_X = :orx
  AND DIE_ORIGIN_Y = :ory]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="40" value="setup_id">:setup_id</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="orx">:orx</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="ory">:ory</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_ORIGIN_INDEX" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DIE_ORIGIN_X, DIE_ORIGIN_Y
FROM TQD_SETUP
WHERE SETUP_ID = :SETUP_ID
AND STEP_ID = :STEP_ID
AND SETUP_TIME = TO_DATE(:SETUP_TIME,'YYYY-MM-DD HH24:MI:SS')]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="40" value="SETUP_ID">:SETUP_ID</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="STEP_ID">:STEP_ID</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="SETUP_TIME">:SETUP_TIME</param>
        </parameters>
    </query>
</queryxml>