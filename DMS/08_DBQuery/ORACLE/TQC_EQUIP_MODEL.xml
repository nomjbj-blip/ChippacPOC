    <query statement="Select" queryid="SELECT_EQUIP_MODEL_03" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2019-09-04 15:57:39
SELECT DISTINCT T1.EQUIP_MODEL
  FROM TQC_EQUIP_MODEL T1, TQC_EQUIP T2
 WHERE 1=1 AND T1.FACTORY = T2.FACTORY
  AND T1.EQUIP_MODEL = T2.EQUIP_MODEL
  AND T1.FACTORY = :factory
  AND T2.AREA IN (??)
  AND T2.OPER IN (??)
ORDER BY EQUIP_MODEL
]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="40" value="factory">:factory</param>
        </parameters>
