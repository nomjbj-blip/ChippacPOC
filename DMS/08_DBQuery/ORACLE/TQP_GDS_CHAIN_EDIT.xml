<?xml version="1.0" encoding="utf-8"?>
<!--
  TQP_GDS_CHAIN_EDIT: Chain 수동 편집 기록. 2026-10-06 추가.
  ADD = 수동 추가, EXCLUDE = 수동 제외(최종 MEMBER에는 없음). 다시 불러와 재탐색할 때 엔지니어 결정을 재적용하는 데 쓴다.
  메모리에 편집 순서가 없으므로 EDIT_SEQ는 ADD -> EXCLUDE 순서로 1부터 매긴다. BATCH_EDIT_SEQ는 1차에서 NULL.
-->
<queryxml conid="DMSMGR" logging="TRUE" xmlns="http://www.miracom.co.kr/XMLSchema">
    <query statement="Insert" queryid="CREATE_CHAIN_EDIT" commandtype="Text" description="Chain 수동 편집 기록 저장 (InsertExecuteMultiple)" commandtimeout="600">
        <commandtext><![CDATA[INSERT INTO TQP_GDS_CHAIN_EDIT
    (FACTORY,
    DEVICE_ID,
    CHAIN_SEQ,
    VERSION_NO,
    EDIT_SEQ,
    PLACED_ELEMENT_ID,
    ACTION_CODE,
    BATCH_EDIT_SEQ,
    CREATE_USER)
VALUES
    (:factory,
    :device_id,
    :chain_seq,
    1,
    :edit_seq,
    :placed_element_id,
    :action_code,
    TO_NUMBER(:batch_edit_seq),
    :create_user)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
            <param direction="Input" dbtype="Number" size="0">:edit_seq</param>
            <param direction="Input" dbtype="VarChar" size="1024">:placed_element_id</param>
            <param direction="Input" dbtype="VarChar" size="10">:action_code</param>
            <param direction="Input" dbtype="VarChar" size="20">:batch_edit_seq</param>
            <param direction="Input" dbtype="VarChar" size="30">:create_user</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_CHAIN_EDIT" commandtype="Text" description="Chain 수동 편집 기록 조회" commandtimeout="600">
        <commandtext><![CDATA[SELECT EDIT_SEQ, PLACED_ELEMENT_ID, ACTION_CODE, BATCH_EDIT_SEQ
  FROM TQP_GDS_CHAIN_EDIT
 WHERE FACTORY = :factory
   AND DEVICE_ID = :device_id
   AND CHAIN_SEQ = :chain_seq
   AND VERSION_NO = 1
 ORDER BY EDIT_SEQ]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_CHAIN_EDIT_COUNT" commandtype="Text" description="저장 확정 검사: 편집 기록 수" commandtimeout="60">
        <commandtext><![CDATA[SELECT COUNT(*) AS EDIT_COUNT
  FROM TQP_GDS_CHAIN_EDIT
 WHERE FACTORY = :factory
   AND DEVICE_ID = :device_id
   AND CHAIN_SEQ = :chain_seq
   AND VERSION_NO = 1]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:device_id</param>
            <param direction="Input" dbtype="Number" size="0">:chain_seq</param>
        </parameters>
    </query>
    <!-- Map 복사(GdsMapImport.CopyMap, 2026-10-15): 원본 Device 의 행을 새 Device 이름으로 INSERT ... SELECT (Chain 1개씩, 편집 기록은 원래 작성자 / 일시 그대로) -->
    <query statement="Insert" queryid="COPY_CHAIN_EDIT" commandtype="Text" description="Map 복사: Chain 수동 편집 기록" commandtimeout="600">
        <commandtext><![CDATA[INSERT INTO TQP_GDS_CHAIN_EDIT
    (FACTORY, DEVICE_ID, CHAIN_SEQ, VERSION_NO, EDIT_SEQ, PLACED_ELEMENT_ID, ACTION_CODE, BATCH_EDIT_SEQ, CREATE_USER, CREATE_TIME)
SELECT FACTORY, :target_device_id, :new_chain_seq, VERSION_NO, EDIT_SEQ, PLACED_ELEMENT_ID, ACTION_CODE, BATCH_EDIT_SEQ, CREATE_USER, CREATE_TIME
  FROM TQP_GDS_CHAIN_EDIT
 WHERE FACTORY = :factory
   AND DEVICE_ID = :source_device_id
   AND CHAIN_SEQ = :source_chain_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="50">:target_device_id</param>
            <param direction="Input" dbtype="Number" size="0">:new_chain_seq</param>
            <param direction="Input" dbtype="VarChar" size="30">:factory</param>
            <param direction="Input" dbtype="VarChar" size="50">:source_device_id</param>
            <param direction="Input" dbtype="Number" size="0">:source_chain_seq</param>
        </parameters>
    </query>
</queryxml>
