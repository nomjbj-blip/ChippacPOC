    <query statement="Select" queryid="SELECT_USER_LIST" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2014-01-24 09:04:07
SELECT A.USER_ID, A.USER_NAME, A.EMAIL_ID, B.SEC_GRP_ID, C.SEC_GRP_DESC
FROM TQC_USER A, TQC_GROUP_USER B, TQC_SECURITY_GROUP C
WHERE 1=1 
AND A.USER_ID  = B.USER_ID
AND B.SEC_GRP_ID = C.SEC_GRP_ID
AND C.SEC_GRP_DESC = DECODE(:grp_name, 'ALL', C.SEC_GRP_DESC, NULL, C.SEC_GRP_DESC, :grp_name)
AND A.EMAIL_ID is not null
ORDER BY A.USER_ID ASC]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:grp_name</param>
        </parameters>
    </query>
