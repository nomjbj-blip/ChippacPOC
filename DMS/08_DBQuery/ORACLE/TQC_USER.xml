    <query statement="Select" queryid="SELECT_USER_SEC_GROUP" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2014-01-22 19:05:49
SELECT B.SEC_GRP_ID, A.*
FROM TQC_USER A, TQC_GROUP_USER B
WHERE 1=1 
AND A.USER_ID = B.USER_ID
ORDER BY B.SEC_GRP_ID , A.USER_ID]]></commandtext>
    </query>
