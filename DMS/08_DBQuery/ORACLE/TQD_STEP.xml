            <param direction="Input" dbtype="VarChar2" size="40" value="waferseq">:waferseq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_MIGRATION_DATA" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT  STEP_SEQ
  FROM TQD_STEP
 WHERE     1 = 1
 AND "COMMENT" = 'Migration Data'
