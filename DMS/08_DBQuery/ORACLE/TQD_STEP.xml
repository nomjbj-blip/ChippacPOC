    <query statement="Select" queryid="SELECT_TST_BIN_INFO" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2019-12-18 11:08:54
SELECT DISTINCT T4.BIN
  FROM TQD_STEP T1, TQD_DEFECT_DIE T2, TQP_WAFER_SUM T3, TQP_BINDESC T4
 WHERE 1=1
   AND T1.STEP_SEQ = T2.DM_STEP_SEQ
   AND T2.TEST_WAFER_SEQ = T3.WAFER_SEQ
   AND T3.PROGRAM = T4.PROGRAM
   AND T4.HIGH_GEC = 'Y'
   AND T1.RESULT_ID IN (??)
   AND T1.WAFER_SEQ IN (??)
   AND T1.STEP_ID IN (??)]]></commandtext>
