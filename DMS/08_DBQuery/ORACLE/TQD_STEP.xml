    <query statement="Update" queryid="UPDATE_STEP[REVIEW_PARSER]" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2019-08-26 20:30:46
UPDATE TQD_STEP
   SET REVIEW_EQ = :revieweq
     , IMAGES = :images
     , REVIEW_FILENAME = :filename
     , REVIEW_FILEPATH = :filepath
 WHERE STEP_SEQ = :stepseq
   AND WAFER_SEQ = :waferseq]]></commandtext>
        <parameters>
