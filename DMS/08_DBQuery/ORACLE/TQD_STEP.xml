    <query statement="Select" queryid="CHECK_EXIST_SLOT" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT A.PRODUCT,B.LOT_ID,C.WAFER_ID,D.STEP_ID,D.RESULTTIMESTAMP,B.LOT_SEQ,C.WAFER_SEQ,D.STEP_SEQ,D.SETUP_SEQ
