    <query statement="Insert" queryid="CREATE_STEP" commandtype="Text" description="Step Insert" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQD_STEP (STEP_SEQ  ,
                        TEST    ,
                        WAFER_SEQ   ,
                        STEP_ID ,
                        SLOT_ID ,
                        RESULT_ID   ,
                        INSPECTION_EQ   ,
                        REVIEW_EQ   ,
                        SETUP_SEQ   ,
                        RESULTTIMESTAMP ,
                        FILETIMESTAMP   ,
                        MAIN_EQ ,
                        ROUTE   ,
                        OPER    ,
                        SCAN_AREA   ,
                        DEFECTIVE_DIE   ,
                        DEFECTS ,
                        IMAGES  ,
                        DEFECT_DD   ,
                        INSP_FILENAME   ,
                        INSP_FILEPATH   ,
                        "COMMENT" ,
                        TEST_ORDER)
        VALUES(
STEP_SEQ.NEXTVAL 
,:test
,:wafer_seq
,:step_id
,:slotid
,:resultid
,:inspection_eq
,:revieweq
,:setup_seq
,TO_TIMESTAMP(:resulttimestamp,'MM-DD-YY HH24:MI:SS')
,TO_TIMESTAMP(:filetimestamp,'MM-DD-YY HH24:MI:SS')
,NVL(:main_eq,'UNKNOWN')
,:route
,:oper
,:scanarea
,:defective_die
,:defects
,:images
,:defectdd
,:insp_filename
,NVL(:insp_filepath,'NOSERVICE')
,'Migration Data'
,0)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="0" description="testid">:test</param>
            <param direction="Input" dbtype="Number" size="0" description="inspection equip id">:wafer_seq</param>
            <param direction="Input" dbtype="VarChar" size="0" description="step id">:step_id</param>
            <param direction="Input" dbtype="Number" size="0" description="slotid">:slotid</param>
            <param direction="Input" dbtype="VarChar" size="0" description="resultid">:resultid</param>
            <param direction="Input" dbtype="VarChar" size="0" description="inspection equip id">:inspection_eq</param>
            <param direction="Input" dbtype="VarChar" size="0" description="revieweq">:revieweq</param>
            <param direction="Input" dbtype="Number" size="0" description="setup_seq">:setup_seq</param>
            <param direction="Input" dbtype="VarChar" size="0" description="resulttimestamp">:resulttimestamp</param>
            <param direction="Input" dbtype="VarChar" size="0" description="filetimestamp">:filetimestamp</param>
            <param direction="Input" dbtype="VarChar" size="0" description="main equip id">:main_eq</param>
            <param direction="Input" dbtype="VarChar" size="0" description="route">:route</param>
            <param direction="Input" dbtype="VarChar" size="0" description="oper">:oper</param>
            <param direction="Input" dbtype="Number" size="0" description="scanarea">:scanarea</param>
            <param direction="Input" dbtype="Number" size="0" description="defective_die">:defective_die</param>
            <param direction="Input" dbtype="Number" size="0" description="defects">:defects</param>
            <param direction="Input" dbtype="Number" size="0" description="images">:images</param>
            <param direction="Input" dbtype="Number" size="0" description="defectdd">:defectdd</param>
            <param direction="Input" dbtype="VarChar" size="0" description="insp_filename">:insp_filename</param>
            <param direction="Input" dbtype="VarChar" size="0" description="insp_filepath">:insp_filepath</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_STEP_SEQ" commandtype="Text" description="Step Seq 조회" commandtimeout="60">
        <commandtext><![CDATA[SELECT STEP_SEQ FROM TQD_STEP 
WHERE WAFER_SEQ = :wafer_seq
AND STEP_ID = :step_id
AND RESULTTIMESTAMP= TO_TIMESTAMP(:resulttimestamp,'MM-DD-YY HH24:MI:SS')
AND TEST = :test]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Number" size="0" description="wafer seq">:wafer_seq</param>
            <param direction="Input" dbtype="VarChar" size="0" description="step id">:step_id</param>
            <param direction="Input" dbtype="VarChar" size="0" description="inspection time">:resulttimestamp</param>
            <param direction="Input" dbtype="Number" size="0">:test</param>
        </parameters>
    </query>
    <query statement="Select" queryid="CHECK_EXIST_WAFERID" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT A.PRODUCT,B.LOT_ID,C.WAFER_ID,D.STEP_ID,D.RESULTTIMESTAMP,B.LOT_SEQ,C.WAFER_SEQ,D.STEP_SEQ,D.SETUP_SEQ
FROM TQD_PRODUCT A,TQD_LOT B,TQD_WAFER C,TQD_STEP D
WHERE A.PRODUCT = B.PRODUCT
AND B.LOT_SEQ = C.LOT_SEQ
AND C.WAFER_SEQ = D.WAFER_SEQ
AND B.LOT_ID = :lot_id
AND C.WAFER_ID =:wafer_id
AND D.STEP_ID = :step_id
AND D.RESULTTIMESTAMP = TO_TIMESTAMP(:resulttimestamp,'MM-DD-YY HH24:MI:SS')
AND D.TEST = :test]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="0">:lot_id</param>
            <param direction="Input" dbtype="VarChar" size="0">:wafer_id</param>
            <param direction="Input" dbtype="VarChar" size="0">:step_id</param>
            <param direction="Input" dbtype="VarChar" size="0">:resulttimestamp</param>
            <param direction="Input" dbtype="Number" size="0">:test</param>
        </parameters>
    </query>
