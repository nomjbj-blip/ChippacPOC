        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_BIN_EDITABLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[/*
SELECT TESTAREA AS "Test Area", BIN AS "Soft Bin", BIN_GROUP AS "Hard Bin", BIN_NAME AS "Bin Desc", CHAR_BIN AS "Map Symbol", 
DECODE(HIGH_GEC,'T','True','False') AS "Is Gec", DECODE(DISPLAY,'T','True','False') AS "Is Display",
UPPER_LIMIT_CNT AS "Upper Limit", LOWER_LIMIT_CNT AS "Lower Limit", COLOR AS "Color", DESCRIPTION AS "Description"
FROM TQP_BINDESC
WHERE PROGRAM = :program 
order by bin, testarea asc
*/

SELECT '' AS "EDITMODE", 
       T1.PROGRAM,
       T1.BIN,
       T1.BIN_NAME,
       T1.CHAR_BIN,
       DECODE(T1.HIGH_GEC, 'Y', 'True', 'False') AS "HIGH_GEC",
       DECODE(T1.DISPLAY, 'Y', 'True', 'False') AS "DISPLAY",
       T1.UPPER_LIMIT_CNT,
       T1.LOWER_LIMIT_CNT,
       T1.COLOR,
       T1.DESCRIPTION
  FROM TQP_BINDESC T1
 WHERE 1=1
   AND PROGRAM = :program
 ORDER BY PROGRAM, BIN]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="25" value="TESTPROG">:program</param>
        </parameters>
    </query>
