            <param direction="Input" dbtype="VarChar" size="0" value="high_gec">:high_gec</param>
            <param direction="Input" dbtype="VarChar" size="0" value="display">:display</param>
            <param direction="Input" dbtype="VarChar" size="0" value="upper_limit_cnt">:upper_limit_cnt</param>
            <param direction="Input" dbtype="VarChar" size="0" value="lower_limit_cnt">:lower_limit_cnt</param>
            <param direction="Input" dbtype="VarChar" size="0" value="color">:color</param>
