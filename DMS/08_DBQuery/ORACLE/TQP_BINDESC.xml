    <query statement="Select" queryid="SELECT_BININFO_BY_ALL_1" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[WITH RT AS (
SELECT A.*,
       (DECODE(A.PRODUCT, :product, 10, 0)
       + DECODE(A.TESTAREA, :testarea, 20, 0))
    FROM TQP_BINDESC A
    WHERE 1=1
    AND A.CUSTOMER IN (' ', :customer)
    AND A.PRODUCT IN (' ',  :product)
    AND A.TESTAREA IN (' ', :testarea)
    )
SELECT * FROM RT
ORDER BY BIN]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:customer</param>
            <param direction="Input" dbtype="VarChar" size="40">:product</param>
            <param direction="Input" dbtype="VarChar" size="40">:testarea</param>
        </parameters>
    </query>
