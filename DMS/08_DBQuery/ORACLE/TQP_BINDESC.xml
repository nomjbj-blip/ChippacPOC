    <query statement="Insert" queryid="MERGE_BIN" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2019-12-06 11:20:53
MERGE INTO tqp_bindesc t1
     USING DUAL
        ON (t1.program = :program AND t1.bin = :bin)
WHEN MATCHED
THEN
   UPDATE SET bin_name = :bname,
              char_bin = :cbin,
              high_gec = :hgec,
              display = :display,
              upper_limit_cnt = :upper_limit_cnt,
              lower_limit_cnt = :lower_limit_cnt,
              color = :color,
              description = :description
WHEN NOT MATCHED
THEN
   INSERT     (program,
               bin,
               bin_name,
               char_bin,
               high_gec,
               display,
               upper_limit_cnt,
               lower_limit_cnt,
               color,
               description)
       VALUES ( :program,
               :bin,
               :bname,
               :cbin,
               :hgec,
               :display,
               :upper_limit_cnt,
               :lower_limit_cnt,
               :color,
               :description)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="40" value="program">:program</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="bin">:bin</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="bname">:bname</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="cbin">:cbin</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="hgec">:hgec</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="display">:display</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="upper_limit_cnt">:upper_limit_cnt</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="lower_limit_cnt">:lower_limit_cnt</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="color">:color</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="description">:description</param>
        </parameters>
    </query>
