    <query statement="Insert" queryid="CREATE_BIN" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_BINDESC(PROGRAM, BIN, BIN_NAME, CHAR_BIN, HIGH_GEC, DISPLAY, UPPER_LIMIT_CNT, LOWER_LIMIT_CNT, COLOR, DESCRIPTION)
 VALUES (:program, :bin, :name, :charbin, :high_gec, :display, :upper_limit_cnt, :lower_limit_cnt, :color, :description)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="0" value="program">:program</param>
            <param direction="Input" dbtype="VarChar" size="0" value="bin">:bin</param>
            <param direction="Input" dbtype="VarChar" size="0" value="bin_desc">:name</param>
