    <query statement="Insert" queryid="MERGE_DATA" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[MERGE INTO TQP_LOT
USING DUAL
ON (
    FACTORY = :FACTORY
    AND LOT_SEQ = :LOT_SEQ
)
WHEN MATCHED THEN
UPDATE SET
    END_TIME = TO_DATE(:END_TIME,'YYYY-MM-DD HH24:MI:SS')
WHEN NOT MATCHED THEN
INSERT (
    FACTORY,
    LOT_SEQ,
    LOT_ID,
    TEST_AREA,
    PROGRAM,
    DEVICE,
    DEVICE_ALIAS,
    START_TIME,
    END_TIME,
    WAFER_DIAM
) VALUES (
    :FACTORY,
    :LOT_SEQ,
    :LOT_ID,
    :TEST_AREA,
    :PROGRAM,
    :DEVICE,
    :DEVICE_ALIAS,
    TO_DATE(:START_TIME,'YYYY-MM-DD HH24:MI:SS'),
    TO_DATE(:END_TIME,'YYYY-MM-DD HH24:MI:SS'),
    :WAFER_DIAM
)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="0" value="FACTORY">:FACTORY</param>
            <param direction="Input" dbtype="VarChar" size="0" value="LOT_SEQ">:LOT_SEQ</param>
            <param direction="Input" dbtype="VarChar" size="0" value="LOT_ID">:LOT_ID</param>
            <param direction="Input" dbtype="VarChar" size="0" value="TEST_AREA">:TEST_AREA</param>
            <param direction="Input" dbtype="VarChar" size="0" value="PROGRAM">:PROGRAM</param>
            <param direction="Input" dbtype="VarChar" size="0" value="DEVICE">:DEVICE</param>
            <param direction="Input" dbtype="VarChar" size="0" value="DEVICE_ALIAS">:DEVICE_ALIAS</param>
            <param direction="Input" dbtype="VarChar" size="0" value="START_TIME">:START_TIME</param>
            <param direction="Input" dbtype="VarChar" size="0" value="END_TIME">:END_TIME</param>
            <param direction="Input" dbtype="VarChar" size="0" value="WAFER_DIAM">:WAFER_DIAM</param>
        </parameters>
    </query>
