<?xml version="1.0" encoding="utf-8"?>
<queryxml conid="TPSMGR" logging="TRUE" xmlns="http://www.miracom.co.kr/XMLSchema">
    <query statement="Select" queryid="SELECT_TABLE_LIST" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT ROWNUM AS RN, TQP_DATA_TABLES.*
  FROM TQP_DATA_TABLES
  WHERE 1 = 1 AND PROGRAM = :pgm]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40">:pgm</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_TABLE_NAMES" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT TABLE_NAME
FROM TQP_DATA_TABLES
WHERE FACTORY = :FACTORY
AND PROGRAM = :PROGRAM
ORDER BY TABLE_NAME]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="Varchar" size="40" value="FACTORY">:FACTORY</param>
            <param direction="Input" dbtype="VarChar" size="40">:PROGRAM</param>
        </parameters>
    </query>
    <query statement="Insert" queryid="INSERT_DATA" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQP_DATA_TABLES (
    FACTORY, PROGRAM, TABLE_NAME
) VALUES (
    :FACTORY,:PROGRAM,:TABLE_NAME
)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="0">:FACTORY</param>
            <param direction="Input" dbtype="VarChar" size="0">:PROGRAM</param>
            <param direction="Input" dbtype="VarChar" size="0">:TABLE_NAME</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_TABLE_BY_WAFER" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- 2026-10-15: TD 테이블 이름은 Program 으로만 정해져 여러 Factory 행이 같은 테이블을 가리킬 수 있다.
--             이름이 두 번 나오면 첫 번째에서 빈 테이블을 DROP 한 뒤 두 번째 삭제가 ORA-00942 로 멈추므로 한 번만 돌려준다.
SELECT DISTINCT TABLE_NAME
FROM TQP_DATA_TABLES
WHERE PROGRAM IN (
    SELECT PROGRAM
    FROM TQP_WAFER
    WHERE WAFER_SEQ = :WAFER_SEQ
)
ORDER BY 1
]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="0">:WAFER_SEQ</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_TABLE_BY_LOT" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- 2026-10-15: SELECT_TABLE_BY_WAFER 와 같은 이유로 테이블 이름을 한 번만 돌려준다.
SELECT DISTINCT TABLE_NAME
FROM TQP_DATA_TABLES
WHERE PROGRAM IN (
    SELECT DISTINCT PROGRAM
    FROM TQP_WAFER
    WHERE LOT_SEQ = :LOT_SEQ
    AND PROGRAM = :PROGRAM
)
ORDER BY 1]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="0">:LOT_SEQ</param>
            <param direction="Input" dbtype="VarChar2" size="0">:PROGRAM</param>
        </parameters>
    </query>
    <query statement="Delete" queryid="DELETE_DATA_BY_TABLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[DELETE FROM
TQP_DATA_TABLES
WHERE TABLE_NAME = :TABLE_NAME]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar2" size="0">:TABLE_NAME</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_TABLE_NAMES_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT TABLE_NAME
FROM TQP_DATA_TABLES
WHERE PROGRAM = :PROGRAM
ORDER BY TABLE_NAME]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40" value="PROGRAM">:PROGRAM</param>
        </parameters>
    </query>
</queryxml>