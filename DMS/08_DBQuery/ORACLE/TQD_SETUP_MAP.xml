<?xml version="1.0" encoding="utf-8"?>
<queryxml conid="DMSMGR" logging="TRUE" xmlns="http://www.miracom.co.kr/XMLSchema">
    <query statement="Insert" queryid="CREATE_TQD_SETUP_MAP" commandtype="Text" description="Create new record into [TQD_SETUP_MAP]" commandtimeout="60">
        <commandtext><![CDATA[INSERT INTO TQD_SETUP_MAP(
        SETUP_SEQ
        , TEST
        , INDEX_X
        , INDEX_Y
) VALUES(
        :setup_seq
        , :test
        , :index_x
        , :index_y
)]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="NUMBER" size="22" description="SETUP_SEQ">:setup_seq</param>
            <param direction="Input" dbtype="NUMBER" size="22" description="TEST">:test</param>
            <param direction="Input" dbtype="NUMBER" size="22" description="INDEX_X">:index_x</param>
            <param direction="Input" dbtype="NUMBER" size="22" description="INDEX_Y">:index_y</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_MAP_COUNT" commandtype="Text" description="Read Table [TQD_SETUP_MAP]" commandtimeout="60">
        <commandtext><![CDATA[SELECT COUNT(*) CNT FROM TQD_SETUP_MAP WHERE SETUP_SEQ = :setup_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40" value="setup_seq">:setup_seq</param>
        </parameters>
    </query>
    <query statement="Update" queryid="UPDATE_TQD_SETUP_MAP_01" commandtype="Text" description="Update [TQD_SETUP_MAP]" commandtimeout="60">
        <commandtext><![CDATA[UPDATE TQD_SETUP_MAP 
SET SETUP_SEQ = :setup_seq
	, TEST = :test
	, INDEX_X = :index_x
	, INDEX_Y = :index_y /* WHERE condition */]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="NUMBER" size="22" description="SETUP_SEQ">:setup_seq</param>
            <param direction="Input" dbtype="NUMBER" size="22" description="TEST">:test</param>
            <param direction="Input" dbtype="NUMBER" size="22" description="INDEX_X">:index_x</param>
            <param direction="Input" dbtype="NUMBER" size="22" description="INDEX_Y">:index_y</param>
        </parameters>
    </query>
    <query statement="Delete" queryid="DELETE_TQD_SETUP_MAP_01" commandtype="Text" description="Delete [TQD_SETUP_MAP]" commandtimeout="60">
        <commandtext><![CDATA[DELETE FROM TQD_SETUP_MAP 
 /* WHERE condition */]]></commandtext>
    </query>
    <query statement="Select" queryid="SELECT_MAP_SAMPLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT SETUP_SEQ,INDEX_X,INDEX_Y,TEST FROM TQD_SETUP_MAP WHERE SETUP_SEQ = :setup_seq]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40" value="1">:setup_seq</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_MAP_DUPLE" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT CNT
  FROM (  SELECT INDEX_X, INDEX_Y, COUNT (*) AS CNT
            FROM TQD_SETUP_MAP
           WHERE     1 = 1
           AND SETUP_SEQ IN (??)
        GROUP BY INDEX_X, INDEX_Y)]]></commandtext>
    </query>
    <query statement="Select" queryid="SELECT_MAP_SAMPLE_MULTI" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[  SELECT INDEX_X, INDEX_Y, TEST
    FROM TQD_SETUP_MAP
    WHERE 1 = 1
    AND SETUP_SEQ IN (??)
    GROUP BY INDEX_X, INDEX_Y, TEST]]></commandtext>
    </query>
    <query statement="Select" queryid="SELECT_X_Y" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[-- Create Date : 2019-06-20 14:45:36
SELECT INDEX_X, INDEX_Y
FROM TQD_SETUP_MAP
WHERE SETUP_SEQ = :SETUP_SEQ
AND TEST = :TEST
ORDER BY INDEX_Y DESC, INDEX_X ASC]]></commandtext>
        <parameters>
            <param direction="Input" dbtype="VarChar" size="40" value="SETUP_SEQ">:SETUP_SEQ</param>
            <param direction="Input" dbtype="VarChar2" size="40" value="TEST">:TEST</param>
        </parameters>
    </query>
    <query statement="Select" queryid="SELECT_MAP_SAMPLE_MULTI_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[  SELECT INDEX_X, INDEX_Y, TEST
    FROM TQD_SETUP_MAP
    WHERE SETUP_SEQ IN (SELECT SETUP_SEQ FROM  TQD_INSP_INFO  WHERE (STEP_SEQ, TEST) IN (??))
    --GROUP BY INDEX_X, INDEX_Y]]></commandtext>
    </query>
    <query statement="Select" queryid="SELECT_MAP_DUPLE_01" commandtype="Text" commandtimeout="60">
        <commandtext><![CDATA[SELECT DISTINCT CNT
  FROM (  SELECT INDEX_X, INDEX_Y, COUNT (*) AS CNT
            FROM TQD_SETUP_MAP
           WHERE     1 = 1
           AND (SETUP_SEQ, TEST) IN (??)
        GROUP BY INDEX_X, INDEX_Y)]]></commandtext>
    </query>
    <query statement="Select" queryid="SELECT_MAP_TEST_DATA" commandtype="Text" commandtimeout="60">
